{
  "name": "scroll_by_delta",
  "description": "SCROLLING (by delta): 10x 50px rows (500px content) inside a 100px-tall overflow-y:scroll container. scroll_node_by delta_y=120 moves the offset to y=120 (within 0..400, no clamp). A second by-delta of 120 accumulates to 240. Exercises the register_scroll_nodes port + ScrollManager::scroll_to + get_current_offset (window.rs scroll paths).",
  "setup": {
    "window_width": 400,
    "window_height": 300,
    "dpi": 96
  },
  "steps": [
    {
      "op": "mount",
      "html": [
        "<div id=\"scroller\">",
        "  <div class=\"row\" id=\"r0\"></div>",
        "  <div class=\"row\" id=\"r1\"></div>",
        "  <div class=\"row\" id=\"r2\"></div>",
        "  <div class=\"row\" id=\"r3\"></div>",
        "  <div class=\"row\" id=\"r4\"></div>",
        "  <div class=\"row\" id=\"r5\"></div>",
        "  <div class=\"row\" id=\"r6\"></div>",
        "  <div class=\"row\" id=\"r7\"></div>",
        "  <div class=\"row\" id=\"r8\"></div>",
        "  <div class=\"row\" id=\"r9\"></div>",
        "</div>"
      ],
      "css": [
        "html, body { margin: 0; padding: 0; }",
        "#scroller { width: 200px; height: 100px; overflow-y: scroll; }",
        ".row { width: 100%; height: 50px; background: blue; }"
      ]
    },
    {
      "op": "wait",
      "ms": 1
    },
    {
      "op": "wait_frame"
    },
    {
      "op": "assert_exists",
      "selector": "#scroller"
    },
    {
      "op": "assert_node_count",
      "selector": ".row",
      "expected": 10
    },
    {
      "op": "scroll_node_by",
      "selector": "#scroller",
      "delta_x": 0,
      "delta_y": 120
    },
    {
      "op": "assert_scroll",
      "selector": "#scroller",
      "x": 0,
      "y": 120,
      "tolerance": 1.0
    },
    {
      "op": "scroll_node_by",
      "selector": "#scroller",
      "delta_x": 0,
      "delta_y": 120
    },
    {
      "op": "assert_scroll",
      "selector": "#scroller",
      "x": 0,
      "y": 240,
      "tolerance": 1.0
    }
  ]
}
