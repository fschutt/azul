{
  "name": "scroll_to_and_clamp",
  "description": "SCROLLING (absolute position + max clamp): scroll_node_to y=200 sets the absolute offset; y=0 returns to top (proving it is absolute, not a delta); y=99999 clamps to the maximum scroll (content 500 - viewport 100 = 400). Exercises ScrollManager::set_scroll_position \u2192 state.clamp().",
  "setup": {
    "window_width": 400,
    "window_height": 300,
    "dpi": 96
  },
  "steps": [
    {
      "op": "mount",
      "html": [
        "<div id=\"scroller\">",
        "  <div class=\"row\" id=\"r0\"></div>",
        "  <div class=\"row\" id=\"r1\"></div>",
        "  <div class=\"row\" id=\"r2\"></div>",
        "  <div class=\"row\" id=\"r3\"></div>",
        "  <div class=\"row\" id=\"r4\"></div>",
        "  <div class=\"row\" id=\"r5\"></div>",
        "  <div class=\"row\" id=\"r6\"></div>",
        "  <div class=\"row\" id=\"r7\"></div>",
        "  <div class=\"row\" id=\"r8\"></div>",
        "  <div class=\"row\" id=\"r9\"></div>",
        "</div>"
      ],
      "css": [
        "html, body { margin: 0; padding: 0; }",
        "#scroller { width: 200px; height: 100px; overflow-y: scroll; }",
        ".row { width: 100%; height: 50px; background: teal; }"
      ]
    },
    {
      "op": "wait",
      "ms": 1
    },
    {
      "op": "wait_frame"
    },
    {
      "op": "assert_exists",
      "selector": "#scroller"
    },
    {
      "op": "scroll_node_to",
      "selector": "#scroller",
      "x": 0,
      "y": 200
    },
    {
      "op": "assert_scroll",
      "selector": "#scroller",
      "x": 0,
      "y": 200,
      "tolerance": 1.0
    },
    {
      "op": "scroll_node_to",
      "selector": "#scroller",
      "x": 0,
      "y": 0
    },
    {
      "op": "assert_scroll",
      "selector": "#scroller",
      "x": 0,
      "y": 0,
      "tolerance": 1.0
    },
    {
      "op": "scroll_node_to",
      "selector": "#scroller",
      "x": 0,
      "y": 99999
    },
    {
      "op": "assert_scroll",
      "selector": "#scroller",
      "y": 400,
      "tolerance": 1.0
    }
  ]
}
