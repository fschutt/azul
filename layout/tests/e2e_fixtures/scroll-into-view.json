{
  "name": "scroll_into_view",
  "description": "SCROLLING (bring child into view): child #r3 starts at y=150 inside the content, below the 100px viewport. scroll_into_view block:\"start\" scrolls the container so #r3 aligns to the viewport top (offset y=150). Exercises LayoutWindow::scroll_node_into_view (window.rs:2485) + find_scrollable_ancestor.",
  "setup": {
    "window_width": 400,
    "window_height": 300,
    "dpi": 96
  },
  "steps": [
    {
      "op": "mount",
      "html": [
        "<div id=\"scroller\">",
        "  <div class=\"row\" id=\"r0\"></div>",
        "  <div class=\"row\" id=\"r1\"></div>",
        "  <div class=\"row\" id=\"r2\"></div>",
        "  <div class=\"row\" id=\"r3\"></div>",
        "  <div class=\"row\" id=\"r4\"></div>",
        "  <div class=\"row\" id=\"r5\"></div>",
        "  <div class=\"row\" id=\"r6\"></div>",
        "  <div class=\"row\" id=\"r7\"></div>",
        "  <div class=\"row\" id=\"r8\"></div>",
        "  <div class=\"row\" id=\"r9\"></div>",
        "</div>"
      ],
      "css": [
        "html, body { margin: 0; padding: 0; }",
        "#scroller { width: 200px; height: 100px; overflow-y: scroll; }",
        ".row { width: 100%; height: 50px; background: green; }"
      ]
    },
    {
      "op": "wait",
      "ms": 1
    },
    {
      "op": "wait_frame"
    },
    {
      "op": "assert_exists",
      "selector": "#scroller"
    },
    {
      "op": "assert_scroll",
      "selector": "#scroller",
      "y": 0,
      "tolerance": 1.0
    },
    {
      "op": "scroll_into_view",
      "selector": "#r3",
      "block": "start"
    },
    {
      "op": "wait",
      "ms": 1
    },
    {
      "op": "assert_exists",
      "selector": "#r3"
    },
    {
      "op": "assert_scroll",
      "selector": "#scroller",
      "y": 150,
      "tolerance": 1.0
    }
  ]
}
