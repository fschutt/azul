{
  "name": "focus_blur",
  "description": "WINDOW FOCUS / BLUR: blur flips window_focused / flags.has_focus false, focus flips them true. Mirrors WM_SETFOCUS/WM_KILLFOCUS (Windows) and X11 FocusIn/FocusOut. Asserts the window state actually changes. NODE focus is distinct from window focus in the real op set (the `focus` op is window-only), so #root (tabindex=0) is node-focused via Tab before get_focus_state reports it.",
  "setup": {
    "window_width": 400,
    "window_height": 300,
    "dpi": 96
  },
  "steps": [
    {
      "op": "mount",
      "html": [
        "<div id=\"root\" tabindex=\"0\">focus probe</div>"
      ],
      "css": [
        "html, body { margin: 0; padding: 0; width: 100%; height: 100%; }",
        "#root { width: 100%; height: 100%; background: green; font-family: \"Azul Mock Mono\"; font-size: 20px; }"
      ]
    },
    {
      "op": "wait",
      "ms": 1
    },
    {
      "op": "wait_frame"
    },
    {
      "op": "assert_exists",
      "selector": "#root"
    },
    {
      "op": "assert_window_state",
      "property": "focused",
      "expected": true
    },
    {
      "op": "assert_window_state",
      "property": "window_focused",
      "expected": true
    },
    {
      "op": "blur"
    },
    {
      "op": "wait",
      "ms": 1
    },
    {
      "op": "assert_window_state",
      "property": "focused",
      "expected": false
    },
    {
      "op": "assert_window_state",
      "property": "window_focused",
      "expected": false
    },
    {
      "op": "focus",
      "selector": "#root"
    },
    {
      "op": "wait",
      "ms": 1
    },
    {
      "op": "assert_window_state",
      "property": "focused",
      "expected": true
    },
    {
      "op": "assert_window_state",
      "property": "window_focused",
      "expected": true
    },
    {
      "op": "key_down",
      "key": "tab"
    },
    {
      "op": "wait",
      "ms": 1
    },
    {
      "op": "key_up",
      "key": "tab"
    },
    {
      "op": "wait",
      "ms": 1
    },
    {
      "op": "get_focus_state"
    },
    {
      "op": "assert_response",
      "type": "focus_state"
    },
    {
      "op": "assert_response",
      "contains": "root"
    },
    {
      "op": "blur"
    },
    {
      "op": "wait",
      "ms": 1
    },
    {
      "op": "assert_window_state",
      "property": "window_focused",
      "expected": false
    }
  ]
}
