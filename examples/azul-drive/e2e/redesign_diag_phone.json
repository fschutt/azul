[
  {
    "name": "azdrive_diag_phone_what_the_window_holds",
    "description": "No assertion: the DOMs of a phone's window, the boxes of its two virtual views (the folder's rows, the preview's pane) and the HTML of each, printed to the run's output for whoever reads it.",
    "only_on": [
      "linux",
      "windows",
      "macos"
    ],
    "steps": [
      {
        "op": "resize",
        "width": 411,
        "height": 800
      },
      {
        "op": "set_mode",
        "mode": "light"
      },
      {
        "op": "set_theme",
        "theme": "flora"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_settled"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "list_doms"
      },
      {
        "op": "print_response"
      },
      {
        "op": "get_node_layout",
        "selector": "#__azdrive_folder_rows"
      },
      {
        "op": "print_response"
      },
      {
        "op": "get_node_layout",
        "selector": "#__azdrive_preview_view"
      },
      {
        "op": "print_response"
      },
      {
        "op": "get_html_string",
        "dom_id": 1
      },
      {
        "op": "print_response"
      },
      {
        "op": "get_html_string",
        "dom_id": 2
      },
      {
        "op": "print_response"
      },
      {
        "op": "get_html_string"
      },
      {
        "op": "print_response"
      }
    ]
  }
]
