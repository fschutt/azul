[
  {
    "name": "a device whose connection died while it slept never says up to date; after waking it fetches the other device's changes",
    "description": "JOTTA-017 (Jottacloud): after sleep, VPN or IPv6 changes the client stopped receiving changes while showing an old 'Up to date'. Rules E2 (a full rescan follows the wake), E6 and O1 (remote-offline is said, never up to date).",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_fault", "device": "b", "partition": true },
      { "op": "drive_write", "device": "a", "path": "from-a.txt", "text": "written while b slept" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["remote-offline", "transient"], "when": "last" },
      { "op": "drive_status", "device": "b" },
      { "op": "assert_response", "path": "result.status", "not_contains": "azdrive-sync-status-up-to-date" },
      { "op": "drive_clock", "device": "b", "jump": 3600 },
      { "op": "drive_fault", "device": "b", "clear": true },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "from-a.txt", "text": "written while b slept" },
      { "op": "drive_status", "device": "b" },
      { "op": "assert_response", "path": "result.status", "contains": "azdrive-sync-status-up-to-date" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "the laptop sleeps in the middle of a download and the user edits the file after waking: the edit is never overwritten",
    "description": "JOTTA-017 (Jottacloud): the old app crashed after sleep and appeared online while offline. Rules E2 (a frozen pass re-checks every file before it writes), A5 and C1 (AzDrive holds the clash, keep both makes one copy). sync-chaos merge-sleep-resume.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "draft.md", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "b", "path": "draft.md", "text": "b's version" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a", "pause_at": "before-rename" },
      { "op": "drive_write", "device": "a", "path": "draft.md", "text": "a's edit after waking up" },
      { "op": "drive_clock", "device": "a", "jump": 3600 },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "draft.md", "text": "a's edit after waking up" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "changed-during-sync" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "conflict-held", "key": "draft.md" },
      { "op": "drive_resolve", "device": "a", "key": "draft.md", "choice": "both" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "kept_live", "texts": ["b's version", "a's edit after waking up"] },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "draft.md", "count": 1 },
      { "op": "drive_check", "check": "no_temp_files", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
