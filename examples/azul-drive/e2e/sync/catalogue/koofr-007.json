[
  {
    "name": "a pass frozen by sleep while both sides change, the network gone at wake: the next pass converges without a restart",
    "description": "KOOFR-007 (Koofr desktop, sleep and network loss): changes after wake-up were not detected and sync did not restart for hours. Rules E2, A2 and E1: a pass frozen for any time re-checks before it writes, a full rescan follows the wake, and offline edits merge on reconnect. sync-chaos merge-sleep-resume.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "notes.txt", "text": "v1" },
      { "op": "drive_write", "device": "a", "path": "todo.txt", "text": "t1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "before-sleep.txt", "text": "written before sleep" },
      { "op": "drive_sync", "device": "a", "pause_at": "after-scan", "expect": "any" },
      { "op": "drive_write", "device": "a", "path": "while-asleep.txt", "text": "written while asleep" },
      { "op": "drive_write", "device": "b", "path": "todo.txt", "text": "b's todo" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_fault", "device": "a", "partition": true },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a", "expect": "any" },
      { "op": "drive_fault", "device": "a", "clear": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "before-sleep.txt", "text": "written before sleep" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "while-asleep.txt", "text": "written while asleep" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "todo.txt", "text": "b's todo" },
      { "op": "drive_status", "device": "a" },
      { "op": "assert_response", "path": "result.crashes", "equals": 0 },
      { "op": "assert_response", "path": "result.status", "contains": "up-to-date" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "the laptop sleeps in the middle of a download and the user edits the file after waking: the edit is never overwritten",
    "description": "KOOFR-007: work after wake-up. Rules E2, A5 and C1: the target is checked again right before the rename; a file changed meanwhile is kept (changed-during-sync) and the drive's version becomes a conflict copy. sync-chaos merge-sleep-resume.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "draft.md", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "b", "path": "draft.md", "text": "b's version" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a", "pause_at": "before-rename", "expect": "any" },
      { "op": "drive_write", "device": "a", "path": "draft.md", "text": "a's edit after waking up" },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "draft.md", "text": "a's edit after waking up" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "changed-during-sync" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "assert_response", "path": "result.conflicts", "at_least": 1 },
      { "op": "drive_resolve", "device": "a", "key": "draft.md", "choice": "both" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "kept_live", "texts": ["b's version", "a's edit after waking up"] },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "draft.md", "count": 1 },
      { "op": "drive_check", "check": "no_temp_files", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
