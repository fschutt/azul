{
  "name": "a non-empty folder paired with a non-empty drive, and the first pass crashes: every local file survives, the result is a union",
  "description": "ICLOUD-020 (sync-chaos merge-first-sync-both-sides): iCloud for Windows mirrored the cloud onto a chosen non-empty D:\\ and wiped 200 GB after an interrupted first sync. Rules C4, D5 and E8: a first sync of two non-empty sides is a union (same bytes agree, different bytes are a held conflict, nothing deleted), a crash mid-way converges, and no delete or trash ever happens for a file the drive never had.",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "report.txt", "text": "a's report" },
    { "op": "drive_write", "device": "a", "path": "same.txt", "text": "identical" },
    { "op": "drive_many", "device": "a", "dir": "cloud", "count": 5, "size": 1000, "seed": 61 },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_write", "device": "b", "path": "report.txt", "text": "b's report" },
    { "op": "drive_write", "device": "b", "path": "same.txt", "text": "identical" },
    { "op": "drive_write", "device": "b", "path": "only-b.txt", "text": "only on b" },
    { "op": "drive_many", "device": "b", "dir": "local", "count": 30, "size": 1000, "seed": 60 },
    { "op": "drive_crash_at", "device": "b", "point": "after-blob" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle", "device": "b" },
    { "op": "drive_status", "device": "b" },
    { "op": "assert_response", "path": "result.crashes", "equals": 1 },
    { "op": "drive_check", "check": "files_count", "device": "b", "glob": "local/*", "count": 30 },
    { "op": "drive_check", "check": "file", "device": "b", "path": "report.txt", "text": "b's report" },
    { "op": "drive_sync", "device": "b", "expect": "any" },
    { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "key": "report.txt" },
    { "op": "drive_resolve", "device": "b", "key": "report.txt", "choice": "both" },
    { "op": "drive_wait_idle" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "kept_live", "texts": ["a's report", "b's report", "only on b"] },
    { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "report.txt", "count": 1 },
    { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "same.txt", "count": 0 },
    { "op": "drive_check", "check": "files_count", "device": "b", "glob": "local/*", "count": 30 },
    { "op": "drive_check", "check": "remote_count", "glob": "local/*", "count": 30 },
    { "op": "drive_check", "check": "files_count", "device": "b", "glob": "cloud/*", "count": 5 },
    { "op": "drive_check", "check": "trash_empty", "device": "b" },
    { "op": "drive_check", "check": "max_ops", "change": "trash", "device": "b", "max": 0 },
    { "op": "drive_check", "check": "max_ops", "change": "overwrite", "device": "b", "max": 0 },
    { "op": "drive_check", "check": "no_temp_files", "device": "b" },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_cleanup" }
  ]
}
