{
  "name": "uploads refused for five passes, then the server unreachable for a day (DDoS, network fault): nothing local is lost or deleted, everything catches up",
  "description": "KOOFR-024 (Koofr): DDoS and data-centre outages of about 24 h stalled uploads and downloads. Rules E6 (per-file retry, never a global stall, the status never says up to date), E1 (offline edits merge on reconnect) and D6 (an incomplete read is never a deletion): no delete, no conflict copy, a clean catch-up. sync-chaos res-server-down-long.",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x v1" },
    { "op": "drive_write", "device": "a", "path": "y.txt", "text": "y" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_fault", "remote": "r", "refuse_ops": ["put", "put_if"] },
    { "op": "drive_write", "device": "a", "path": "new.txt", "text": "written during the outage" },
    { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x v2" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "new.txt", "absent": true },
    { "op": "drive_status", "device": "a" },
    { "op": "assert_response", "path": "result.status", "not_contains": "azdrive-sync-status-up-to-date" },
    { "op": "drive_fault", "remote": "r", "clear": true, "partition": true },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_sync", "device": "b", "expect": "any" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_sync", "device": "b", "expect": "any" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_sync", "device": "b", "expect": "any" },
    { "op": "drive_clock", "device": "a", "jump": 86400 },
    { "op": "drive_clock", "device": "b", "jump": 86400 },
    { "op": "drive_fault", "remote": "r", "clear": true },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "new.txt", "text": "written during the outage" },
    { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "x.txt", "text": "x v2" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "x.txt", "text": "x v2" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "y.txt", "text": "y" },
    { "op": "drive_check", "check": "trash_empty", "device": "a" },
    { "op": "drive_check", "check": "trash_empty", "device": "b" },
    { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "x.txt", "count": 0 },
    { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "x.txt", "count": 0 },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "remote-offline" },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_cleanup" }
  ]
}
