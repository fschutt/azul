      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "sub/a.txt", "text": "sub a" },
      { "op": "drive_write", "device": "a", "path": "sub/b.txt", "text": "sub b" },
      { "op": "drive_write", "device": "a", "path": "other.txt", "text": "other" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_chmod", "device": "a", "path": "sub", "mode": "000" },
      { "op": "drive_write", "device": "a", "path": "other2.txt", "text": "goes on" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "unreadable", "key": "sub*" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "sub/a.txt", "text": "sub a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "other2.txt", "text": "goes on" },
      { "op": "drive_status", "device": "a" },
      { "op": "assert_response", "path": "result.status", "not_contains": "azdrive-sync-status-up-to-date" },
