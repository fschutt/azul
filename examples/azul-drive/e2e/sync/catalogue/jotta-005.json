[
  {
    "name": "the synced folder is moved elsewhere: the old place is missing and nothing is deleted; pairing the new place sends nothing again",
    "description": "JOTTA-005 (Jottacloud): moving the sync folder looked like a mass delete and deleted files. Rules D3 (a missing root changes nothing anywhere and says root-missing) and D5 (moving the root never deletes; re-pairing rebuilds by content). sync-chaos delete-root-moved.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "music", "count": 5, "text_prefix": "song" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_move_root", "device": "a" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "root-missing" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 5 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 5 },
      { "op": "drive_unpair", "device": "a" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "remote_puts", "device": "a", "max": 5 },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 5 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 5 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "max_ops", "change": "trash", "device": "b", "max": 0 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "the folder is moved while a pass is running: the pass deletes nothing on the drive or the other device",
    "description": "JOTTA-005 (Jottacloud), the catalogue's 'kill the client halfway' form: the move happens under a running pass. Rule D3 (the root's identity is checked before any change) and D6 (what a pass cannot read is unknown, never deleted).",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "music", "count": 5, "text_prefix": "song" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a", "pause_at": "start" },
      { "op": "drive_move_root", "device": "a" },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "root-missing" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 5 },
      { "op": "drive_index", "remote": "r" },
      { "op": "assert_response", "path": "result.deleted", "len": 0 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 5 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  }
]
