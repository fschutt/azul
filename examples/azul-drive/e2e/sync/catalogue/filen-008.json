[
  {
    "name": "FILEN-008: a file rewritten with the same size and its old modification time put back is still seen as changed",
    "description": "FILEN-008 (Filen): change detection by whole-second mtime missed edits within the same second; edits never propagated. Rule P12: time is a hint, never the decision (the cache key includes ctime). sync-chaos merge-same-size-same-mtime.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "ledger.csv", "mtime": 1700000000000000000, "text": "1,2,3" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_overwrite_in_place", "device": "a", "path": "ledger.csv", "text": "9,9,9" },
      { "op": "drive_utime", "device": "a", "path": "ledger.csv", "mtime": 1700000000000000000 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "ledger.csv", "text": "9,9,9" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "ledger.csv", "text": "9,9,9" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-008: a size-only change (0 bytes to some) with the same modification time propagates",
    "description": "FILEN-008 (Filen): a size-only change (0 to N bytes) in the same second was missed. Rules P12, P7.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "lock.state", "mtime": 1700000000000000000, "text": "" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "lock.state", "size": 0 },
      { "op": "drive_write", "device": "a", "path": "lock.state", "mtime": 1700000000000000000, "text": "now it has bytes" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "lock.state", "text": "now it has bytes" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "lock.state", "text": "now it has bytes" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-008: an edit from a device whose clock is an hour behind (an older mtime than here) still comes down",
    "description": "FILEN-008 (Filen): a remote edit whose mtime was older than the local file's, through peer clock skew, was ignored. Rules C3 (no time-based decision), P12.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r", "clock": -3600 },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "f.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "b", "path": "f.txt", "mtime": 1600000000000000000, "text": "b's edit, its clock an hour behind" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "f.txt", "text": "b's edit, its clock an hour behind" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "f.txt", "text": "b's edit, its clock an hour behind" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "f.txt", "count": 0 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-008: a device whose clock runs a year ahead edits concurrently: still a conflict with both kept, never 'the newer time wins'",
    "description": "FILEN-008 (Filen): peer clock skew decided which version survived. Rule C3: a clock a year off changes the conflict copy's date, never which version survives; the first committer keeps the name. sync-chaos merge-clock-skew.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r", "clock": 31536000 },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "budget.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "budget.txt", "text": "a's real edit" },
      { "op": "drive_write", "device": "b", "path": "budget.txt", "mtime": 1924992000000000000, "text": "b's skewed edit" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.conflicts", "equals": 1 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "key": "budget.txt" },
      { "op": "drive_resolve", "device": "b", "key": "budget.txt", "choice": "both" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "budget.txt", "text": "a's real edit" },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "budget.txt", "count": 1 },
      { "op": "drive_check", "check": "kept_live", "texts": ["a's real edit", "b's skewed edit"] },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-008: a bare touch here never beats a real edit on the drive, and a touch alone sends nothing",
    "description": "FILEN-008 (Filen): a bare local touch 'won' and stale bytes were uploaded over a genuine remote edit; a touch on a downloaded file re-uploaded it as a new version. Rule P12: a touch alone sends nothing.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "f.txt", "text": "base" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "b", "path": "f.txt", "text": "b's real edit" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_utime", "device": "a", "path": "f.txt", "mtime": 1800000000000000000 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "f.txt", "text": "b's real edit" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "f.txt", "text": "b's real edit" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "f.txt", "count": 0 },
      { "op": "drive_utime", "device": "b", "path": "f.txt", "mtime": 1810000000000000000 },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
