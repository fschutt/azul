{
  "name": "names written decomposed on a Mac are one file everywhere: no duplicate, no garbling, a normalization-only rename sends nothing",
  "description": "PCLOUD-007 (pCloud): Korean/Japanese and accented names from a Mac (NFD) arrived decomposed or garbled on Windows or failed to sync. Rules P2/P1/O1 (sync-chaos port-nfc-nfd): original bytes kept, names compared in NFC; an NFD name and the drive's NFC twin are one file, a real collision is listed (name-collision).",
  "steps": [
    { "op": "drive_harness" },
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "cafe\u0301.txt", "text": "from the mac" },
    { "op": "drive_write", "device": "a", "path": "\u1112\u1161\u11ab\u1100\u1173\u11af.mov", "text": "korean video" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "remote_count", "glob": "caf*", "count": 1 },
    { "op": "drive_check", "check": "remote_count", "glob": "*.mov", "count": 1 },
    { "op": "drive_check", "check": "files_count", "device": "b", "glob": "caf*", "count": 1 },
    { "op": "drive_check", "check": "files_count", "device": "b", "glob": "*.mov", "count": 1 },
    { "op": "drive_check", "check": "remote_file", "key": "\u1112\u1161\u11ab\u1100\u1173\u11af.mov", "text": "korean video" },
    { "op": "drive_rename", "device": "a", "from": "\u1112\u1161\u11ab\u1100\u1173\u11af.mov", "to": "한글.mov" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
    { "op": "drive_check", "check": "remote_count", "glob": "*.mov", "count": 1 },
    { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "한글.mov", "count": 0 },
    { "op": "drive_tamper", "remote": "r", "action": "put", "key": "café.txt", "text": "from windows", "writer": "win-pc" },
    { "op": "drive_sync", "device": "b", "expect": "any" },
    { "op": "drive_sync", "device": "b", "expect": "any" },
    { "op": "drive_check", "check": "files_count", "device": "b", "glob": "caf*", "count": 1 },
    { "op": "drive_check", "check": "problem", "device": "b", "code": "name-collision" },
    { "op": "drive_check", "check": "remote_file", "key": "cafe\u0301.txt", "text": "from the mac" },
    { "op": "drive_check", "check": "remote_file", "key": "café.txt", "text": "from windows" },
    { "op": "drive_check", "check": "trash_empty", "device": "b" },
    { "op": "drive_cleanup" }
  ]
}
