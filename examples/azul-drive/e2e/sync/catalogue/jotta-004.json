{
  "name": "a lock file created and deleted again and again while a big file goes up: no spurious checksum error, no missing object, the big file reads back",
  "description": "JOTTA-004 (Jottacloud): restic's frequent lock-file create/delete next to data packs made uploads fail (HTTP 421) and downloads 404 for days. Rules V5 (object churn causes no spurious errors) and E6 (per-file, never a global stall). sync-chaos srv-small-object-churn (its dc run is the server part).",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "big.bin", "size": 8388608, "seed": 7 },
    { "op": "drive_sync", "device": "a", "pause_at": "mid-read" },
    { "op": "drive_write", "device": "b", "path": "locks/lock.txt", "text": "lock 0" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_rm", "device": "b", "path": "locks/lock.txt" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_write", "device": "b", "path": "locks/lock.txt", "text": "lock 1" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_rm", "device": "b", "path": "locks/lock.txt" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_write", "device": "b", "path": "locks/lock.txt", "text": "lock 2" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_rm", "device": "b", "path": "locks/lock.txt" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_write", "device": "b", "path": "locks/lock.txt", "text": "lock 3" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_rm", "device": "b", "path": "locks/lock.txt" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_write", "device": "b", "path": "locks/lock.txt", "text": "lock 4" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_rm", "device": "b", "path": "locks/lock.txt" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_write", "device": "b", "path": "locks/lock.txt", "text": "lock 5" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_rm", "device": "b", "path": "locks/lock.txt" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_cont", "device": "a" },
    { "op": "drive_wait", "device": "a" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "big.bin", "same_as": "{root:a}/big.bin" },
    { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "locks/lock.txt", "absent": true },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "hash-mismatch", "absent": true },
    { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "absent": true },
    { "op": "drive_check", "check": "problem", "device": "b", "code": "remote-entry-unreadable", "absent": true },
    { "op": "drive_check", "check": "remote_consistent" },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_cleanup" }
  ]
}
