[
  {
    "name": "three pairings survive AzDrive quitting and starting again (an update): each keeps its pairing, the next pass sends and fetches nothing",
    "description": "KOOFR-023 (Koofr): an update lost every sync configuration; users re-added each pair and re-scanned. Rules D5 (no update or login path removes a file) and A1 (the base persists in the state folder): after a restart all three pairings stay paired and the next pass transfers nothing. sync-chaos state-upgrade-migration.",
    "steps": [
      { "op": "drive_create", "remote": "r1", "encrypted": false },
      { "op": "drive_create", "remote": "r2", "encrypted": false },
      { "op": "drive_create", "remote": "r3", "encrypted": false },
      { "op": "drive_open", "device": "a1", "remote": "r1" },
      { "op": "drive_open", "device": "a2", "remote": "r2" },
      { "op": "drive_open", "device": "a3", "remote": "r3" },
      { "op": "drive_pair", "device": "a1" },
      { "op": "drive_pair", "device": "a2" },
      { "op": "drive_pair", "device": "a3" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a1", "path": "notes/a1.txt", "text": "notes of a1" },
      { "op": "drive_write", "device": "a1", "path": "photo.jpg", "size": 40000, "seed": 51 },
      { "op": "drive_sync", "device": "a1" },
      { "op": "drive_write", "device": "a2", "path": "notes/a2.txt", "text": "notes of a2" },
      { "op": "drive_write", "device": "a2", "path": "photo.jpg", "size": 40000, "seed": 52 },
      { "op": "drive_sync", "device": "a2" },
      { "op": "drive_write", "device": "a3", "path": "notes/a3.txt", "text": "notes of a3" },
      { "op": "drive_write", "device": "a3", "path": "photo.jpg", "size": 40000, "seed": 53 },
      { "op": "drive_sync", "device": "a3" },
      { "op": "drive_restart", "device": "a1" },
      { "op": "drive_sync", "device": "a1" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "assert_response", "path": "result.conflicts", "equals": 0 },
      { "op": "drive_status", "device": "a1" },
      { "op": "assert_response", "path": "result.paired", "equals": true },
      { "op": "drive_check", "check": "files_count", "device": "a1", "count": 2 },
      { "op": "drive_check", "check": "trash_empty", "device": "a1" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a1", "path": "photo.jpg", "count": 0 },
      { "op": "drive_restart", "device": "a2" },
      { "op": "drive_sync", "device": "a2" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "assert_response", "path": "result.conflicts", "equals": 0 },
      { "op": "drive_status", "device": "a2" },
      { "op": "assert_response", "path": "result.paired", "equals": true },
      { "op": "drive_check", "check": "files_count", "device": "a2", "count": 2 },
      { "op": "drive_check", "check": "trash_empty", "device": "a2" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a2", "path": "photo.jpg", "count": 0 },
      { "op": "drive_restart", "device": "a3" },
      { "op": "drive_sync", "device": "a3" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "assert_response", "path": "result.conflicts", "equals": 0 },
      { "op": "drive_status", "device": "a3" },
      { "op": "assert_response", "path": "result.paired", "equals": true },
      { "op": "drive_check", "check": "files_count", "device": "a3", "count": 2 },
      { "op": "drive_check", "check": "trash_empty", "device": "a3" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a3", "path": "photo.jpg", "count": 0 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "the pairing's state lost or cut off mid-write (a reinstall that dropped the configuration): rebuilt by content, nothing sent again, nothing deleted, no conflict copy",
    "description": "KOOFR-023 (Koofr): after uninstall/re-add every pair re-scanned and re-downloaded. Rule D5 (lost or corrupted state never deletes) and A1 (the base is rebuilt by hashing against the drive). sync-chaos state-upgrade-migration, delete-state-lost.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "a.txt", "text": "kept a" },
      { "op": "drive_write", "device": "a", "path": "sub/b.txt", "text": "kept b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_wipe_state", "device": "a" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "assert_response", "path": "result.conflicts", "equals": 0 },
      { "op": "drive_corrupt_state", "device": "b" },
      { "op": "drive_restart", "device": "b" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "a.txt", "count": 0 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "a.txt", "count": 0 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 2 },
      { "op": "drive_cleanup" }
    ]
  },
