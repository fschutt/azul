[
  {
    "name": "logging out (unpairing) and logging in again never removes a local file, never duplicates one, and sends only what is new",
    "description": "JOTTA-023 (Jottacloud): every login created a new backup device ('myserver (2)'), orphaned the old history and rescanned everything. Rule D5 (no login path removes a file; a re-pairing rebuilds by content and re-attaches). sync-chaos delete-unpair-keeps-files, state-upgrade-migration.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "thesis/ch1.tex", "text": "chapter 1" },
      { "op": "drive_write", "device": "a", "path": "thesis/ch2.tex", "text": "chapter 2" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_unpair", "device": "a" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 2 },
      { "op": "drive_write", "device": "a", "path": "thesis/ch3.tex", "text": "written while logged out" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 3 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 3 },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "thesis/ch1.tex", "count": 0 },
      { "op": "drive_check", "check": "kept_live", "texts": ["chapter 1", "chapter 2", "written while logged out"] },
      { "op": "drive_check", "check": "remote_puts", "device": "a", "max": 3 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  },
  {
