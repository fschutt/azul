      { "op": "drive_write", "device": "a", "path": "second.txt", "text": "second edited on a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "first.txt", "text": "first edited on a" },
