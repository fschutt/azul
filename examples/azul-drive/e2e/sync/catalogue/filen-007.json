      { "op": "drive_check", "check": "kept_live", "texts": ["first edited on a", "second edited on a"] },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-007: a file replaced by a folder on one device while the other deletes the file, in either order: the new folder survives",
    "description": "FILEN-007 (Filen): A replaced a path's type (file to folder) while B deleted it, and the delete ran against the new folder and emptied both sides. Rules C2 (new work beats a delete), C1 (a file against a folder keeps both).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "p", "text": "p was a file" },
      { "op": "drive_write", "device": "a", "path": "q", "text": "q was a file" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "a", "path": "p" },
      { "op": "drive_write", "device": "a", "path": "p/inner.txt", "text": "a's new folder p" },
      { "op": "drive_rm", "device": "b", "path": "p" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_rm", "device": "b", "path": "q" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "a", "path": "q" },
      { "op": "drive_write", "device": "a", "path": "q/inner.txt", "text": "a's new folder q" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "p/inner.txt", "text": "a's new folder p" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "p/inner.txt", "text": "a's new folder p" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "q/inner.txt", "text": "a's new folder q" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "q/inner.txt", "text": "a's new folder q" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "p/inner.txt", "text": "a's new folder p" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "q/inner.txt", "text": "a's new folder q" },
      { "op": "drive_check", "check": "kept_live", "texts": ["a's new folder p", "a's new folder q"] },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
