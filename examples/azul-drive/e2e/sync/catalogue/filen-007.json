[
  {
    "name": "FILEN-007: one device deletes a folder and a file while the other, offline, adds a file to that folder and edits that file: the new work survives",
    "description": "FILEN-007 (Filen): a directory delete wiped a brand-new child on both sides, and a remote delete beat a newer local edit. Rule C2: an edit beats a delete, in either order, and a new file in a deleted folder survives. sync-chaos merge-delete-folder-vs-new-file.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "d/old.txt", "text": "old" },
      { "op": "drive_write", "device": "a", "path": "f.txt", "text": "f v1" },
      { "op": "drive_write", "device": "a", "path": "stays.txt", "text": "stays" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_fault", "device": "b", "partition": true },
      { "op": "drive_rmtree", "device": "a", "path": "d" },
      { "op": "drive_rm", "device": "a", "path": "f.txt" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "b", "path": "d/new.txt", "text": "new on b" },
      { "op": "drive_write", "device": "b", "path": "f.txt", "text": "f edited on b" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_fault", "device": "b", "clear": true },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "d/new.txt", "text": "new on b" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "f.txt", "text": "f edited on b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "d/new.txt", "text": "new on b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "f.txt", "text": "f edited on b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "d/old.txt", "absent": true },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "d/new.txt", "text": "new on b" },
      { "op": "drive_check", "check": "kept_live", "texts": ["new on b", "f edited on b", "stays"] },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-007: one device edits a file while the other deletes it, in either order: the edit wins",
    "description": "FILEN-007 (Filen): the remote delete beat the newer local edit. Rule C2. sync-chaos merge-edit-vs-delete.",
