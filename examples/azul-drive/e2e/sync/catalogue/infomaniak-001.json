[
  {
    "name": "the drive unreachable for over two hours (a DNS outage), then still unreachable for one device: edits wait, nothing is taken as an empty drive",
    "description": "INFOMANIAK-001 (Infomaniak): a broken DNS change took every service down for 2h15, longer for clients with stale DNS caches. Rules E1, E6 and D6: an unreachable drive is remote-offline, never an empty listing; local edits wait; nothing is deleted or trashed on any device; once it is back everything converges. sync-chaos res-server-down-long, res-hostile-network.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x v1" },
      { "op": "drive_write", "device": "a", "path": "y.txt", "text": "y" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_fault", "remote": "r", "partition": true },
      { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x v2, during the outage" },
      { "op": "drive_write", "device": "a", "path": "new.txt", "text": "new during the outage" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_clock", "device": "a", "jump": 8100 },
      { "op": "drive_clock", "device": "b", "jump": 8100 },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "remote-offline", "when": "last" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "remote-offline", "when": "last" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 3 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 2 },
      { "op": "drive_fault", "remote": "r", "clear": true },
      { "op": "drive_fault", "device": "b", "partition": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 2 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_fault", "device": "b", "clear": true },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "x.txt", "text": "x v2, during the outage" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "new.txt", "text": "new during the outage" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "x.txt", "count": 0 },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a wrong host answers for the drive (DNS pointing elsewhere): its answers are refused, nothing here changes",
    "description": "INFOMANIAK-001 (Infomaniak): a wrong name server could send clients to another host. Rules M2 and D6: a response that is not the drive's (another drive's index, an unknown key) is refused and listed; nothing is deleted or overwritten here.",
    "pending": "drive_fault {device, answer_from: <remote>}: the device's requests are answered by another remote (a hijacked or wrong DNS name)",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_create", "remote": "impostor", "encrypted": false },
      { "op": "drive_tamper", "remote": "impostor", "action": "put", "key": "x.txt", "text": "from the impostor" },
      { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_fault", "device": "a", "answer_from": "impostor" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["remote-index-unreadable", "sign-in-needed", "other"], "when": "last" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "x.txt", "text": "x v1" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_fault", "device": "a", "clear": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "x.txt", "text": "x v1" },
      { "op": "drive_check", "check": "remote_never_has", "remote": "r", "marker": "from the impostor" },
      { "op": "drive_cleanup" }
    ]
  }
]
