{
  "name": "a backup with .dll, .exe, .lnk, .ini, .sys, .bat and .msi files: every file arrives, and a new device a year later gets all of them",
  "description": "ICEDRIVE-013 (Icedrive): a year after a verified backup, folders holding .dll files were empty on the drive and the web (cause unknown, maybe a file-type filter). Rules P11 (only the systems' own bookkeeping is ignored, by name, never a file type) and V7: every program file goes up, the drive still holds every one later, and a new device paired a year on (the old SSD died) gets all of them. sync-chaos port-ignored-system-files.",
  "steps": [
    { "op": "drive_create", "remote": "r" },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "Program/app.dll", "size": 40000, "seed": 51 },
    { "op": "drive_write", "device": "a", "path": "Program/app.exe", "size": 60000, "seed": 52 },
    { "op": "drive_write", "device": "a", "path": "Program/plugins/codec.dll", "size": 30000, "seed": 53 },
    { "op": "drive_write", "device": "a", "path": "Start Menu/App.lnk", "size": 1200, "seed": 54 },
    { "op": "drive_write", "device": "a", "path": "Program/config/settings.ini", "text": "[main]\nlang=en\n" },
    { "op": "drive_write", "device": "a", "path": "drivers/disk.sys", "size": 25000, "seed": 55 },
    { "op": "drive_write", "device": "a", "path": "scripts/run.bat", "text": "@echo off\r\napp.exe\r\n" },
    { "op": "drive_write", "device": "a", "path": "setup.msi", "size": 50000, "seed": 56 },
    { "op": "drive_write", "device": "a", "path": "lib/libfoo.so", "size": 20000, "seed": 57 },
    { "op": "drive_write", "device": "a", "path": "lib/libfoo.dylib", "size": 20000, "seed": 58 },
    { "op": "drive_sync", "device": "a" },
    { "op": "assert_response", "path": "result.up", "equals": 10 },
    { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 10 },
    { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "*.dll", "count": 2 },
    { "op": "drive_problems", "device": "a" },
    { "op": "assert_response", "path": "result.problems", "len": 0 },
    { "op": "drive_clock", "device": "a", "jump": 31536000 },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
    { "op": "drive_remove_root", "device": "a" },
    { "op": "drive_open", "device": "c", "remote": "r", "clock": 31536000 },
    { "op": "drive_pair", "device": "c" },
    { "op": "drive_wait_idle", "device": "c" },
    { "op": "drive_sync", "device": "c" },
    { "op": "drive_check", "check": "files_count", "device": "c", "count": 10 },
    { "op": "drive_check", "check": "file", "device": "c", "path": "Program/plugins/codec.dll", "size": 30000 },
    { "op": "drive_check", "check": "file", "device": "c", "path": "Program/config/settings.ini", "text": "[main]\nlang=en\n" },
    { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 10 },
    { "op": "drive_cleanup" }
  ]
}
