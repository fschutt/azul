[
  {
    "name": "a client update that loses its state brings back no deleted file and no renamed folder's old name, and keeps the times",
    "description": "PCLOUD-003 (pCloud): after an auto-update the folders reverted to months-old states, deleted files came back, renamed folders reappeared under the old name, re-created files carried the download time. Rules D5/A3/P6 (sync-chaos delete-state-lost, state-upgrade-migration): a lost state rebuilds by content against the drive; tombstones and renames hold; mtimes travel.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "docs/a.txt", "text": "kept a", "mtime": 1700000000000000000 },
      { "op": "drive_write", "device": "a", "path": "old-name/b.txt", "text": "kept b", "mtime": 1700000001000000000 },
      { "op": "drive_write", "device": "a", "path": "gone.txt", "text": "deleted years ago" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "a", "path": "gone.txt" },
      { "op": "drive_rename", "device": "a", "from": "old-name", "to": "new-name" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_wipe_state", "device": "a" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "gone.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "a", "path": "old-name", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "old-name", "absent": true },
      { "op": "drive_check", "check": "remote_file", "key": "gone.txt", "absent": true },
      { "op": "drive_check", "check": "remote_count", "glob": "old-name/*", "count": 0 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "new-name/b.txt", "text": "kept b" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "docs/a.txt", "count": 0 },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 2 },
      { "op": "drive_check", "check": "mtime", "device": "b", "path": "docs/a.txt", "ns": 1700000000000000000 },
      { "op": "drive_check", "check": "mtime", "device": "a", "path": "docs/a.txt", "ns": 1700000000000000000 },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "an older index from the server (months-old state) is refused: nothing deleted here, nothing old written over new",
    "description": "PCLOUD-003 (pCloud): remote 'old' state applied over newer local state. Rules S15/M2 (sync-chaos sec-remote-rollback): an index older than the last one seen is refused (remote-rollback).",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "keep.txt", "text": "keep" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "new.txt", "text": "new work" },
      { "op": "drive_write", "device": "a", "path": "keep.txt", "text": "keep, edited" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "rollback", "generations": 1 },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "remote-rollback" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "new.txt", "text": "new work" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "keep.txt", "text": "keep, edited" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  }
]
