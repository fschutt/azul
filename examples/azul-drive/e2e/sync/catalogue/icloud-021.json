[
  {
    "name": "a true conflict, twice: both versions stay as visible files, each one listed for the user",
    "description": "ICLOUD-021 (sync-chaos merge-offline-edit-both): iCloud hid the losing version and silently picked a winner, so typed paragraphs vanished. Rules C1 and O1: the conflict is listed (conflict-held), keep both makes a visible copy in the folder, the next conflict takes the next free name.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "notes/plan.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "notes/plan.txt", "text": "v2 from a" },
      { "op": "drive_write", "device": "b", "path": "notes/plan.txt", "text": "v2 from b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.conflicts", "equals": 1 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "key": "notes/plan.txt" },
      { "op": "drive_resolve", "device": "b", "key": "notes/plan.txt", "choice": "both" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "a", "path": "notes/plan.txt", "text": "v3 from a" },
      { "op": "drive_write", "device": "b", "path": "notes/plan.txt", "text": "v3 from b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.conflicts", "equals": 1 },
      { "op": "drive_resolve", "device": "b", "key": "notes/plan.txt", "choice": "both" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "kept_live", "texts": ["v2 from b", "v3 from a", "v3 from b"] },
      { "op": "drive_check", "check": "kept", "texts": ["v2 from a"] },
      { "op": "drive_check", "check": "file", "device": "b", "path": "notes/plan.txt", "text": "v3 from a" },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "notes/plan.txt", "count": 2 },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "notes/plan.txt", "count": 2 },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "one device edits twice and the first commit's answer was lost: no conflict",
    "description": "ICLOUD-021: a phantom conflict with a version never made elsewhere. Rules C3 and A4: repeated edits from one device never conflict, also when a pass crashed after its commit and before it saved its base (the lost acknowledgement).",
    "steps": [
      { "op": "drive_create", "remote": "r2", "encrypted": false },
      { "op": "drive_open", "device": "c", "remote": "r2" },
      { "op": "drive_open", "device": "d", "remote": "r2" },
      { "op": "drive_pair", "device": "c" },
      { "op": "drive_pair", "device": "d" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "c", "path": "main.swift", "text": "first" },
      { "op": "drive_sync", "device": "c" },
      { "op": "drive_sync", "device": "d" },
      { "op": "drive_write", "device": "c", "path": "main.swift", "text": "second" },
      { "op": "drive_sync", "device": "c", "crash_at": "after-commit", "expect": "crash" },
      { "op": "drive_write", "device": "c", "path": "main.swift", "text": "third" },
      { "op": "drive_sync", "device": "c" },
      { "op": "assert_response", "path": "result.conflicts", "equals": 0 },
      { "op": "drive_sync", "device": "d" },
      { "op": "drive_check", "check": "file", "device": "d", "path": "main.swift", "text": "third" },
      { "op": "drive_check", "check": "conflict_copies", "device": "c", "path": "main.swift", "count": 0 },
      { "op": "drive_check", "check": "conflict_copies", "device": "d", "path": "main.swift", "count": 0 },
      { "op": "drive_check", "check": "problem", "device": "c", "code": "conflict-held", "absent": true },
      { "op": "drive_check", "check": "kept", "texts": ["second"] },
      { "op": "drive_cleanup" }
    ]
  }
]
