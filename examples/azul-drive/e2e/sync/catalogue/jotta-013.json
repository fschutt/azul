[
  {
    "name": "a pass runs in the middle of Word's save, while the document exists only under a temp name: no delete, the other device keeps it, then gets the new version",
    "description": "JOTTA-013 (Jottacloud): 'saving an office document could lead to the file being deleted', temp files moved to the trash. Rules P10 (atomic saves are one change) and D6 (a file an app is saving is unknown, never deleted). sync-chaos port-office-save-interrupted.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "Pra\u0308sentation.docx", "text": "draft" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "~WRD0001.tmp", "text": "final" },
      { "op": "drive_rename", "device": "a", "from": "Pra\u0308sentation.docx", "to": "~WRL0002.tmp" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Pra\u0308sentation.docx", "text": "draft" },
      { "op": "drive_rename", "device": "a", "from": "~WRD0001.tmp", "to": "Pra\u0308sentation.docx" },
      { "op": "drive_rm", "device": "a", "path": "~WRL0002.tmp" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "save-in-progress" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Pra\u0308sentation.docx", "text": "final" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "Pra\u0308sentation.docx", "count": 0 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 1 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "Word's whole save sequence and a Windows shortcut: one new version, no delete, no temp file on the drive, no conflict copy",
    "description": "JOTTA-013 (Jottacloud): the catalogue's replay of Word's save (temp written, original renamed aside, temp renamed in, aside deleted) and 'conflicted files for some windows shortcuts'. Rules P10 and P11 (temp and lock files never go up).",
    "steps": [
