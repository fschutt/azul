{
  "name": "wrong passphrases entered again and again lock and slow down, never delete; a forgotten passphrase is recovered with the recovery code",
  "description": "TERABOX-002 (TeraBox): the Safe is wiped after too many wrong passcodes (a 4-digit default), and a forgotten password cannot be recovered. Rules I1 (the drive key is wrapped; the recovery wrap opens it) and D5 (no login path removes a file). sync-chaos crypto-keys-and-recovery (pending there).",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": true },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "vault/passport.pdf", "text": "passport scan" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_lock", "device": "a" },
    { "op": "drive_recover", "device": "a", "recovery_code": "0000-0000-0000-0000", "expect": "refused" },
    { "op": "drive_recover", "device": "a", "recovery_code": "0000-0000-0000-0000", "expect": "refused" },
    { "op": "drive_recover", "device": "a", "recovery_code": "0000-0000-0000-0000", "expect": "refused" },
    { "op": "drive_recover", "device": "a", "recovery_code": "0000-0000-0000-0000", "expect": "refused" },
    { "op": "drive_recover", "device": "a", "recovery_code": "0000-0000-0000-0000", "expect": "refused" },
    { "op": "drive_recover", "device": "a", "recovery_code": "0000-0000-0000-0000", "expect": "refused" },
    { "op": "drive_recover", "device": "a", "recovery_code": "0000-0000-0000-0000", "expect": "refused" },
    { "op": "drive_recover", "device": "a", "recovery_code": "0000-0000-0000-0000", "expect": "refused" },
    { "op": "drive_recover", "device": "a", "recovery_code": "0000-0000-0000-0000", "expect": "refused" },
    { "op": "drive_recover", "device": "a", "recovery_code": "0000-0000-0000-0000", "expect": "refused" },
    { "op": "assert_response", "path": "result.recovered", "equals": false },
    { "op": "drive_check", "check": "file", "device": "a", "path": "vault/passport.pdf", "text": "passport scan" },
    { "op": "drive_recover", "device": "a", "recovery_code": "{recovery:r}" },
    { "op": "drive_index", "remote": "r" },
    { "op": "assert_response", "path": "result.files", "len": 1 },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "file", "device": "a", "path": "vault/passport.pdf", "text": "passport scan" },
    { "op": "drive_check", "check": "trash_empty", "device": "a" },
    { "op": "drive_cleanup" }
  ]
}
