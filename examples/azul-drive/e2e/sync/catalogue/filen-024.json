[
  {
    "name": "FILEN-024: a pass killed at every step (after a blob, after the commit, before a rename, inside a conflict, before the base is saved) converges in the next one",
    "description": "FILEN-024 (Filen): interrupting a 1.12 TB first upload, Ctrl+C or 'docker compose down' left partial state files and the client refused to start or restarted from scratch. Rule E8: a kill at any moment converges in the next pass, no temp file, no doubled conflict copy. sync-chaos res-crash-points.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "f1.txt", "text": "one" },
      { "op": "drive_sync", "device": "a", "crash_at": "after-blob", "expect": "crash" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "f1.txt", "text": "one" },
      { "op": "drive_write", "device": "a", "path": "f2.txt", "text": "two" },
      { "op": "drive_sync", "device": "a", "crash_at": "after-commit", "expect": "crash" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b", "crash_at": "before-rename", "expect": "crash" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "f1.txt", "text": "a's one" },
      { "op": "drive_write", "device": "b", "path": "f1.txt", "text": "b's one" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "key": "f1.txt" },
      { "op": "drive_resolve", "device": "b", "key": "f1.txt", "choice": "both" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "b", "crash_at": "conflict-start", "expect": "crash" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "b", "path": "f3.txt", "text": "three" },
      { "op": "drive_sync", "device": "b", "crash_at": "before-base-save", "expect": "crash" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "f1.txt", "count": 1 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "f1 (conflict*", "count": 1 },
      { "op": "drive_check", "check": "no_temp_files", "device": "a" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_check", "check": "kept_live", "texts": ["a's one", "b's one", "two", "three"] },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-024: a restart with hundreds of files sends nothing again",
    "description": "FILEN-024 (Filen): every restart re-uploaded all 200,000 files (about 15 times in a year). Rules A1 (the base is persisted, unchanged files are known by their cache key and hash), D5.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "lib", "count": 300, "size": 2000, "seed": 3 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_restart", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-024: a lost or corrupted sync state is said once and rebuilt by hash: nothing deleted, nothing sent again, no conflict copy",
    "description": "FILEN-024 (Filen): pairs vanished on upgrade and logout, the CLI left partial state files and refused to start. Rules D6, D5 (lost or corrupted state never deletes anything). sync-chaos delete-state-lost.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x" },
      { "op": "drive_write", "device": "a", "path": "y.txt", "text": "y" },
      { "op": "drive_write", "device": "a", "path": "z.txt", "text": "z" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "b", "path": "z.txt" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_corrupt_state", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "state-reset" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 3 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 2 },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "x.txt", "count": 0 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_wipe_state", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 2 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "x.txt", "count": 0 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-024: a file deleted on the drive while this device was logged out is kept at the next login, listed, and not sent back up until the user sends it again",
    "description": "FILEN-024 (Filen): logout/login lost the pairs and re-uploaded everything. Rule D5: no login path removes a file; at a fresh pairing a file the drive deleted meanwhile is kept and listed and not sent again. sync-chaos delete-relogin-tombstone-kept.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "old-plan.txt", "text": "the old plan" },
      { "op": "drive_write", "device": "a", "path": "current.txt", "text": "current" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_unpair", "device": "a" },
      { "op": "drive_rm", "device": "b", "path": "old-plan.txt" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "old-plan.txt", "text": "the old plan" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "deleted-elsewhere-kept", "key": "old-plan.txt" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "old-plan.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "a", "path": "current.txt", "text": "current" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_send_again", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "old-plan.txt", "text": "the old plan" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "old-plan.txt", "text": "the old plan" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-024: an interrupted first upload resumes where it stopped: nothing sent twice, everything arrives",
    "description": "FILEN-024 (Filen): an interrupted first upload hung on 'processing deltas' for hours and restarted from scratch. Rules E8, E5, A7.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "first", "count": 60, "size": 20000, "seed": 11 },
      { "op": "drive_sync", "device": "a", "crash_at": "after-blob", "expect": "crash" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "first/*", "count": 60 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 60 },
      { "op": "drive_check", "check": "no_temp_files", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-024: an upgrade across a state format change keeps every pairing and sends nothing again",
    "description": "FILEN-024 (Filen): v2 to v3 used a new state format and every pair vanished; a mode change dropped all pairs. Rules D5, A1. sync-chaos state-upgrade-migration (pending there too).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "lib", "count": 50, "size": 2000, "seed": 3 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_state_format", "device": "a", "version": "previous" },
