      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "ok.txt", "text": "plain" },
      { "op": "drive_symlink", "device": "a", "path": "linked", "target": "{outside}/victim" },
      { "op": "drive_symlink", "device": "a", "path": "key.txt", "target": "{outside}/secret.txt" },
      { "op": "drive_symlink", "device": "a", "path": "loop", "target": "." },
      { "op": "drive_symlink", "device": "a", "path": "up", "target": ".." },
      { "op": "drive_sync", "device": "a", "timeout_ms": 20000 },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "symlink-skipped", "key": "linked" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "symlink-skipped", "key": "key.txt" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "symlink-skipped", "key": "loop" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "symlink-skipped", "key": "up" },
      { "op": "drive_check", "check": "remote_never_has" },
      { "op": "drive_check", "check": "remote_count", "count": 1 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "linked", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "ok.txt", "text": "plain" },
      { "op": "drive_check", "check": "outside_untouched" },
      { "op": "drive_cleanup" }
    ]
  },
