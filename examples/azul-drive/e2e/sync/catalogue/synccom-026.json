[
  {
    "name": "links to outside folders and link loops in the root are listed and never followed; the pass ends at once",
    "description": "SYNCCOM-026 (Sync.com): symlinks/aliases/junctions unsupported, 'circular path' errors, linked folders synced every 20 minutes. Rules S1/S2/O1 (sync-chaos sec-symlink-out-file, sec-write-through-local-link): one policy, links inert and listed, a loop ends the scan.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
