{
  "name": "'free up space' on a new folder drops only files the drive holds now, never those of an old folder whose cloud copy is gone",
  "description": "KDRIVE-017 (kDrive): accepting 'free up local space' for a new backup folder also deleted the local files of a disconnected folder that no longer had any cloud copy; Android's trash was bypassed. Rules P13, D2 and D5: bytes are dropped only for files whose drive copy is confirmed now with a matching hash; a file the drive no longer holds is refused, never deleted; an unpaired folder is never touched.",
  "steps": [
    { "op": "drive_create", "remote": "r" },
    { "op": "drive_create", "remote": "r2" },
    { "op": "drive_open", "device": "cam", "remote": "r" },
    { "op": "drive_open", "device": "media", "remote": "r2" },
    { "op": "drive_pair", "device": "cam", "folder": "{run}/phone/Camera" },
    { "op": "drive_wait_idle" },
    { "op": "drive_many", "device": "cam", "dir": ".", "count": 10, "size": 50000, "seed": 171 },
    { "op": "drive_sync", "device": "cam" },
    { "op": "drive_unpair", "device": "cam" },
    { "op": "drive_tamper", "remote": "r", "action": "delete_all" },
    { "op": "drive_pair", "device": "media", "folder": "{run}/phone/Media 2019-" },
    { "op": "drive_wait_idle" },
    { "op": "drive_many", "device": "media", "dir": ".", "count": 10, "size": 50000, "seed": 172 },
    { "op": "drive_sync", "device": "media" },
    { "op": "drive_evict", "device": "media", "glob": "*" },
    { "op": "assert_response", "path": "result.evicted", "len": 10 },
    { "op": "drive_read", "path": "{run}/phone/Camera/d000/f000000.txt" },
    { "op": "assert_response", "path": "result.exists", "equals": true },
    { "op": "assert_response", "path": "result.size", "equals": 50000 },
    { "op": "drive_pair", "device": "cam", "folder": "{run}/phone/Camera" },
    { "op": "drive_wait_idle" },
    { "op": "drive_evict", "device": "cam", "glob": "*" },
    { "op": "assert_response", "path": "result.evicted", "len": 0 },
    { "op": "assert_response", "path": "result.refused", "len": 10 },
    { "op": "drive_check", "check": "files_count", "device": "cam", "count": 10 },
    { "op": "drive_check", "check": "problem", "device": "cam", "code": "mass-delete-held" },
    { "op": "drive_check", "check": "trash_empty", "device": "cam" },
    { "op": "drive_cleanup" }
  ]
}
