[
  {
    "name": "a file named X on one device and a folder named X on the other: both kept, both devices list type-conflict, no pass fails or loops",
    "description": "KOOFR-021 (Koofr): a file and a folder of the same name on the two sides made every sync fail with a bare HTTP 400, no cause, no way forward. Rules C1 (never overwrite) and O1 (a named per-file problem): both are kept, each device lists type-conflict for the other side's entry, and later passes are quiet. sync-chaos merge-file-vs-folder.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "X", "text": "a file named X" },
      { "op": "drive_write", "device": "b", "path": "X/inner.txt", "text": "a folder named X" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "kept_live", "texts": ["a file named X", "a folder named X"] },
      { "op": "drive_check", "check": "file", "device": "a", "path": "X", "text": "a file named X" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "X/inner.txt", "text": "a folder named X" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "type-conflict", "key": "X/inner.txt" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "type-conflict", "key": "X" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_status", "device": "a" },
      { "op": "assert_response", "path": "result.status", "not_contains": "azdrive-sync-status-failed" },
      { "op": "drive_status", "device": "b" },
      { "op": "assert_response", "path": "result.status", "not_contains": "azdrive-sync-status-failed" },
      { "op": "drive_cleanup" }
    ]
  },
