[
  {
    "name": "objects rotted or gone on the server: a new device never gets wrong bytes and lists each file; the devices that hold the good copy keep it",
    "description": "JOTTA-001 (Jottacloud): files listed with the right size were unreadable (lost on retired disks); 80 lost, noticed only on read. Rules S15 (bytes that do not match the hash and short bodies are refused, the old version stays), O1 (named per file) and D6 (an unreadable remote entry deletes nothing). sync-chaos srv-corrupt-shard-healed (the server's scrub is the dc part).",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "archive/a.bin", "text": "archive a" },
      { "op": "drive_write", "device": "a", "path": "archive/b.bin", "text": "archive b" },
      { "op": "drive_write", "device": "a", "path": "archive/c.bin", "text": "archive c" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "corrupt_blob", "key": "archive/a.bin" },
      { "op": "drive_tamper", "remote": "r", "action": "truncate_blob", "key": "archive/b.bin", "keep": 0 },
      { "op": "drive_open", "device": "c", "remote": "r" },
      { "op": "drive_pair", "device": "c" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "c", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "c", "code": "hash-mismatch", "key": "archive/a.bin" },
      { "op": "drive_check", "check": "problem", "device": "c", "code_any": ["hash-mismatch", "remote-entry-unreadable"], "key": "archive/b.bin" },
      { "op": "drive_check", "check": "file", "device": "c", "path": "archive/a.bin", "absent": true },
      { "op": "drive_check", "check": "file", "device": "c", "path": "archive/b.bin", "absent": true },
      { "op": "drive_check", "check": "file", "device": "c", "path": "archive/c.bin", "text": "archive c" },
      { "op": "drive_check", "check": "no_temp_files", "device": "c" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "archive/a.bin", "text": "archive a" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "archive/a.bin", "text": "archive a" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "archive/b.bin", "text": "archive b" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a periodic read-back finds the rotted objects before anyone reads them and heals them from a device's good copy",
    "description": "JOTTA-001 (Jottacloud): the loss was only found when rclone failed to read the files, a month too late. Rule V5/S15 (BLAKE3 on every read; a damaged object is flagged to its owner, and healed): a verify pass on a device that still has the bytes lists the damage and puts them back.",
    "pending": "drive_verify {\"device\": \"a\"}: a verify pass that reads back every stored object of the pairing against its hash and lists (then re-uploads from the intact local copy) each damaged one",
    "expect": "fail",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "archive/a.bin", "text": "archive a" },
      { "op": "drive_write", "device": "a", "path": "archive/b.bin", "text": "archive b" },
      { "op": "drive_write", "device": "a", "path": "archive/c.bin", "text": "archive c" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "corrupt_blob", "key": "archive/a.bin" },
      { "op": "drive_tamper", "remote": "r", "action": "truncate_blob", "key": "archive/b.bin", "keep": 0 },
      { "op": "drive_verify", "device": "a" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "hash-mismatch", "key": "archive/a.bin" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "archive/a.bin", "text": "archive a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "archive/b.bin", "text": "archive b" },
      { "op": "drive_check", "check": "remote_consistent" },
      { "op": "drive_cleanup" }
    ]
  }
]
