[
  {
    "name": "a malicious server truncates, reorders and splices an encrypted file's chunks: every case fails its integrity check, nothing is written",
    "description": "ICEDRIVE-020 (Icedrive): unauthenticated CBC and chunking let a malicious server truncate, reorder, remove and splice chunks and move files between names (Hofmann & Truong, CCS 2024). Rules M2, S15 and I1: every chunk is AEAD-sealed and bound to its file and position; a tampered object fails, the file is listed (hash-mismatch), the old version stays, no temp file. sync-chaos crypto-malicious-server.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "secret/plan.pdf", "size": 3000000, "seed": 81 },
      { "op": "drive_write", "device": "a", "path": "secret/other.pdf", "size": 3000000, "seed": 82 },
      { "op": "drive_write", "device": "a", "path": "secret/name.txt", "text": "bound to its name" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "secret/plan.pdf", "size": 3000000, "seed": 83 },
      { "op": "drive_write", "device": "a", "path": "secret/other.pdf", "size": 3000000, "seed": 84 },
      { "op": "drive_write", "device": "a", "path": "secret/name.txt", "text": "bound to its name, v2" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "truncate_object", "key": "secret/plan.pdf", "keep_chunks": 1 },
      { "op": "drive_tamper", "remote": "r", "action": "swap_chunks", "key": "secret/other.pdf", "first": 0, "second": 1 },
      { "op": "drive_tamper", "remote": "r", "action": "splice", "key": "secret/name.txt", "from_key": "secret/other.pdf" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "secret/plan.pdf" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "secret/other.pdf" },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["hash-mismatch", "remote-entry-unreadable"], "key": "secret/name.txt" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "secret/name.txt", "text": "bound to its name" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "secret/plan.pdf", "size": 3000000 },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "swap_names", "key": "secret/plan.pdf", "with": "secret/other.pdf" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["hash-mismatch", "remote-entry-unreadable"], "key": "secret/plan.pdf" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a plain drive refuses a damaged or short object by its hash",
    "description": "ICEDRIVE-020 (Icedrive), the unencrypted half: a server that changes or cuts stored bytes. Rules S15 and A5: the download fails its hash, nothing is written, the old version stays. sync-chaos sec-wrong-bytes, res-truncated-download.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "doc.txt", "text": "v1" },
      { "op": "drive_write", "device": "a", "path": "big.bin", "size": 500000, "seed": 85 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "doc.txt", "text": "v2, the genuine one" },
      { "op": "drive_write", "device": "a", "path": "big.bin", "size": 500000, "seed": 86 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "corrupt_blob", "key": "doc.txt" },
      { "op": "drive_tamper", "remote": "r", "action": "truncate_blob", "key": "big.bin", "keep": 65536 },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "doc.txt" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "big.bin" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "doc.txt", "text": "v1" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "big.bin", "size": 500000 },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "names and contents never reach the server in the clear",
    "description": "ICEDRIVE-020 (Icedrive): metadata was stored unencrypted. Rule I1: an encrypted drive's stored objects hold neither a file's bytes nor its name in plaintext.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "tax-return-{secret}.pdf", "text": "income {secret}" },
      { "op": "drive_write", "device": "a", "path": "notes/{secret}/plan.txt", "text": "the plan" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_never_has", "remote": "r" },
      { "op": "drive_check", "check": "remote_never_has", "remote": "r", "marker": "income" },
      { "op": "drive_check", "check": "remote_never_has", "remote": "r", "marker": "tax-return" },
      { "op": "drive_cleanup" }
    ]
  }
]
