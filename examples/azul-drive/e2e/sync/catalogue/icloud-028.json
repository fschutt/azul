[
  {
    "name": "every request fails with 503 and then 429 for many passes: nothing local is lost, Retry-After is kept, everything catches up",
    "description": "ICLOUD-028 (sync-chaos res-server-down-long): iCloud answered 503/500 for weeks, uploads stalled with no status, and app data was lost. Rules E6, E1 and D6: the outage is listed (never up to date), edits made meanwhile are kept, Retry-After is honoured, nothing is deleted or doubled, and all of it goes up after.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x v1" },
      { "op": "drive_write", "device": "a", "path": "y.txt", "text": "y" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_fault", "remote": "r", "error_rate": 1.0, "seed": 28 },
      { "op": "drive_write", "device": "a", "path": "new.txt", "text": "written during the outage" },
      { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x v2" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["transient", "remote-offline", "rate-limited"], "when": "last" },
      { "op": "drive_check", "check": "remote_file", "key": "new.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "x.txt", "text": "x v1" },
      { "op": "drive_fault", "remote": "r", "clear": true, "rate_limit_every": 1, "retry_after": 2 },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "retry_after_respected", "device": "a" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "rate-limited", "when": "last" },
      { "op": "drive_fault", "remote": "r", "clear": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "key": "new.txt", "text": "written during the outage" },
      { "op": "drive_check", "check": "remote_file", "key": "x.txt", "text": "x v2" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "x.txt", "text": "x v2" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "new.txt", "text": "written during the outage" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "x.txt", "count": 0 },
      { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["transient", "remote-offline", "rate-limited"], "absent": true, "when": "last" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "after an outage the server has silently lost a folder: the devices notice, keep their copies and delete nothing",
    "description": "ICLOUD-028 (b): after a maintenance the user had lost a folder in iCloud Drive, without notice. Rules S15, M2 and D6: an index older than the last one seen is refused (remote-rollback); every device keeps its files and its trash stays empty.",
    "steps": [
      { "op": "drive_create", "remote": "r2", "encrypted": false },
      { "op": "drive_open", "device": "c", "remote": "r2" },
      { "op": "drive_open", "device": "d", "remote": "r2" },
      { "op": "drive_pair", "device": "c" },
      { "op": "drive_pair", "device": "d" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "c", "path": "keep/a.txt", "text": "before" },
      { "op": "drive_sync", "device": "c" },
      { "op": "drive_snapshot", "remote": "r2", "name": "before-folder" },
      { "op": "drive_write", "device": "c", "path": "Folder/1.txt", "text": "one" },
      { "op": "drive_write", "device": "c", "path": "Folder/2.txt", "text": "two" },
      { "op": "drive_write", "device": "c", "path": "Folder/3.txt", "text": "three" },
      { "op": "drive_sync", "device": "c" },
      { "op": "drive_sync", "device": "d" },
      { "op": "drive_tamper", "remote": "r2", "action": "rollback", "to": "before-folder" },
      { "op": "drive_sync", "device": "c", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "c", "code": "remote-rollback" },
      { "op": "drive_check", "check": "files_count", "device": "c", "glob": "Folder/*", "count": 3 },
      { "op": "drive_check", "check": "trash_empty", "device": "c" },
      { "op": "drive_sync", "device": "d", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "d", "code": "remote-rollback" },
      { "op": "drive_check", "check": "files_count", "device": "d", "glob": "Folder/*", "count": 3 },
      { "op": "drive_check", "check": "trash_empty", "device": "d" },
      { "op": "drive_cleanup" }
    ]
  }
]
