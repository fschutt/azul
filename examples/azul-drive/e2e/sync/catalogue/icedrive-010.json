[
  {
    "name": "3,000 photos and a video to an encrypted drive over a failing link with a sleep mid-upload: every file arrives byte for byte",
    "description": "ICEDRIVE-010 (Icedrive): 29,622 files uploaded to the encrypted area in one go on a fast link; some arrived corrupted and nothing could tell which (no checksum). Rules E5, A7, I1 and M2: blobs first, then the index by compare-and-swap, every byte checked against its plaintext hash, so a cut or a sleep mid-upload never commits a partial file; the other device ends with exactly the same bytes and a pass after that sends nothing. sync-chaos res-many-small-files-20k, port-local-bitrot.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "photos", "count": 3000, "size": 2048, "seed": 21 },
      { "op": "drive_write", "device": "a", "path": "videos/holiday.mov", "size": 8000000, "seed": 22 },
      { "op": "drive_sync", "device": "a", "pause_at": "after-blob", "timeout_ms": 600000 },
      { "op": "drive_clock", "device": "a", "jump": 7200 },
      { "op": "drive_fault", "device": "a", "partition": true },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a", "expect": "any", "timeout_ms": 600000 },
      { "op": "drive_fault", "device": "a", "clear": true, "error_rate": 0.2, "seed": 7 },
      { "op": "drive_sync", "device": "a", "expect": "any", "timeout_ms": 600000 },
      { "op": "drive_sync", "device": "a", "expect": "any", "timeout_ms": 600000 },
      { "op": "drive_sync", "device": "a", "expect": "any", "timeout_ms": 600000 },
      { "op": "drive_fault", "device": "a", "clear": true },
      { "op": "drive_sync", "device": "a", "timeout_ms": 600000 },
      { "op": "drive_sync", "device": "b", "timeout_ms": 600000 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 3001 },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "photos/*", "count": 3000 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "videos/holiday.mov", "same_as": "{root:a}/videos/holiday.mov" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "photos/d005/f002999.txt", "same_as": "{root:a}/photos/d005/f002999.txt" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_check", "check": "no_temp_files", "device": "a" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_sync", "device": "a", "timeout_ms": 600000 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_problems", "device": "b" },
      { "op": "assert_response", "path": "result.problems", "len": 0 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "one stored file damaged among many: the device names exactly that file and keeps its good copy",
    "description": "ICEDRIVE-010 (Icedrive): there was no way to tell which uploaded files were corrupt. Rules S15, A5 and O1: every download is checked against the file's hash; a damaged object is listed per file (hash-mismatch) while every other file arrives, and the local copy is never replaced by bad bytes.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "photos", "count": 200, "size": 4096, "seed": 31 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "photos/d000/f000007.txt", "size": 4096, "seed": 900 },
      { "op": "drive_write", "device": "a", "path": "photos/d000/f000008.txt", "size": 4096, "seed": 901 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "corrupt_blob", "key": "photos/d000/f000007.txt" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "photos/d000/f000007.txt" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "photos/d000/f000008.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "photos/d000/f000008.txt", "same_as": "{root:a}/photos/d000/f000008.txt" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "photos/d000/f000007.txt", "size": 4096 },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "photos/*", "count": 200 },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
