      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "shared/file10.txt", "text": "shared file 10", "writer": "rclone" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "shared/sub/file11.txt", "text": "shared file 11", "writer": "cli" },
