  {
    "name": "unpairing and pairing again leaves excluded, never-uploaded folders in place",
    "description": "ICLOUD-016 (sync-chaos delete-unpair-keeps-files, port-selective-sync): turning iCloud Drive off and on deleted local-only .nosync folders inside Documents. Rules D5 and P11: logout/unpair and a new pairing never remove a file, an excluded one least of all.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": ".azsyncignore", "text": "*.nosync/\n" },
      { "op": "drive_write", "device": "a", "path": "Documents/a.txt", "text": "synced a" },
      { "op": "drive_write", "device": "a", "path": "Documents/local.nosync/notes.txt", "text": "local-only notes" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_unpair", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "Documents/local.nosync/notes.txt", "text": "local-only notes" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "Documents/local.nosync/notes.txt", "text": "local-only notes" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "Documents/a.txt", "text": "synced a" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "remote_never_has", "marker": "local-only notes" },
      { "op": "drive_cleanup" }
    ]
