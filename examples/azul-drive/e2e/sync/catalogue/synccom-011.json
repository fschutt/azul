[
  {
    "name": "SYNCCOM-011: the synced folder moved away and the pairing pointed at its new place: recognised by its marker, nothing sent again or deleted",
    "description": "SYNCCOM-011 (Sync.com): re-index loops after sleep or reconnecting the USB drive. Rules D3 (the root's identity is its marker, a missing root changes nothing), D5. sync-chaos delete-root-moved.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "music", "count": 5, "text_prefix": "song" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_move_root", "device": "a" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "root-missing", "when": "last" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 5 },
      { "op": "drive_unpair", "device": "a" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 5 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 5 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "SYNCCOM-011: after a sleep (the app restarted) one rescan, nothing uploaded again",
    "description": "SYNCCOM-011 (Sync.com): re-index loops after sleep. Rules E2 (a full rescan follows the wake), A1 (unchanged files are known by their cache key).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "docs", "count": 40, "size": 4000, "seed": 6 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "SYNCCOM-011: the root's disk ejected and plugged in again (a new device id): the same folder is recognised, nothing sent again or deleted",
    "description": "SYNCCOM-011 (Sync.com): an external USB drive reconnected (new device id and inode numbers) re-indexed in a loop. Rules D3 (a root plugged in again is recognised by its marker), A1, P14. sync-chaos delete-root-remounted.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_volume", "device": "a", "fs": "apfs:16m" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "docs", "count": 8, "text_prefix": "doc" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_detach", "device": "a" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["root-missing", "root-replaced"], "when": "last" },
      { "op": "drive_attach", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "root-replaced", "absent": true, "when": "last" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 8 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  }
]
