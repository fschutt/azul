{
  "name": "SYNCCOM-003: a folder excluded (its local copy dropped), the client restarted, the folder included again: it comes down, nothing is deleted on the drive",
  "description": "SYNCCOM-003 (Sync.com): re-enabling a folder excluded by Selective Sync took the files missing locally for user deletions and deleted them in the cloud. Rules P11 (excluding or including again deletes nothing), S16, D6. sync-chaos port-selective-sync (the engine's ignore file is .azcloudignore).",
  "steps": [
    { "op": "drive_create", "remote": "r" },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_many", "device": "a", "dir": "F", "count": 6, "text_prefix": "f" },
    { "op": "drive_write", "device": "a", "path": "top.txt", "text": "top" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_write", "device": "b", "path": ".azcloudignore", "text": "F/\n" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_rmtree", "device": "b", "path": "F" },
    { "op": "drive_restart", "device": "b" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "F/*", "count": 6 },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "files_count", "device": "a", "glob": "F/*", "count": 6 },
    { "op": "drive_write", "device": "b", "path": ".azcloudignore", "text": "# F is included again\n" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "files_count", "device": "b", "glob": "F/*", "count": 6 },
    { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "F/*", "count": 6 },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "files_count", "device": "a", "glob": "F/*", "count": 6 },
    { "op": "drive_check", "check": "trash_empty", "device": "a" },
    { "op": "drive_check", "check": "trash_empty", "device": "b" },
    { "op": "custom_op", "name": "drive_check", "args": {"check": "max_ops", "device": "b", "op": "trash", "max": 0} },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_cleanup" }
  ]
}
