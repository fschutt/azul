{
  "name": "2,000 files in a deep tree copied into an encrypted drive, the pass cut twice: every file ends up readable on the other device, and the status is never 'up to date' while files wait",
  "description": "MAGENTA-003 (MagentaCLOUD Windows client, end-to-end-encrypted folder): encryption of a large deep tree stopped without an error, files stayed pending while the tray said 'sync complete', and a phantom subfolder appeared. Rules O1, E8 and A4: 'up to date' means nothing is pending; a crash at any point converges in the next pass with nothing lost or doubled. sync-chaos crypto-malicious-server, res-kill9-random.",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": true },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_many", "device": "a", "dir": "import/2019/raw", "count": 250, "size": 300, "seed": 1 },
    { "op": "drive_many", "device": "a", "dir": "import/2019/edit", "count": 250, "size": 300, "seed": 2 },
    { "op": "drive_many", "device": "a", "dir": "import/2020/raw", "count": 250, "size": 300, "seed": 3 },
    { "op": "drive_many", "device": "a", "dir": "import/2020/edit/final", "count": 250, "size": 300, "seed": 4 },
    { "op": "drive_many", "device": "a", "dir": "import/2021/a/b/c", "count": 250, "size": 300, "seed": 5 },
    { "op": "drive_many", "device": "a", "dir": "import/2021/a/b/d", "count": 250, "size": 300, "seed": 6 },
    { "op": "drive_many", "device": "a", "dir": "import/2022/x/y/z/w", "count": 250, "size": 300, "seed": 7 },
    { "op": "drive_many", "device": "a", "dir": "import/2023", "count": 250, "size": 300, "seed": 8 },
    { "op": "drive_sync", "device": "a", "crash_at": "after-blob", "expect": "crash", "timeout_ms": 600000 },
    { "op": "drive_status", "device": "a" },
    { "op": "assert_response", "path": "result.status", "not_contains": "up-to-date" },
    { "op": "drive_sync", "device": "a", "crash_at": "after-commit", "expect": "crash", "timeout_ms": 600000 },
    { "op": "drive_sync", "device": "a", "timeout_ms": 600000 },
    { "op": "drive_status", "device": "a" },
    { "op": "assert_response", "path": "result.status", "contains": "up-to-date" },
    { "op": "drive_sync", "device": "b", "timeout_ms": 600000 },
    { "op": "drive_check", "check": "files_count", "device": "b", "count": 2000 },
    { "op": "drive_check", "check": "remote_count", "count": 2000 },
    { "op": "drive_check", "check": "remote_consistent" },
    { "op": "drive_check", "check": "no_temp_files", "device": "a" },
    { "op": "drive_check", "check": "no_temp_files", "device": "b" },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_cleanup" }
  ]
}
