[
  {
    "name": "a file and a folder moved on one device arrive as moves on the other: nothing sent again, nothing in any trash",
    "description": "MBOX-011 (OX App Suite behind mailbox.org Drive): server-side moves fired no events, so clients never synced them; edits in external storage stopped sync. Rule A3: a delete and a new file with the same bytes is a move on both sides; folder renames compose by folder identity. sync-chaos merge-rename-folder-is-move.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "inbox/report.pdf", "text": "quarterly report" },
      { "op": "drive_write", "device": "a", "path": "inbox/other.txt", "text": "stays in the inbox" },
      { "op": "drive_write", "device": "a", "path": "projects/alpha/plan.txt", "text": "plan" },
      { "op": "drive_write", "device": "a", "path": "projects/alpha/notes.txt", "text": "notes" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_mkdir", "device": "a", "path": "archive" },
      { "op": "drive_rename", "device": "a", "from": "inbox/report.pdf", "to": "archive/report.pdf" },
      { "op": "drive_rename", "device": "a", "from": "projects/alpha", "to": "projects/beta" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "archive/report.pdf", "text": "quarterly report" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "inbox/report.pdf", "absent": true },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "projects/beta/*", "count": 2 },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "projects/alpha/*", "count": 0 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "trash", "check": "max_ops", "device": "b", "max": 0 },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held", "absent": true },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "names with dashes, full-width digits and CJK go up and come down byte for byte",
    "description": "MBOX-011: a dash broke the server's full-text tokenizer and full-width digits came back replaced. Rules P2 and P4: the original bytes of a name are kept; such names are valid everywhere and never renamed.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "2026-10-24-minutes.txt", "text": "dashes" },
      { "op": "drive_write", "device": "a", "path": "report-\uff10\uff11\uff12.txt", "text": "full-width digits" },
      { "op": "drive_write", "device": "a", "path": "\u65e5\u672c\u8a9e-\u8b70\u4e8b\u9332.txt", "text": "japanese" },
      { "op": "drive_write", "device": "a", "path": "\uff12\uff10\uff12\uff16\u5e74-\u8a08\u753b.md", "text": "full-width year" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "2026-10-24-minutes.txt", "text": "dashes" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "report-\uff10\uff11\uff12.txt", "text": "full-width digits" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "\u65e5\u672c\u8a9e-\u8b70\u4e8b\u9332.txt", "text": "japanese" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "\uff12\uff10\uff12\uff16\u5e74-\u8a08\u753b.md", "text": "full-width year" },
      { "op": "drive_check", "check": "remote_file", "key": "report-\uff10\uff11\uff12.txt", "text": "full-width digits" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "bad-remote-name", "absent": true },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "bad-name", "absent": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
