[
  {
    "name": "excluding a folder, a remote file under an excluded folder, and including it again: nothing is deleted on either side at any step",
    "description": "JOTTA-019 (Jottacloud): deletions and additions never reached the server, 'everything could be excluded', subfolders of excluded folders were uploaded. Rules P11 (ignored files never go up or come down), S16 (ignore changes are shown) and D6. sync-chaos port-selective-sync.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "build/\n" },
      { "op": "drive_write", "device": "a", "path": "keep/a.txt", "text": "kept" },
      { "op": "drive_write", "device": "a", "path": "build/out.bin", "text": "artifact" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "build/*", "count": 0 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "build/remote.bin", "text": "from a device without the rule" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "build/remote.bin", "absent": true },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "build/remote.bin" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "build/out.bin", "text": "artifact" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "# nothing excluded\n" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "keep/\n" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "build/out.bin", "text": "artifact" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "build/out.bin", "text": "artifact" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "keep/a.txt", "text": "kept" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "keep/a.txt", "text": "kept" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "keep/a.txt", "text": "kept" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "ignore-change" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "someone changes the shared ignore file to '*': the folder does not quietly stop syncing, the user is told",
    "description": "JOTTA-019 (Jottacloud): 'bug where everything could be excluded'. Rule S16 (files that stop syncing because someone changed the shared ignore file are listed). sync-chaos sec-ignore-file-hijack.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "b", "path": "notes/a.txt", "text": "a" },
      { "op": "drive_write", "device": "b", "path": "notes/b.txt", "text": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": ".azcloudignore", "text": "*\n", "writer": "mallory" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_write", "device": "b", "path": "notes/a.txt", "text": "an edit that no longer goes up" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "ignore-change" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "notes/a.txt", "text": "an edit that no longer goes up" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "notes/b.txt", "text": "b" },
      { "op": "drive_status", "device": "b" },
      { "op": "assert_response", "path": "result.status", "not_contains": "azdrive-sync-status-up-to-date" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a local delete and a new folder reach the drive and the other device in the next pass",
    "description": "JOTTA-019 (Jottacloud): 'file deletions were not noticed by realtime backup', additions missing for over a day. Rule A2 (the watcher is a hint; a pass's scan sees every change).",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "old.txt", "text": "to be deleted" },
      { "op": "drive_write", "device": "a", "path": "stay1.txt", "text": "stay 1" },
      { "op": "drive_write", "device": "a", "path": "stay2.txt", "text": "stay 2" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "a", "path": "old.txt" },
      { "op": "drive_mkdir", "device": "a", "path": "new" },
      { "op": "drive_write", "device": "a", "path": "new/fresh.txt", "text": "fresh" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 1 },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "old.txt", "absent": true },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "new/fresh.txt", "text": "fresh" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "old.txt", "absent": true },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "to be deleted" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "new/fresh.txt", "text": "fresh" },
      { "op": "drive_cleanup" }
    ]
  }
]
