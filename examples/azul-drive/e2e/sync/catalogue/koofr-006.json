{
  "name": "a folder renamed on one device while the other is idle: only the new name exists afterwards, no empty old folder comes back",
  "description": "KOOFR-006 (Koofr desktop on Windows before August 2019, two computers): the rename propagated, but the second client re-created an empty copy of the folder under the old name. Rules A3 and D1: a folder rename is a move by folder identity on both sides; empty folders are index entries, so the old one is gone everywhere. sync-chaos merge-rename-folder-is-move.",
  "pending": "empty folders are no index entries yet: the sync carries files only, so a folder with nothing in it is neither sent nor made on the other device (P7 needs folder entries)",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": true },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "Projects/plan.txt", "text": "plan" },
    { "op": "drive_write", "device": "a", "path": "Projects/notes.txt", "text": "notes" },
    { "op": "drive_mkdir", "device": "a", "path": "Projects/empty" },
    { "op": "drive_write", "device": "a", "path": "readme.txt", "text": "stays" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_rename", "device": "a", "from": "Projects", "to": "Work" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "remote_count", "glob": "Projects/*", "count": 0 },
    { "op": "drive_check", "check": "remote_count", "glob": "Work/*", "count": 2 },
    { "op": "drive_check", "check": "files_count", "device": "b", "glob": "Projects/*", "count": 0 },
    { "op": "drive_check", "check": "files_count", "device": "b", "glob": "Work/*", "count": 2 },
    { "op": "drive_read", "device": "b", "path": "Projects" },
    { "op": "assert_response", "path": "result.exists", "equals": false },
    { "op": "drive_read", "device": "a", "path": "Projects" },
    { "op": "assert_response", "path": "result.exists", "equals": false },
    { "op": "drive_read", "device": "b", "path": "Work/empty" },
    { "op": "assert_response", "path": "result.kind", "equals": "dir" },
    { "op": "drive_check", "check": "trash_empty", "device": "b" },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held", "absent": true },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_cleanup" }
  ]
}
