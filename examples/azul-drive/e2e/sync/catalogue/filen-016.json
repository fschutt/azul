{
  "name": "FILEN-016: a read-only file uploads; an unreadable file and an unreadable folder are listed and kept on the drive, and the rest still syncs",
  "description": "FILEN-016 (Filen): read-only files were silently skipped under 'Everything synced'; one unreadable directory made the CLI refuse to sync at all. Rules O1 (no silent skips), D6 (unreadable is unknown, never deleted). sync-chaos delete-unreadable-not-deleted.",
  "steps": [
    { "op": "drive_create", "remote": "r" },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "ro.txt", "text": "read only" },
    { "op": "drive_chmod", "device": "a", "path": "ro.txt", "mode": "444" },
    { "op": "drive_write", "device": "a", "path": "payroll.xlsx", "text": "salaries" },
    { "op": "drive_write", "device": "a", "path": "locked/inner.txt", "text": "inside" },
    { "op": "drive_write", "device": "a", "path": "rest.txt", "text": "rest" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "ro.txt", "text": "read only" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "ro.txt", "text": "read only" },
    { "op": "drive_chmod", "device": "a", "path": "payroll.xlsx", "mode": "000" },
    { "op": "drive_chmod", "device": "a", "path": "locked", "mode": "000" },
    { "op": "drive_write", "device": "a", "path": "new.txt", "text": "after" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "unreadable", "key": "payroll.xlsx" },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "unreadable", "key": "locked*" },
    { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "payroll.xlsx", "text": "salaries" },
    { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "locked/inner.txt", "text": "inside" },
    { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "new.txt", "text": "after" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "payroll.xlsx", "text": "salaries" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "locked/inner.txt", "text": "inside" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "new.txt", "text": "after" },
    { "op": "drive_check", "check": "trash_empty", "device": "b" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "unreadable", "key": "payroll.xlsx", "when": "last" },
    { "op": "drive_chmod", "device": "a", "path": "payroll.xlsx", "mode": "644" },
    { "op": "drive_chmod", "device": "a", "path": "locked", "mode": "755" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "unreadable", "absent": true, "when": "last" },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_cleanup" }
  ]
}
