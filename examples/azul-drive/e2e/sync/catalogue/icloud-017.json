{
  "name": "a git repository inside the root on two devices: .git never syncs, no conflict copy lands in it, the working files sync through temp-and-rename saves",
  "description": "ICLOUD-017 (sync-chaos port-git-repo): iCloud wrote 'refs/heads/main 2', 'index 2' and '.git 2' copies and git broke. Rules P11 and P10: .git/ is ignored, so concurrent commits on two devices never conflict inside it; a working file saved by temp + rename is one change, no conflict copy.",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "repo/.git/HEAD", "text": "ref: refs/heads/main" },
    { "op": "drive_write", "device": "a", "path": "repo/.git/index", "text": "index of a" },
    { "op": "drive_write", "device": "a", "path": "repo/.git/refs/heads/main", "text": "aaaa" },
    { "op": "drive_write", "device": "a", "path": "repo/src.c", "text": "int x;" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_write", "device": "b", "path": "repo/.git/HEAD", "text": "ref: refs/heads/main" },
    { "op": "drive_write", "device": "b", "path": "repo/.git/index", "text": "index of b" },
    { "op": "drive_write", "device": "b", "path": "repo/.git/refs/heads/main", "text": "bbbb" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_write", "device": "a", "path": "repo/.git/refs/heads/main.lock", "text": "cccc" },
    { "op": "drive_rename", "device": "a", "from": "repo/.git/refs/heads/main.lock", "to": "repo/.git/refs/heads/main" },
    { "op": "drive_write", "device": "b", "path": "repo/.git/refs/heads/main.lock", "text": "dddd" },
    { "op": "drive_rename", "device": "b", "from": "repo/.git/refs/heads/main.lock", "to": "repo/.git/refs/heads/main" },
    { "op": "drive_write", "device": "a", "path": "repo/.src.c.tmp", "text": "int x = 1;" },
    { "op": "drive_rename", "device": "a", "from": "repo/.src.c.tmp", "to": "repo/src.c" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "remote_count", "glob": "repo/.git/*", "count": 0 },
    { "op": "drive_check", "check": "file", "device": "a", "path": "repo/.git/index", "text": "index of a" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "repo/.git/index", "text": "index of b" },
    { "op": "drive_check", "check": "file", "device": "a", "path": "repo/.git/refs/heads/main", "text": "cccc" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "repo/.git/refs/heads/main", "text": "dddd" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "repo/src.c", "text": "int x = 1;" },
    { "op": "drive_check", "check": "files_count", "device": "a", "glob": "repo/.git/refs/heads/main *", "count": 0 },
    { "op": "drive_check", "check": "files_count", "device": "b", "glob": "repo/.git/index *", "count": 0 },
    { "op": "drive_check", "check": "files_count", "device": "a", "glob": "repo/.git 2*", "count": 0 },
    { "op": "drive_check", "check": "files_count", "device": "b", "glob": "repo/.git 2*", "count": 0 },
    { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "repo/src.c", "count": 0 },
    { "op": "drive_check", "check": "remote_count", "glob": "repo/.src.c.tmp", "count": 0 },
    { "op": "drive_cleanup" }
  ]
}
