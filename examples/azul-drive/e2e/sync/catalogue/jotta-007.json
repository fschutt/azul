[
  {
    "name": "40 of 50 files deleted at once: held until the user confirms; then they go to the drive's versions and the other device's trash",
    "description": "JOTTA-007 (Jottacloud): four releases fixed bugs that moved the whole sync folder to the trash or deleted local files that should stay. Rule D1 (a mass-delete breaker that cannot be bypassed) and D2/D7 (confirmed deletes are recoverable and logged). sync-chaos delete-mass-delete-held.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "photos", "count": 50, "text_prefix": "photo" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "a", "glob": "photos/d000/f00000*" },
      { "op": "drive_rm", "device": "a", "glob": "photos/d000/f00001*" },
      { "op": "drive_rm", "device": "a", "glob": "photos/d000/f00002*" },
      { "op": "drive_rm", "device": "a", "glob": "photos/d000/f00003*" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held" },
      { "op": "drive_status", "device": "a" },
      { "op": "assert_response", "path": "result.status", "contains": "azdrive-sync-status-mass-delete" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 50 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 50 },
      { "op": "drive_answer", "device": "a", "question": "mass_delete", "delete_too": true },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 10 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 10 },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "photo 0" },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "photo 39" },
      { "op": "drive_check", "check": "kept", "texts": ["photo 0", "photo 39"] },
      { "op": "drive_check", "check": "max_ops", "change": "trash", "device": "b", "max": 40 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "every file of a small folder (4 files) disappears at once: held like a mass delete, whatever the count",
    "description": "JOTTA-007 (Jottacloud). Rule D1: 'every file of a folder of at least 2' is held too. sync-chaos delete-small-folder-emptied.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "tax/2025.pdf", "text": "2025" },
      { "op": "drive_write", "device": "a", "path": "tax/2024.pdf", "text": "2024" },
      { "op": "drive_write", "device": "a", "path": "tax/2023.pdf", "text": "2023" },
      { "op": "drive_write", "device": "a", "path": "tax/receipts.zip", "text": "receipts" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rmtree", "device": "a", "path": "tax" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 4 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 4 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "the local index database emptied and the app restarted: nothing is deleted anywhere, nothing sent again",
    "description": "JOTTA-007 (Jottacloud), the catalogue's test: empty the local index DB and restart. Rules D5 (lost state never deletes) and D1.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "photos", "count": 50, "text_prefix": "photo" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_wipe_state", "device": "a" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.deleted", "equals": 0 },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.deleted", "equals": 0 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 50 },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 50 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 50 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_index", "remote": "r" },
      { "op": "assert_response", "path": "result.deleted", "len": 0 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "names in either Unicode form sync with no local delete on any pass",
    "description": "JOTTA-007 (Jottacloud): 'file encoding that could potentially lead to the file being deleted locally'. Rules P2 (names compared in NFC, original bytes kept) and D6 (no delete from a name the engine misread).",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "Pra\u0308sentation.docx", "text": "nfd name" },
      { "op": "drive_write", "device": "a", "path": "Übersicht.txt", "text": "nfc name" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Pra\u0308sentation.docx", "text": "nfd name" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Übersicht.txt", "text": "nfc name" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 2 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "max_ops", "change": "trash", "device": "a", "max": 0 },
      { "op": "drive_check", "check": "max_ops", "change": "trash", "device": "b", "max": 0 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  }
]
