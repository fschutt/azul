{
  "name": "files created, edited, deleted and moved while the app was not running are all taken at its next start",
  "description": "ICEDRIVE-002 (Icedrive): changes made while the app was closed were never picked up (v3 dropped the periodic rescan). Rules A2/E2 (sync-chaos res-changes-while-stopped): a full rescan at start; the watcher is only a hint.",
  "steps": [
    { "op": "drive_harness" },
    { "op": "drive_create", "remote": "r" },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x v1" },
    { "op": "drive_write", "device": "a", "path": "y.txt", "text": "y" },
    { "op": "drive_write", "device": "a", "path": "z.txt", "text": "z" },
    { "op": "drive_write", "device": "a", "path": "w.txt", "text": "w" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_write", "device": "a", "path": "new.txt", "text": "made while stopped" },
    { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x v2" },
    { "op": "drive_rm", "device": "a", "path": "y.txt" },
    { "op": "drive_mkdir", "device": "a", "path": "sub" },
    { "op": "drive_rename", "device": "a", "from": "z.txt", "to": "sub/z.txt" },
    { "op": "drive_restart", "device": "a" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "remote_file", "key": "new.txt", "text": "made while stopped" },
    { "op": "drive_check", "check": "remote_file", "key": "x.txt", "text": "x v2" },
    { "op": "drive_check", "check": "remote_file", "key": "y.txt", "absent": true },
    { "op": "drive_check", "check": "remote_file", "key": "sub/z.txt", "text": "z" },
    { "op": "drive_check", "check": "remote_file", "key": "z.txt", "absent": true },
    { "op": "drive_check", "check": "trash_has", "device": "b", "text": "y" },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_cleanup" }
  ]
}
