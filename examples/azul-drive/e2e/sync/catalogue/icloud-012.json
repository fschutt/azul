      { "op": "drive_check", "check": "link", "device": "d", "path": "docs-alias" },
      { "op": "drive_check", "check": "file", "device": "d", "path": "docs/planted.txt", "absent": true },
      { "op": "drive_check", "check": "problem", "device": "d", "code": "through-link", "key": "docs-alias/planted.txt" },
