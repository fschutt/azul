[
  {
    "name": "a link to ../../ or to the home folder in a shared folder is never followed and never sends anything",
    "description": "ICLOUD-012 (sync-chaos sec-remote-link-objects, local side): Files.app followed a shared 'contarct.pdf' -> ../../ and sent the victim's whole iCloud Drive. Rule S1: links are inert; with the default they are listed (symlink-skipped), never followed, nothing behind them goes up.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "shared/doc.txt", "text": "a real document" },
      { "op": "drive_symlink", "device": "a", "path": "shared/contarct.pdf", "target": "../../" },
      { "op": "drive_symlink", "device": "a", "path": "shared/escape.pdf", "target": "../../../../outside" },
      { "op": "drive_symlink", "device": "a", "path": "shared/abs.pdf", "target": "{outside}" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_never_has" },
      { "op": "drive_check", "check": "outside_untouched" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "symlink-skipped", "key": "shared/contarct.pdf" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "symlink-skipped", "key": "shared/escape.pdf" },
      { "op": "drive_check", "check": "remote_count", "glob": "shared/*", "count": 1 },
      { "op": "drive_check", "check": "link", "device": "b", "path": "shared/contarct.pdf", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "shared/doc.txt", "text": "a real document" },
      { "op": "drive_cleanup" }
    ]
  },
  {
