[
  {
    "name": "FILEN-002: deleting one subfolder deletes exactly that subtree on the drive, its siblings stay, and the next three cycles do nothing",
    "description": "FILEN-002 (Filen): deleting one subfolder of the pair made the client delete the whole synced cloud folder, then loop deleting and re-uploading. Rules D1 (a mass-delete breaker, a deleted subtree is only that subtree), D2 (deletes land in the other device's trash), D4 (no loop). sync-chaos delete-one-subfolder.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "work/alpha", "count": 5, "text_prefix": "alpha" },
      { "op": "drive_many", "device": "a", "dir": "work/beta", "count": 5, "text_prefix": "beta" },
      { "op": "drive_many", "device": "a", "dir": "work/gamma", "count": 5, "text_prefix": "gamma" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rmtree", "device": "a", "path": "work/beta" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "work/beta/*", "count": 0 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "work/alpha/*", "count": 5 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "work/gamma/*", "count": 5 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 10 },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 10 },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "beta 0" },
      { "op": "drive_check", "check": "kept", "texts": ["beta 0", "beta 4"] },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held", "absent": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 10 },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-002: a file deleted and restored over and over by another device is frozen after a few rounds and the user is asked",
    "description": "FILEN-002 (Filen): after the wrong delete, re-creating the sync looped forever deleting and re-uploading the same files. Rule D4: a file whose state returns to one it had within the hour three times is frozen and listed (loop-frozen); D7 logs every destructive step. sync-chaos delete-loop-detector.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "b", "path": "keep.txt", "text": "unrelated" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "flap.txt", "text": "flip-flop", "writer": "other-pc" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "flap.txt" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "flap.txt", "text": "flip-flop", "writer": "other-pc" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "flap.txt" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "flap.txt", "text": "flip-flop", "writer": "other-pc" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "flap.txt" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "flap.txt", "text": "flip-flop", "writer": "other-pc" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "flap.txt" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "flap.txt", "text": "flip-flop", "writer": "other-pc" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "flap.txt" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "flap.txt", "text": "flip-flop", "writer": "other-pc" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "flap.txt" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "loop-frozen", "key": "flap.txt" },
      { "op": "drive_check", "check": "max_ops", "device": "b", "key": "flap.txt", "max": 2 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "keep.txt", "text": "unrelated" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "keep.txt", "text": "unrelated" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-002: in a one-way (backup) pair, deleting one local subfolder never deletes anything on the drive",
    "description": "FILEN-002 (Filen): the trigger was a one-way local-to-cloud pair. Rules D1, D2: a backup pair keeps the drive's copies, every delete path goes through one policy. sync-chaos delete-backup-mode (pending: v1 ships two-way pairs only).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_pair", "device": "a", "mode": "backup" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "work/alpha", "count": 5, "text_prefix": "alpha" },
      { "op": "drive_many", "device": "a", "dir": "work/beta", "count": 5, "text_prefix": "beta" },
      { "op": "drive_many", "device": "a", "dir": "work/gamma", "count": 5, "text_prefix": "gamma" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_rmtree", "device": "a", "path": "work/beta" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "work/beta/*", "count": 5 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 15 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  }
]
