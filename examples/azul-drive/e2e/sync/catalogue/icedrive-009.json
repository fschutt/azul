[
  {
    "name": "a video still being written in place while it is read is not committed half-old; the final bytes go up whole",
    "description": "ICEDRIVE-009 (Icedrive): video and audio copied in through Explorer were stored corrupted for good, with no checksum and no retry. Rule A6 (upload of a file that holds still) and A5: a file that changes while it is read is not committed, it is listed as changed-during-sync and taken whole on the next pass; what the drive holds is byte for byte the final local file. sync-chaos placeholder-write-back (the mount itself is P13, later work).",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "videos/clip.mp4", "size": 3000000, "seed": 9 },
      { "op": "drive_sync", "device": "a", "pause_at": "mid-read" },
      { "op": "assert_response", "path": "result.outcome", "equals": "paused" },
      { "op": "drive_overwrite_in_place", "device": "a", "path": "videos/clip.mp4", "size": 3000000, "seed": 12 },
      { "op": "drive_append", "device": "a", "path": "videos/clip.mp4", "size": 65536, "seed": 13 },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "changed-during-sync", "key": "videos/clip.mp4", "when": "last" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "videos/clip.mp4", "absent": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 1 },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "videos/clip.mp4", "same_as": "{root:a}/videos/clip.mp4" },
      { "op": "drive_write", "device": "a", "path": "music/song.mp3", "size": 1200000, "seed": 10 },
      { "op": "drive_write", "device": "a", "path": "pics/photo.jpg", "size": 800000, "seed": 11 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "videos/clip.mp4", "same_as": "{root:a}/videos/clip.mp4" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "music/song.mp3", "same_as": "{root:a}/music/song.mp3" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "pics/photo.jpg", "same_as": "{root:a}/pics/photo.jpg" },
      { "op": "drive_check", "check": "remote_consistent", "remote": "r" },
      { "op": "drive_check", "check": "no_temp_files", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "Explorer-style I/O (the size set first, 64 KiB chunks written out of order) uploads the final bytes exactly",
    "description": "ICEDRIVE-009 (Icedrive), the catalogue's repro: out-of-order 64 KiB writes into a file extended sparsely with SetEndOfFile, then closed. Rule A6: the uploaded object's hash equals the final local content's hash, and a pass that meets the file half written commits nothing of it.",
    "pending": "drive_write_at {device, path, offset, content as drive_write} (writes the bytes at that offset, no truncation) and drive_truncate {device, path, size} (SetEndOfFile: a sparse extension or a cut)",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_truncate", "device": "a", "path": "videos/explorer.mp4", "size": 262144 },
      { "op": "drive_write_at", "device": "a", "path": "videos/explorer.mp4", "offset": 196608, "size": 65536, "seed": 4 },
      { "op": "drive_write_at", "device": "a", "path": "videos/explorer.mp4", "offset": 65536, "size": 65536, "seed": 2 },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_write_at", "device": "a", "path": "videos/explorer.mp4", "offset": 0, "size": 65536, "seed": 1 },
      { "op": "drive_write_at", "device": "a", "path": "videos/explorer.mp4", "offset": 131072, "size": 65536, "seed": 3 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "videos/explorer.mp4", "same_as": "{root:a}/videos/explorer.mp4" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "videos/explorer.mp4", "same_as": "{root:a}/videos/explorer.mp4" },
      { "op": "drive_check", "check": "remote_consistent", "remote": "r" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  }
]
