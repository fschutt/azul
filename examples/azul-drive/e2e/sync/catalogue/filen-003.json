[
  {
    "name": "FILEN-003: a new folder of 20 files made here while the other device works is uploaded, never deleted",
    "description": "FILEN-003 (Filen): a new local folder of about 20 files was deleted instead of uploaded in a two-way pair. Rules C2/E1 (new work always survives a merge), D6. sync-chaos res-soak-two-devices (reduced to the reported trigger).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "old.txt", "text": "old" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_many", "device": "a", "dir": "new-folder", "count": 20, "text_prefix": "original" },
      { "op": "drive_write", "device": "b", "path": "b-side.txt", "text": "made on b meanwhile" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "new-folder/*", "count": 20 },
      { "op": "drive_check", "check": "files_count", "device": "a", "glob": "new-folder/*", "count": 20 },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "new-folder/*", "count": 20 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "max_ops", "device": "a", "change": "trash", "max": 0 },
      { "op": "drive_check", "check": "kept_live", "texts": ["original 0", "original 19", "made on b meanwhile"] },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-003: files copied into the folder while an upload is in flight all go up; nothing vanishes from the drive",
    "description": "FILEN-003 (Filen): 10 GB copied into the sync folder during an upload made every file of the folder vanish from the cloud. Rules E8/A6 (a pass meeting new files mid-flight commits what it read and the next pass takes the rest), D6. sync-chaos res-soak-two-devices (the reported trigger, with a pause at mid-read).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "batch1", "count": 10, "size": 200000, "seed": 1 },
      { "op": "drive_sync_bg", "device": "a", "pause_at": "mid-read" },
      { "op": "drive_many", "device": "a", "dir": "batch2", "count": 15, "size": 50000, "seed": 100 },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "batch1/*", "count": 10 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "batch2/*", "count": 15 },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 25 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 25 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "max_ops", "device": "a", "change": "trash", "max": 0 },
      { "op": "drive_check", "check": "remote_consistent", "remote": "r" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-003: a stale device that comes online after the drive was emptied keeps its newer edit and never refills the drive with stale copies",
    "description": "FILEN-003 (Filen): a stale Linux device came online after the cloud had been emptied and refilled it with stale versions. Rules D1 (one confirmation carried in the tombstones, applied into the other device's trash), C2 (an edit beats a delete), E1. sync-chaos res-soak-two-devices (the reported trigger).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "docs", "count": 12, "text_prefix": "doc" },
      { "op": "drive_write", "device": "a", "path": "notes.txt", "text": "notes v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_fault", "device": "b", "partition": true },
      { "op": "drive_write", "device": "b", "path": "notes.txt", "text": "b's newer notes" },
      { "op": "drive_rm", "device": "a", "glob": "*" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 13 },
      { "op": "drive_answer", "device": "a", "question": "mass_delete", "delete_too": true },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 0 },
      { "op": "drive_fault", "device": "b", "clear": true },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "notes.txt", "text": "b's newer notes" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "notes.txt", "text": "b's newer notes" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "docs/*", "count": 0 },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "docs/*", "count": 0 },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "doc 0" },
      { "op": "drive_check", "check": "kept", "texts": ["doc 0", "doc 11", "notes v1"] },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-003: 200 random steps on two devices with restarts and offline periods: nothing that was ever synced disappears",
    "description": "FILEN-003 (Filen): mass deletes with no isolated trigger in two-way sync. Rules E8, E1, C1, D1. sync-chaos res-soak-two-devices.",
    "pending": "drive_soak {devices: [a, b], ops: 200, seed: 7, files: 10} (random edits, passes, crashes at random points, partitions of one device) and drive_check kept_soak (every version ever synced is in a folder, a trash or the drive's versions); both stay sync-chaos-only today",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_soak", "devices": ["a", "b"], "ops": 200, "seed": 7, "files": 10 },
      { "op": "drive_check", "check": "kept_soak" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "no_temp_files", "device": "a" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
