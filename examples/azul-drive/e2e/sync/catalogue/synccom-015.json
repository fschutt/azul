[
  {
    "name": "a change from another device right after this device's own upload reaches it (no echo suppression, no conflict)",
    "description": "SYNCCOM-015 (Sync.com): a web edit made shortly after a desktop upload never reached the desktop, which kept the stale version. Rules C1/C3 (sync-chaos merge-versions-no-false-conflict): a remote change is never taken for this device's own echo; repeated edits are no conflict. Here b writes v2 while a's pass is paused after its commit and before its base is saved (before a records its own upload).",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "v1 from a" },
      { "op": "drive_sync", "device": "a", "pause_at": "before-base-save" },
      { "op": "assert_response", "path": "result.outcome", "equals": "paused" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "report.txt", "text": "v1 from a" },
      { "op": "drive_write", "device": "b", "path": "report.txt", "text": "v2 from b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "report.txt", "text": "v2 from b" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "report.txt", "count": 0 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "report.txt", "count": 0 },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "conflict-held", "absent": true },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "an edit made on the drive (the web) seconds after this device's upload comes down",
    "description": "SYNCCOM-015 (Sync.com): the web panel's edit right after the desktop upload stayed off the desktop. Rules C1/C3: a newer remote version always comes down, no time window hides it.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "v1 from a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "report.txt", "text": "v2 from the web", "writer": "web" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.down", "equals": 1 },
      { "op": "drive_check", "check": "file", "device": "a", "path": "report.txt", "text": "v2 from the web" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "report.txt", "count": 0 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "five versions while the other device is off, then edits right after its own upload: no conflict copy, every version kept",
    "description": "SYNCCOM-015 via sync-chaos merge-versions-no-false-conflict. Rules C1, C3, D2: one device's repeated edits never conflict; the drive keeps the versions.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "v2" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "v3" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "v4" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "v5" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "b", "path": "report.txt", "text": "v6 from b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "b", "path": "report.txt", "text": "v7 from b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "report.txt", "text": "v7 from b" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "report.txt", "count": 0 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "report.txt", "count": 0 },
      { "op": "drive_check", "check": "kept", "texts": ["v1", "v2", "v3", "v4", "v5", "v6 from b"] },
      { "op": "drive_cleanup" }
    ]
  }
]
