      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "backups", "count": 30, "text_prefix": "zip" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "a", "path": "backups/d000/f000000.txt" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "glob": "backups/*", "count": 29 },
      { "op": "drive_rm", "device": "a", "path": "backups/d000/f000001.txt" },
      { "op": "drive_rm", "device": "a", "path": "backups/d000/f000002.txt" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "glob": "backups/*", "count": 27 },
      { "op": "drive_rm", "device": "a", "glob": "backups/d000/f00001*" },
      { "op": "drive_rm", "device": "a", "glob": "backups/d000/f00002*" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held" },
      { "op": "drive_check", "check": "remote_count", "glob": "backups/*", "count": 27 },
      { "op": "drive_answer", "device": "a", "question": "mass_delete", "delete_too": true },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_count", "glob": "backups/*", "count": 7 },
      { "op": "drive_check", "check": "kept", "texts": ["zip 0", "zip 1", "zip 2", "zip 10", "zip 29"] },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "zip 29" },
      { "op": "drive_cleanup" }
    ]
