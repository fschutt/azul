{
  "name": "one file the drive keeps refusing is retried and listed alone; deletes still go up, and unchanged files are never sent again",
  "description": "MAGENTA-005 (Synology Cloud Sync to MagentaCLOUD WebDAV): files already in the cloud were uploaded again and again against a stale server lock (423), and NAS deletes were not propagated. Rule E6: per-file retry with backoff, never a global stall; a file that keeps failing is listed every pass while the others go on; a hash match sends nothing. sync-chaos res-sleep-mid-commit.",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "locked.docx", "text": "v1 of the locked document" },
    { "op": "drive_write", "device": "a", "path": "other.txt", "text": "other v1" },
    { "op": "drive_write", "device": "a", "path": "gone.txt", "text": "to delete" },
    { "op": "drive_write", "device": "a", "path": "unchanged.txt", "text": "never sent again" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_fault", "device": "a", "fail_keys": ["*63398cb63e35880b39a1a034c2e331a3b87cec7472e8a4a5871b296b618e0951"] },
    { "op": "drive_write", "device": "a", "path": "locked.docx", "text": "v2 of the locked document" },
    { "op": "drive_write", "device": "a", "path": "other.txt", "text": "other v2" },
    { "op": "drive_rm", "device": "a", "path": "gone.txt" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["transient", "io-error", "other"], "key": "locked.docx" },
    { "op": "drive_check", "check": "remote_file", "key": "other.txt", "text": "other v2" },
    { "op": "drive_check", "check": "remote_file", "key": "gone.txt", "absent": true },
    { "op": "drive_check", "check": "remote_file", "key": "locked.docx", "text": "v1 of the locked document" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "assert_response", "path": "result.up", "equals": 0 },
    { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["transient", "io-error", "other"], "key": "locked.docx", "when": "last" },
    { "op": "drive_fault", "device": "a", "clear": true },
    { "op": "drive_sync", "device": "a" },
    { "op": "assert_response", "path": "result.up", "equals": 1 },
    { "op": "drive_check", "check": "remote_file", "key": "locked.docx", "text": "v2 of the locked document" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "gone.txt", "absent": true },
    { "op": "drive_check", "check": "trash_has", "device": "b", "text": "to delete" },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_cleanup" }
  ]
}
