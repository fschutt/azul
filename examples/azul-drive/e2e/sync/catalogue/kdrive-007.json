[
  {
    "name": "a Linux device's .Trash-1000 and lost+found never go up; names Windows cannot hold are listed once each, however many passes run",
    "description": "KDRIVE-007 (kDrive): a Linux client synced '.Trash-1000', 'lost+found' and Windows-illegal names, and a Windows client's error loop wrote thousands of error rows a minute until its database filled the disk. Rules P11, P3, P5 and O1: the systems' bookkeeping never goes up; names valid here but not on Windows sync and are listed (portability) as one entry per file, not one per attempt; the passes settle.",
    "only_on": ["macos", "linux"],
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": ".Trash-1000/files/old.txt", "text": "trashed on linux" },
      { "op": "drive_write", "device": "a", "path": "lost+found/#123", "text": "fsck" },
      { "op": "drive_write", "device": "a", "path": "Image:Name.jpg", "text": "colon" },
      { "op": "drive_write", "device": "a", "path": "trailing.", "text": "dot" },
      { "op": "drive_write", "device": "a", "path": "NUL", "text": "reserved" },
      { "op": "drive_write", "device": "a", "path": "fine.txt", "text": "fine" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": ".Trash-1000/*", "count": 0 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "lost+found/*", "count": 0 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 4 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "portability", "key": "Image:Name.jpg" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "portability", "key": "trailing." },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "portability", "key": "NUL" },
      { "op": "drive_problems", "device": "b" },
      { "op": "assert_response", "path": "result.problems", "len": 3 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 4 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "on Windows the same tree is listed invalid-here once per file over ten passes, and nothing else comes down",
    "description": "KDRIVE-007 (kDrive), the Windows side: rules P3, P5, P11 and O1: each name this system cannot hold stays on the drive and is listed once; the Linux trash folder put there by a careless client never comes down.",
    "only_on": ["windows"],
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": ".Trash-1000/files/old.txt", "text": "trashed on linux" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "Image:Name.jpg", "text": "colon" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "trailing.", "text": "dot" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "NUL", "text": "reserved" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "fine.txt", "text": "fine" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "invalid-here", "key": "Image:Name.jpg" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "invalid-here", "key": "trailing." },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "invalid-here", "key": "NUL" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 1 },
      { "op": "drive_check", "check": "file", "device": "b", "path": ".Trash-1000/files/old.txt", "absent": true },
      { "op": "drive_problems", "device": "b" },
      { "op": "assert_response", "path": "result.problems", "len": 3 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
