{
  "name": "the quota runs out half way: the files that fit go up, the others are listed and stay here, the other device never gets them half, and more room sends them",
  "description": "ICLOUD-022 (sync-chaos res-quota-exceeded, placeholder-evict-only-uploaded): iCloud showed files as uploaded that never reached other devices, and moved Documents into a full drive, losing what did not fit. Rules E4, O1 and P13: per file, listed (quota-exceeded), the local file untouched; the other device sees only committed files; nothing local is moved or removed.",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_fault", "remote": "r", "quota_bytes": 1000000 },
    { "op": "drive_write", "device": "a", "path": "q1.bin", "size": 400000, "seed": 1 },
    { "op": "drive_write", "device": "a", "path": "q2.bin", "size": 400000, "seed": 2 },
    { "op": "drive_write", "device": "a", "path": "q3.bin", "size": 400000, "seed": 3 },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_check", "check": "remote_count", "count": 2 },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "quota-exceeded", "when": "last" },
    { "op": "drive_check", "check": "files_count", "device": "a", "count": 3 },
    { "op": "drive_check", "check": "remote_consistent" },
    { "op": "drive_sync", "device": "b", "expect": "any" },
    { "op": "drive_check", "check": "files_count", "device": "b", "count": 2 },
    { "op": "drive_check", "check": "no_temp_files", "device": "b" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "quota-exceeded", "when": "last" },
    { "op": "drive_fault", "remote": "r", "clear": true },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "remote_count", "count": 3 },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "quota-exceeded", "absent": true, "when": "last" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "files_count", "device": "b", "count": 3 },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_check", "check": "trash_empty", "device": "a" },
    { "op": "drive_cleanup" }
  ]
}
