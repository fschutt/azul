      { "op": "drive_check", "check": "file", "device": "b", "path": "x.txt", "text": "x v1" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_check", "check": "nonces_unique", "remote": "r" },
      { "op": "drive_cleanup" }
    ]
