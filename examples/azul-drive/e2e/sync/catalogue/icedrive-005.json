[
  {
    "name": "an upload stopped mid-transfer leaves the local file untouched and no partial version on the drive; the next pass sends it whole",
    "description": "ICEDRIVE-005 (Icedrive): after cancelling a large upload the file was gone locally and only a partial copy existed in the cloud. Rules E5/A7/A5/E8 (sync-chaos res-crash-points, res-partition-mid-transfer): the stop is a crash at mid-read and at before-rename.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
