[
  {
    "name": "FILEN-019: a rename on one computer while the other is mid-pass: one name everywhere, the old one never comes back",
    "description": "FILEN-019 (Filen): renaming 'document' to 'document 2' on one computer made the other re-upload the old name, so both names existed everywhere. Rule A3 (a rename is a move of the same content, applied as one), C1. sync-chaos merge-rename-compose.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "document", "text": "the document" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "b", "path": "unrelated.txt", "text": "b is busy" },
      { "op": "drive_sync_bg", "device": "b", "pause_at": "after-scan" },
      { "op": "drive_rename", "device": "a", "from": "document", "to": "document 2" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_cont", "device": "b" },
      { "op": "drive_wait", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "document", "absent": true },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "document 2", "text": "the document" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "document", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "document 2", "text": "the document" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "document", "absent": true },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-019: a folder renamed on one side while the other moves a file into it: the file ends in the renamed folder, the old folder never comes back",
    "description": "FILEN-019 (Filen): items moved into a concurrently renamed directory duplicated and the old directory resurrected. Rules A3, C1. sync-chaos merge-rename-compose.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "dir/child.txt", "text": "child" },
      { "op": "drive_write", "device": "a", "path": "elsewhere.txt", "text": "moved in" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rename", "device": "a", "from": "dir", "to": "dir2" },
      { "op": "drive_rename", "device": "b", "from": "elsewhere.txt", "to": "dir/moved.txt" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "dir2/child.txt", "text": "child" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "dir2/moved.txt", "text": "moved in" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "dir2/moved.txt", "text": "moved in" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "dir", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "dir", "absent": true },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "dir/*", "count": 0 },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "elsewhere.txt", "absent": true },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-019: a parent renamed on one side and a child folder renamed on the other, with an edit inside: one item under the composed path",
    "description": "FILEN-019 (Filen): local /top -> /top2 while remote /top/mid -> /top/mid2 with a modified file left a permanent duplicate. Rules A3, C2. sync-chaos merge-rename-compose.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "top/mid/f.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rename", "device": "a", "from": "top", "to": "top2" },
      { "op": "drive_rename", "device": "b", "from": "top/mid", "to": "top/mid2" },
      { "op": "drive_write", "device": "b", "path": "top/mid2/f.txt", "text": "edited on b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "top2/mid2/f.txt", "text": "edited on b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "top2/mid2/f.txt", "text": "edited on b" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "top", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "top", "absent": true },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 1 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
