[
  {
    "name": "FILEN-004: a folder that cannot be read for one pass is unknown, never deleted; the next clean pass converges",
    "description": "FILEN-004 (Filen): a transient readdir failure on one directory silently omitted its subtree from the scan, so its cloud copies were trashed. Rule D6: an incomplete read is never a deletion; nothing below the folder is deleted until a complete read. O1 lists it. sync-chaos delete-unreadable-not-deleted (the folder form).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "photos", "count": 6, "text_prefix": "photo" },
      { "op": "drive_write", "device": "a", "path": "other.txt", "text": "other v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_chmod", "device": "a", "path": "photos", "mode": "000" },
      { "op": "drive_write", "device": "a", "path": "other.txt", "text": "other v2" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "unreadable", "key": "photos*" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "photos/*", "count": 6 },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "other.txt", "text": "other v2" },
      { "op": "drive_check", "check": "max_ops", "device": "a", "change": "trash", "max": 0 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "photos/*", "count": 6 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "other.txt", "text": "other v2" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_chmod", "device": "a", "path": "photos", "mode": "755" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "unreadable", "absent": true, "when": "last" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "photos/*", "count": 6 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-004: an I/O error (EIO) on one folder for one scan deletes nothing; the next clean scan converges",
    "description": "FILEN-004 (Filen): the trigger was a transient EIO/EACCES/ENOTDIR on SMB or removable media. Rule D6. chmod gives only EACCES; the EIO form needs a local fault.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "photos", "count": 6, "text_prefix": "photo" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_local_fault", "device": "a", "path": "photos", "readdir_error": "EIO", "passes": 1 },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "unreadable", "key": "photos*" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "photos/*", "count": 6 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "photos/*", "count": 6 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "unreadable", "absent": true, "when": "last" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
