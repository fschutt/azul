[
  {
    "name": "files with times in 2099, at 1970-01-01 and before their creation are uploaded once each, then every pass is quiet",
    "description": "KDRIVE-006 (kDrive): a local file with an invalid modification time (0, far in the future, earlier than its creation) was re-synced on every cycle. Rule P12: time is a hint, never the decision; times from 1970 to 2100 and in the future are accepted, a file is uploaded once and then left alone, its time travels to the other device. sync-chaos merge-clock-skew.",
    "pending": "an encrypted drive keeps no file's modification time: a drive synced by name has no way to send one (Drive::put takes none) and lists only the upload's second (ObjectInfo.modified), so the named sync sets mtime_ns 0 and a download gets the download time. It needs a time in the put calls, the pointer and the listing (P6/P12 on encrypted drives)",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "f1-future.txt", "text": "from 2099", "mtime": 4070908800000000000 },
      { "op": "drive_write", "device": "a", "path": "f2-epoch.txt", "text": "from 1970", "mtime": 0 },
      { "op": "drive_write", "device": "a", "path": "f3-before-birth.txt", "text": "touched back to 2001" },
      { "op": "drive_utime", "device": "a", "path": "f3-before-birth.txt", "mtime": 978307200000000000 },
      { "op": "drive_write", "device": "a", "path": "f4-normal.txt", "text": "now" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 4 },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.down", "equals": 4 },
      { "op": "drive_check", "check": "mtime", "device": "b", "path": "f1-future.txt", "ns": 4070908800000000000, "tolerance_ns": 2000000000 },
      { "op": "drive_check", "check": "mtime", "device": "b", "path": "f2-epoch.txt", "ns": 0, "tolerance_ns": 2000000000 },
      { "op": "drive_check", "check": "mtime", "device": "b", "path": "f3-before-birth.txt", "ns": 978307200000000000, "tolerance_ns": 2000000000 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a device whose clock runs a year ahead edits concurrently: the conflict is held and both kept, never 'the newer time wins'",
    "description": "KDRIVE-006 (kDrive): times far in the future. Rules C3 and P12: a clock a year off changes the conflict copy's date, never which version survives; the conflict is held, keep both keeps both, and the passes then settle. sync-chaos merge-clock-skew.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r", "clock": 31536000 },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "budget.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "budget.txt", "text": "a's real edit" },
      { "op": "drive_write", "device": "b", "path": "budget.txt", "text": "b's skewed edit", "mtime": 1924992000000000000 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.conflicts", "equals": 1 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "key": "budget.txt" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "budget.txt", "text": "b's skewed edit" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "budget.txt", "text": "a's real edit" },
      { "op": "drive_resolve", "device": "b", "key": "budget.txt", "choice": "both" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "kept_live", "texts": ["a's real edit", "b's skewed edit"] },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "budget.txt", "count": 1 },
      { "op": "drive_check", "check": "file", "device": "a", "path": "budget.txt", "text": "a's real edit" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  }
]
