{
  "name": "revoked credentials with 51 edits pending: 'sign in again', the edits and the pairing survive a restart, and exactly those edits go up after",
  "description": "MBOX-002 (mailbox.org OX Drive after the app-password change): the client stopped syncing and fell back to account setup after a restart. Rules E6, D5 and O1: revoked credentials say sign-in-needed, keep every pending edit, never reset the state, and after signing in upload exactly what was pending. sync-chaos res-credentials-revoked.",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": true },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "notes.txt", "text": "v1" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_write", "device": "a", "path": "notes.txt", "text": "v2, pending" },
    { "op": "drive_many", "device": "a", "dir": "edits", "count": 50, "text_prefix": "edit" },
    { "op": "drive_fault", "device": "a", "auth_failed": true },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "sign-in-needed", "when": "last" },
    { "op": "drive_status", "device": "a" },
    { "op": "assert_response", "path": "result.status", "not_contains": "up-to-date" },
    { "op": "drive_restart", "device": "a" },
    { "op": "drive_status", "device": "a" },
    { "op": "assert_response", "path": "result.paired", "equals": true },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "sign-in-needed", "when": "last" },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "state-reset", "absent": true },
    { "op": "drive_check", "check": "files_count", "device": "a", "glob": "edits/*", "count": 50 },
    { "op": "drive_check", "check": "file", "device": "a", "path": "notes.txt", "text": "v2, pending" },
    { "op": "drive_check", "check": "trash_empty", "device": "a" },
    { "op": "drive_fault", "device": "a", "clear": true },
    { "op": "drive_sync", "device": "a" },
    { "op": "assert_response", "path": "result.up", "equals": 51 },
    { "op": "drive_check", "check": "remote_count", "glob": "edits/*", "count": 50 },
    { "op": "drive_check", "check": "remote_file", "key": "notes.txt", "text": "v2, pending" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
    { "op": "drive_cleanup" }
  ]
}
