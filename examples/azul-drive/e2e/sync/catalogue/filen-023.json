[
  {
    "name": "FILEN-023: a folder that already holds files is paired with a drive that holds other files: a union, nothing deleted or overwritten",
    "description": "FILEN-023 (Filen): a local folder paired as a strict mirror with the drive's root deleted the entire cloud drive. Rule C4: a first sync of two non-empty sides is a union; same bytes agree, different bytes are kept twice (AzDrive holds the clash for the user), nothing is deleted, no mirror mode in v1. sync-chaos merge-first-sync-both-sides.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "a's report" },
      { "op": "drive_write", "device": "a", "path": "same.txt", "text": "identical" },
      { "op": "drive_write", "device": "a", "path": "only-a.txt", "text": "only on the drive" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "b", "path": "report.txt", "text": "b's report" },
      { "op": "drive_write", "device": "b", "path": "same.txt", "text": "identical" },
      { "op": "drive_write", "device": "b", "path": "only-b.txt", "text": "only on b" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "key": "report.txt" },
      { "op": "drive_resolve", "device": "b", "key": "report.txt", "choice": "both" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "kept_live", "texts": ["a's report", "b's report", "only on b", "only on the drive"] },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "report.txt", "count": 1 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "same.txt", "count": 0 },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "only-a.txt", "text": "only on the drive" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "only-a.txt", "text": "only on the drive" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-023: a side filled by the engine's own first download, then emptied, trips the mass-delete breaker",
    "description": "FILEN-023 (Filen): the large-deletion confirmation never fired because the base size was a stale 0 after the engine had filled that side, so both sides were deleted without a prompt. Rule D1: a breaker that cannot be bypassed.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "docs", "count": 12, "text_prefix": "doc" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 12 },
      { "op": "drive_rm", "device": "b", "glob": "docs/*" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "mass-delete-held" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "docs/*", "count": 12 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "files_count", "device": "a", "glob": "docs/*", "count": 12 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-023: 'delete all files' on the drive (the web app) is held on the device, nothing is re-uploaded behind the user's back, and a confirmation applies it into the trash",
    "description": "FILEN-023 (Filen): 'Delete all files and folders' in the web app with a two-way pair did not propagate and the desktop re-uploaded everything. Rules D1, D2 (applied deletes go to the trash). sync-chaos delete-remote-emptied.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "docs", "count": 12, "text_prefix": "doc" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "delete_all" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 12 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 0 },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 12 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 0 },
      { "op": "drive_answer", "device": "a", "question": "mass_delete", "delete_too": true },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 0 },
      { "op": "drive_check", "check": "trash_has", "device": "a", "text": "doc 0" },
      { "op": "drive_check", "check": "trash_has", "device": "a", "text": "doc 11" },
      { "op": "drive_cleanup" }
    ]
  }
]
