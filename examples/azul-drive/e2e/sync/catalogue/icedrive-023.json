[
  {
    "name": "pairs re-created over folders already in sync (and a lost state) transfer nothing again",
    "description": "ICEDRIVE-023 (Icedrive): after the 2.x to 3.x upgrade, re-created pairs re-uploaded files already in the cloud and re-downloaded others. Rules D5 and A1: a fresh pairing agrees with the drive by content hash: nothing goes up or down for unchanged files, no conflict copy, nothing deleted. sync-chaos delete-state-lost, state-upgrade-migration.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "archive", "count": 2000, "size": 512, "seed": 121 },
      { "op": "drive_write", "device": "a", "path": "big/movie.mp4", "size": 5000000, "seed": 122 },
      { "op": "drive_sync", "device": "a", "timeout_ms": 600000 },
      { "op": "drive_sync", "device": "b", "timeout_ms": 600000 },
      { "op": "drive_unpair", "device": "a" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle", "device": "a", "timeout_ms": 600000 },
      { "op": "drive_sync", "device": "a", "timeout_ms": 600000 },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "assert_response", "path": "result.conflicts", "equals": 0 },
      { "op": "drive_wipe_state", "device": "b" },
      { "op": "drive_restart", "device": "b" },
      { "op": "drive_sync", "device": "b", "timeout_ms": 600000 },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "assert_response", "path": "result.deleted", "equals": 0 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "state-reset" },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "big/movie.mp4", "count": 0 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 2001 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "an upgrade across a state format change migrates the base: the pass after it transfers nothing",
    "description": "ICEDRIVE-023 (Icedrive), the catalogue's repro: a client's state migrated across a major version with many synced files. Rules D5 and A1: the new version migrates the base (or rebuilds it by hash), keeps the pairing, and the pass after the upgrade sends and fetches nothing for unchanged files. sync-chaos state-upgrade-migration.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "archive", "count": 2000, "size": 512, "seed": 121 },
      { "op": "drive_sync", "device": "a", "timeout_ms": 600000 },
      { "op": "drive_sync", "device": "b", "timeout_ms": 600000 },
      { "op": "drive_state_format", "device": "b", "version": "previous" },
      { "op": "drive_restart", "device": "b" },
      { "op": "drive_sync", "device": "b", "timeout_ms": 600000 },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "assert_response", "path": "result.deleted", "equals": 0 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "state-reset", "absent": true },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 2000 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  }
]
