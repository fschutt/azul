[
  {
    "name": "a folder renamed on another device while this device is downloading it: every file ends under the new name, none deleted",
    "description": "JOTTA-014 (Jottacloud): 'a remote rename of a folder could cause the files in the folder to disappear'. Rules A3 (a rename is a move) and E2 (a frozen pass re-checks before it writes), D1 (a renamed folder is a move, not a delete). sync-chaos merge-rename-compose.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "A/1.txt", "text": "one" },
      { "op": "drive_write", "device": "a", "path": "A/2.txt", "text": "two" },
      { "op": "drive_write", "device": "a", "path": "A/3.txt", "text": "three" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b", "pause_at": "download-start" },
      { "op": "drive_rename", "device": "a", "from": "A", "to": "B" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_cont", "device": "b" },
      { "op": "drive_wait", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "B/1.txt", "text": "one" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "B/2.txt", "text": "two" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "B/3.txt", "text": "three" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "A", "absent": true },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 3 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a folder moved into the root from outside goes up in the next pass, without a restart",
    "description": "JOTTA-014 (Jottacloud): files moved into the sync folder were not uploaded until restart (3.1.49). Rule A2 (the watcher is a hint; the pass's scan finds every file).",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "{run}/import/moved.txt", "text": "moved in from outside" },
      { "op": "drive_write", "device": "a", "path": "{run}/import/sub/deep.txt", "text": "deep" },
      { "op": "drive_write", "device": "a", "path": "here.txt", "text": "here" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_rename", "device": "a", "from": "{run}/import", "to": "imported" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 2 },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "imported/moved.txt", "text": "moved in from outside" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "imported/sub/deep.txt", "text": "deep" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "imported/sub/deep.txt", "text": "deep" },
      { "op": "drive_check", "check": "outside_untouched" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "renames that compose: a parent renamed on one side and a child on the other, and a swap",
    "description": "JOTTA-014 (Jottacloud): moves between shared folders and 'sync move resilience' needed repeated fixes. Rules A3 and C1. sync-chaos merge-rename-compose.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "dir/child.txt", "text": "child" },
      { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x" },
      { "op": "drive_write", "device": "a", "path": "y.txt", "text": "y" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rename", "device": "a", "from": "dir", "to": "dir2" },
      { "op": "drive_rename", "device": "b", "from": "dir/child.txt", "to": "dir/child2.txt" },
      { "op": "drive_rename", "device": "a", "from": "x.txt", "to": "tmp.txt" },
      { "op": "drive_rename", "device": "a", "from": "y.txt", "to": "x.txt" },
      { "op": "drive_rename", "device": "a", "from": "tmp.txt", "to": "y.txt" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "dir2/child2.txt", "text": "child" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "dir2/child2.txt", "text": "child" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "dir", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "x.txt", "text": "y" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "y.txt", "text": "x" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
