[
  {
    "name": "a file that cannot be replaced here is listed and retried, the rest of the pass arrives; an unreadable local file is named as such, not as a network error",
    "description": "KOOFR-002 (Koofr desktop before June 2020): files held open by Office were not synced until closed, and a locked file surfaced as 'No internet connection'. Rules P9, E6 and O1: a file that cannot be written or read is retried and listed with its own code while the other files go on; it arrives one pass after it is free. sync-chaos port-locked-file, port-windows-ntfs.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "locked/open-in-excel.xlsx", "text": "v1" },
      { "op": "drive_write", "device": "a", "path": "other.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_chmod", "device": "b", "path": "locked", "mode": "555" },
      { "op": "drive_write", "device": "a", "path": "locked/open-in-excel.xlsx", "text": "v2" },
      { "op": "drive_write", "device": "a", "path": "other.txt", "text": "v2" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "other.txt", "text": "v2" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "locked/open-in-excel.xlsx", "text": "v1" },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["locked", "io-error", "busy"], "key": "locked/open-in-excel.xlsx" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "remote-offline", "absent": true },
      { "op": "drive_chmod", "device": "b", "path": "locked", "mode": "755" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "locked/open-in-excel.xlsx", "text": "v2" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "report.docx", "text": "can't read me yet" },
      { "op": "drive_chmod", "device": "a", "path": "report.docx", "mode": "000" },
      { "op": "drive_write", "device": "a", "path": "other.txt", "text": "v3" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["unreadable", "locked"], "key": "report.docx", "when": "last" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "remote-offline", "absent": true },
      { "op": "drive_check", "check": "remote_file", "key": "other.txt", "text": "v3" },
      { "op": "drive_chmod", "device": "a", "path": "report.docx", "mode": "644" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "key": "report.docx", "text": "can't read me yet" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a file another application holds locked is listed as locked and goes up within one pass after the lock is released",
    "description": "KOOFR-002, the trigger itself (an Office lock). Rule P9: locked files are retried with backoff and listed (locked); the rest of the pass goes on.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "open-in-word.docx", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "b", "path": "open-in-word.docx", "text": "v2 saved while open" },
      { "op": "drive_lock", "device": "b", "path": "open-in-word.docx" },
      { "op": "drive_write", "device": "b", "path": "other.txt", "text": "goes on" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "locked", "key": "open-in-word.docx" },
      { "op": "drive_check", "check": "remote_file", "key": "other.txt", "text": "goes on" },
      { "op": "drive_unlock", "device": "b", "path": "open-in-word.docx" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "key": "open-in-word.docx", "text": "v2 saved while open" },
      { "op": "drive_cleanup" }
    ]
  }
]
