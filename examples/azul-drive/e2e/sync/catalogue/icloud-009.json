[
  {
    "name": "five versions over a slow link, then the other device edits right after: every version kept, no conflict copy",
    "description": "ICLOUD-009 (sync-chaos merge-versions-no-false-conflict): iCloud cancelled queued versions when a newer one was ready, and Handoff forced a choice between versions. Rules C1, C3 and D2: each committed version is on the drive, repeated edits from one device and edits handed between devices never conflict, the last one wins everywhere.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_fault", "device": "a", "latency_ms": 300 },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "v2" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "v3" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "v4" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "v5" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "b", "path": "report.txt", "text": "v6 from b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "b", "path": "report.txt", "text": "v7 from b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "report.txt", "text": "v7 from b" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "report.txt", "count": 0 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "report.txt", "count": 0 },
      { "op": "drive_check", "check": "kept", "texts": ["v1", "v2", "v3", "v4", "v5", "v6 from b"] },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "versions saved while a slow upload is in flight: the last one wins on every device, no conflict",
    "description": "ICLOUD-009: autosave makes versions faster than they upload. Rules A6 and C3: a file changed during the pass is taken again once quiet (changed-during-sync at most), coalesced versions are allowed, and the final content reaches the other device without a conflict copy.",
    "steps": [
      { "op": "drive_create", "remote": "r2", "encrypted": false },
      { "op": "drive_open", "device": "c", "remote": "r2" },
      { "op": "drive_open", "device": "d", "remote": "r2" },
      { "op": "drive_pair", "device": "c" },
      { "op": "drive_pair", "device": "d" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "c", "path": "doc.pages", "text": "v1" },
      { "op": "drive_sync", "device": "c" },
      { "op": "drive_sync", "device": "d" },
      { "op": "drive_write", "device": "c", "path": "doc.pages", "text": "v2" },
      { "op": "drive_sync", "device": "c", "pause_at": "before-upload" },
      { "op": "drive_write", "device": "c", "path": "doc.pages", "text": "v3" },
      { "op": "drive_write", "device": "c", "path": "doc.pages", "text": "v4" },
      { "op": "drive_write", "device": "c", "path": "doc.pages", "text": "v5" },
      { "op": "drive_cont", "device": "c" },
      { "op": "drive_wait", "device": "c", "expect": "any" },
      { "op": "drive_sync", "device": "c" },
      { "op": "drive_sync", "device": "d" },
      { "op": "drive_check", "check": "file", "device": "d", "path": "doc.pages", "text": "v5" },
      { "op": "drive_check", "check": "remote_file", "key": "doc.pages", "text": "v5" },
      { "op": "drive_check", "check": "conflict_copies", "device": "c", "path": "doc.pages", "count": 0 },
      { "op": "drive_check", "check": "conflict_copies", "device": "d", "path": "doc.pages", "count": 0 },
      { "op": "drive_check", "check": "kept", "texts": ["v1", "v5"] },
      { "op": "drive_cleanup" }
    ]
  }
]
