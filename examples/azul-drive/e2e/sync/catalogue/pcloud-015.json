{
  "name": "a pass killed with uploads in flight, then restarted: the queue drains, a 0-byte file is completed, nothing spins",
  "description": "PCLOUD-015 (pCloud): after a kill during a long diff the client sat at 'UPLOADING, Remaining: 3 files, 0 Bytes' forever and new files never went up. Rules E8/A4/A7/P7 (sync-chaos res-crash-points): a crash converges at the next pass; a 0-byte file is a real file.",
  "steps": [
    { "op": "drive_harness" },
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "in/one.txt", "text": "one" },
    { "op": "drive_write", "device": "a", "path": "in/two.txt", "text": "two" },
    { "op": "drive_write", "device": "a", "path": "in/three.txt", "text": "three" },
    { "op": "drive_sync", "device": "a", "crash_at": "after-blob", "expect": "crash" },
    { "op": "drive_restart", "device": "a" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "remote_count", "glob": "in/*", "count": 3 },
    { "op": "drive_check", "check": "remote_consistent" },
    { "op": "drive_write", "device": "a", "path": "in/empty.txt", "text": "" },
    { "op": "drive_sync", "device": "a", "crash_at": "before-upload", "expect": "crash" },
    { "op": "drive_restart", "device": "a" },
    { "op": "drive_sync", "device": "a", "timeout_ms": 20000 },
    { "op": "drive_check", "check": "remote_file", "key": "in/empty.txt", "text": "" },
    { "op": "drive_sync", "device": "a", "timeout_ms": 20000 },
    { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
    { "op": "drive_wait_idle", "device": "a", "timeout_ms": 10000 },
    { "op": "drive_status", "device": "a" },
    { "op": "assert_response", "path": "result.running", "equals": false },
    { "op": "drive_check", "check": "no_temp_files", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_cleanup" }
  ]
}
