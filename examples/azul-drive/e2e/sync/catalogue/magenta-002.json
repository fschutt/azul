[
  {
    "name": "the same files on both sides with different modification times and a fresh state: zero conflicts",
    "description": "MAGENTA-002 (MagentaCLOUD after the migration): the first sync showed a 'file conflict' dialog for every file already in the cloud, every five minutes; 'keep both' doubled the data. Rules C4 and C3: a first sync is a union where the same bytes agree regardless of time; no time-based decision. sync-chaos merge-first-sync-both-sides.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "mtime": 1600000000000000000, "text": "same bytes" },
      { "op": "drive_write", "device": "a", "path": "photo.jpg", "size": 131072, "seed": 2, "mtime": 1600000000000000000 },
      { "op": "drive_many", "device": "a", "dir": "bulk", "count": 200, "size": 256, "seed": 11 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "b", "path": "report.txt", "mtime": 1700000000000000000, "text": "same bytes" },
      { "op": "drive_write", "device": "b", "path": "photo.jpg", "size": 131072, "seed": 2, "mtime": 1700000000000000000 },
      { "op": "drive_many", "device": "b", "dir": "bulk", "count": 200, "size": 256, "seed": 11 },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.conflicts", "equals": 0 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "absent": true },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "report.txt", "count": 0 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "photo.jpg", "count": 0 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 202 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a conflict the user answered never comes back",
    "description": "MAGENTA-002: dismissed conflicts reappeared every five minutes, and later 'unresolved conflicts' were shown with nothing listed. Rules C1 and O1: a held conflict is answered once; afterwards no pass lists it again and the old version stays recoverable.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "f.txt", "text": "one" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "f.txt", "text": "a's version" },
      { "op": "drive_write", "device": "b", "path": "f.txt", "text": "b's version" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.conflicts", "equals": 1 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "key": "f.txt" },
      { "op": "drive_resolve", "device": "b", "key": "f.txt", "choice": "mine" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "absent": true, "when": "last" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "f.txt", "text": "b's version" },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "f.txt", "count": 0 },
      { "op": "drive_check", "check": "kept", "texts": ["a's version", "b's version"] },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a reinstalled client with an empty state agrees with the drive by hash: no conflict, nothing sent",
    "description": "MAGENTA-002 (fresh state after reinstall). Rules D5 and A1: lost state is rebuilt by hashing against the drive; identical files need no transfer and make no conflict.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "bulk", "count": 50, "size": 256, "seed": 12 },
      { "op": "drive_write", "device": "a", "path": "report.txt", "text": "same bytes" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_wipe_state", "device": "a" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.conflicts", "equals": 0 },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "report.txt", "count": 0 },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 51 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  }
]
