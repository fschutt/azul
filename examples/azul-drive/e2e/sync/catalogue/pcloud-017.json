[
  {
    "name": "a stored object cut short or with flipped bytes is refused by its hash, the old version stays",
    "description": "PCLOUD-017 (pCloud, ETH Zurich CCS 2024): the server can drop 4096-byte chunks (unauthenticated Merkle tree). Rules S15/A5 (sync-chaos res-truncated-download, sec-wrong-bytes): bytes that do not match the hash are refused (hash-mismatch); the old version stays; no partial file.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "report.pdf", "size": 600000, "seed": 17 },
      { "op": "drive_write", "device": "a", "path": "other.pdf", "size": 600000, "seed": 18 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "report.pdf", "size": 600000, "seed": 19 },
      { "op": "drive_write", "device": "a", "path": "other.pdf", "size": 600000, "seed": 20 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "truncate_blob", "key": "report.pdf", "keep": 409600 },
      { "op": "drive_tamper", "remote": "r", "action": "corrupt_blob", "key": "other.pdf" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "report.pdf" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "other.pdf" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "report.pdf", "size": 600000 },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "on an encrypted drive a dropped, reordered or replayed chunk fails its AEAD and the file is listed, never written",
    "description": "PCLOUD-017 (pCloud): chunks dropped, names swapped, metadata altered by a malicious server. Rules M2/S15/I1 (sync-chaos crypto-malicious-server): AEAD per chunk bound to its index and file.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "report.pdf", "size": 3000000, "seed": 17 },
      { "op": "drive_write", "device": "a", "path": "other.pdf", "size": 3000000, "seed": 18 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "report.pdf", "size": 3000000, "seed": 19 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "drop_chunk", "key": "report.pdf", "chunk": 1 },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["hash-mismatch", "remote-entry-unreadable"], "key": "report.pdf" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "reorder_chunks", "key": "report.pdf" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["hash-mismatch", "remote-entry-unreadable"], "key": "report.pdf", "when": "last" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a server that swaps two encrypted names is caught",
    "description": "PCLOUD-017 (pCloud): names not bound to contents. Rule M2: name and parent bound into the AEAD.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "report.pdf", "size": 600000, "seed": 17 },
      { "op": "drive_write", "device": "a", "path": "other.pdf", "size": 600000, "seed": 18 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "report.pdf", "size": 600000, "seed": 19 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "swap_names", "key": "report.pdf", "with": "other.pdf" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["remote-entry-unreadable", "hash-mismatch"], "key": "report.pdf" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a substituted folder or drive key is refused",
    "description": "PCLOUD-017 (pCloud): the server can replace folder keys (unauthenticated RSA-OAEP) and overwrite the private key in transit. Rule M2: key material is authenticated.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "report.pdf", "size": 600000, "seed": 17 },
      { "op": "drive_write", "device": "a", "path": "other.pdf", "size": 600000, "seed": 18 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "report.pdf", "size": 600000, "seed": 19 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "replace_drive_key" },
      { "op": "drive_write", "device": "b", "path": "after.txt", "text": "written after the key swap" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "after.txt", "text": "written after the key swap" },
      { "op": "drive_check", "check": "remote_never_has", "marker": "written after the key swap" },
      { "op": "drive_cleanup" }
    ]
  }
]
