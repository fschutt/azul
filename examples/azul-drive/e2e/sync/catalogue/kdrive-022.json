[
  {
    "name": "a hidden folder as the root, and hidden files in it, sync both ways",
    "description": "KDRIVE-022 (kDrive): with a hidden folder (~/.kDrive) as the root, downloads worked but no local change was ever uploaded; hidden files kept their parents 'pending' forever. Rule P11: only the listed bookkeeping is ignored; a root's own name never excludes it, a dot file is a file.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a", "folder": "{run}/devices/a/.azdrive" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "notes.txt", "text": "visible" },
      { "op": "drive_write", "device": "a", "path": ".hidden-note", "text": "hidden" },
      { "op": "drive_write", "device": "a", "path": "sub/.config/settings.json", "text": "{}" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 3 },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": ".hidden-note", "text": "hidden" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": ".hidden-note", "text": "hidden" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "sub/.config/settings.json", "text": "{}" },
      { "op": "drive_write", "device": "b", "path": "from-b.txt", "text": "up from b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "from-b.txt", "text": "up from b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "an exclusion that matches files already synced makes no operations: nothing deleted, listed once, quiet passes",
    "description": "KDRIVE-022 (kDrive): an excluded pattern matching an already synced file caused a sync loop. Rules P11, S16 and D6: excluding or including again deletes nothing on either side; the change is listed (ignore-change); excluded items generate no operations. sync-chaos port-selective-sync.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "build/\n" },
      { "op": "drive_write", "device": "a", "path": "keep/a.txt", "text": "kept" },
      { "op": "drive_write", "device": "a", "path": "build/out.bin", "text": "artifact" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "build/*", "count": 0 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "build/remote.bin", "text": "from a device without the rule" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "build/remote.bin", "absent": true },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "build/remote.bin" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "build/out.bin", "text": "artifact" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "# nothing excluded\n" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "keep/\n" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "build/out.bin", "text": "artifact" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "build/out.bin", "text": "artifact" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "keep/a.txt", "text": "kept" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "keep/a.txt", "text": "kept" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "keep/a.txt", "text": "kept" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "ignore-change" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  }
]
