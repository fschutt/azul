[
  {
    "name": "FILEN-021: Word's save (temp file, rename dance, ~$ lock file while open) is one update of the document: no temp file, no conflict, nothing trashed",
    "description": "FILEN-021 (Filen): edited Office documents in a two-way folder vanished by the next day or reverted. Rules P10 (atomic saves are one change), P11 (temp and lock files never sync). sync-chaos port-office-save.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "reports/q3.docx", "text": "q3 draft" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_office_save", "device": "a", "path": "reports/q3.docx", "text": "q3 final", "keep_lock": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "reports/q3.docx", "text": "q3 final" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "*~$*", "count": 0 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "*.tmp", "count": 0 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 1 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "reports/q3.docx", "count": 0 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "kept", "texts": ["q3 draft"] },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-021: a pass in the middle of Word's save, while the document exists only under a temp name, deletes nothing; the other device then gets the new version",
    "description": "FILEN-021 (Filen): saving and closing the app or shutting down mid-save lost the document. Rules P10, D6 (a pass in the middle of a save deletes nothing: save-in-progress). sync-chaos port-office-save-interrupted.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "Pra\u0308sentation.docx", "text": "draft" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "~WRD0001.tmp", "text": "final" },
      { "op": "drive_rename", "device": "a", "from": "Pra\u0308sentation.docx", "to": "~WRL0002.tmp" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Pra\u0308sentation.docx", "text": "draft" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "Pra\u0308sentation.docx", "text": "draft" },
      { "op": "drive_rename", "device": "a", "from": "~WRD0001.tmp", "to": "Pra\u0308sentation.docx" },
      { "op": "drive_rm", "device": "a", "path": "~WRL0002.tmp" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "save-in-progress" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Pra\u0308sentation.docx", "text": "final" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "Pra\u0308sentation.docx", "count": 0 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 1 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-021: a save followed at once by quitting the app (before any pass) reaches the drive at the next start; LibreOffice's save too",
    "description": "FILEN-021 (Filen): the trigger 'save, then stop the client within 1 s'. Rules P10, A2 (changes made while stopped are taken at the next start).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "letter.docx", "text": "letter draft" },
      { "op": "drive_write", "device": "a", "path": "sheet.odt", "text": "sheet draft" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_office_save", "device": "a", "path": "letter.docx", "text": "letter final" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_write", "device": "a", "path": ".~lock.sheet.odt#", "text": "libreoffice has it open" },
      { "op": "drive_editor_save", "device": "a", "path": "sheet.odt", "text": "sheet final" },
      { "op": "drive_rm", "device": "a", "path": ".~lock.sheet.odt#" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "letter.docx", "text": "letter final" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "sheet.odt", "text": "sheet final" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "letter.docx", "text": "letter final" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "sheet.odt", "text": "sheet final" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "*lock*", "count": 0 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 2 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "letter.docx", "count": 0 },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
