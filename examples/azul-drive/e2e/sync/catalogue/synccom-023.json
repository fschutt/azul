[
  {
    "name": "an encrypted drive never shows the server a plaintext name or byte",
    "description": "SYNCCOM-023 (Sync.com, ETH Zurich CCS 2024): the malicious-server attacks start from what the server sees. Rule I1: names and bytes are AZL1 ciphertext.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "salary-review-canary.txt", "text": "secret salary canary" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_never_has", "marker": "salary-review-canary" },
      { "op": "drive_check", "check": "remote_never_has", "marker": "secret salary canary" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a server that swaps two encrypted names is detected: neither file is written under the other's name",
    "description": "SYNCCOM-023 (Sync.com): file names not bound to contents, swaps undetected. Rules M2/S15 (sync-chaos crypto-malicious-server): name and parent bound into the AEAD; a swapped entry is listed (remote-entry-unreadable), never written.",
    "pending": "drive_tamper {\"remote\":\"r\",\"action\":\"swap_names\",\"key\":\"a.txt\",\"with\":\"b.txt\"} on an ENCRYPTED remote (swap two files' encrypted names/entries without the key)",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "a.txt", "text": "contents of a" },
      { "op": "drive_write", "device": "a", "path": "b.txt", "text": "contents of b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "swap_names", "key": "a.txt", "with": "b.txt" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["remote-entry-unreadable", "hash-mismatch"], "key": "a.txt" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "a.txt", "text": "contents of a" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "b.txt", "text": "contents of b" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
