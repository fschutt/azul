{
  "name": "a folder deleted by mistake comes back through a point-in-time restore, and deleting the restored copy keeps the history",
  "description": "PCLOUD-025 (pCloud): a folder missing at every rewind date; trashing the 'Rewind' folder removed the previous data from the server. Rules D2/V4/V3 (sync-chaos srv-point-in-time-restore): a restore never consumes the history it restores from; a second restore works.",
  "pending": "drive_tamper {\"remote\":\"r\",\"action\":\"restore\",\"to\":\"t0\"} succeeding (today it fails until the stand-in remote has the server's restore announcement)",
  "steps": [
    { "op": "drive_harness" },
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_wait_idle" },
    { "op": "drive_many", "device": "a", "dir": "docs", "count": 20, "text_prefix": "doc" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_snapshot", "remote": "r", "name": "t0" },
    { "op": "drive_rmtree", "device": "a", "path": "docs" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_answer", "device": "a", "question": "mass_delete", "delete_too": true },
    { "op": "drive_wait_idle" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "remote_count", "glob": "docs/*", "count": 0 },
    { "op": "drive_tamper", "remote": "r", "action": "restore", "to": "t0" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "files_count", "device": "a", "glob": "docs/*", "count": 20 },
    { "op": "drive_rmtree", "device": "a", "path": "docs" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_answer", "device": "a", "question": "mass_delete", "delete_too": true },
    { "op": "drive_wait_idle" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "kept", "texts": ["doc 0", "doc 19"] },
    { "op": "drive_tamper", "remote": "r", "action": "restore", "to": "t0" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "files_count", "device": "a", "glob": "docs/*", "count": 20 },
    { "op": "drive_check", "check": "remote_consistent" },
    { "op": "drive_cleanup" }
  ]
}
