  {
    "name": "roots on FAT32 and exFAT (a USB stick, an SD card): coarse times cause no churn; names the disk refuses are listed, never renamed",
    "description": "JOTTA-024 (Jottacloud): exFAT 'prevents sync from working properly' (now refused). Rule P14 (FAT32/exFAT: no churn, limits probed and listed). sync-chaos port-fat-exfat-roots.",
    "only_on": ["macos", "linux"],
    "pending": "drive_open {\"device\": \"a\", \"remote\": \"r\", \"fs\": \"fat32:40m\"} (and \"exfat:16m\"): the device's folder on a volume of its own of that filesystem (hdiutil on macOS, a loop device on Linux)",
    "expect": "fail",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r", "fs": "fat32:40m" },
      { "op": "drive_open", "device": "b", "remote": "r", "fs": "exfat:16m" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "dcim/IMG_0001.JPG", "text": "photo 1" },
      { "op": "drive_write", "device": "a", "path": "notes.txt", "text": "notes" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "note:1.txt", "text": "colon" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_write", "device": "b", "path": "notes.txt", "text": "notes, edited on the card" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "notes.txt", "text": "notes, edited on the card" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "dcim/IMG_0001.JPG", "text": "photo 1" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 3 },
      { "op": "drive_cleanup" }
    ]
  }
