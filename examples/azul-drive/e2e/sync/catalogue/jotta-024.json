[
  {
    "name": "a disk too small for the whole set: what fits comes down, the rest is listed with disk-reserve, nothing half-written",
    "description": "JOTTA-024 (Jottacloud): sync refused to download anything when the whole set did not fit; local problems stopped sync without a word. Rules E3 (a download that cannot fit, keeping the reserve, is not started; the other files go on) and O1.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "small.txt", "text": "small enough" },
      { "op": "drive_write", "device": "a", "path": "big1.bin", "size": 400000, "seed": 1 },
      { "op": "drive_write", "device": "a", "path": "big2.bin", "size": 400000, "seed": 2 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_disk", "device": "b", "free_bytes": 1073891824 },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "small.txt", "text": "small enough" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "big1.bin", "absent": true },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["disk-reserve", "disk-full"], "key": "big1.bin" },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["disk-reserve", "disk-full"], "key": "big2.bin" },
      { "op": "drive_status", "device": "b" },
      { "op": "assert_response", "path": "result.status", "not_contains": "azdrive-sync-status-up-to-date" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_disk", "device": "b", "clear": true },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "big1.bin", "same_as": "{root:a}/big1.bin" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "the root cannot be read (permission revoked, macOS privacy): nothing is deleted, the device says why",
    "description": "JOTTA-024 (Jottacloud): backup silently skipped unreadable roots on macOS until 25.11.04. Rules D3/D6 (a root that cannot be read changes nothing anywhere) and O1.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "one.txt", "text": "one" },
      { "op": "drive_write", "device": "a", "path": "two.txt", "text": "two" },
      { "op": "drive_write", "device": "a", "path": "three.txt", "text": "three" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_chmod", "device": "a", "path": "{root:a}", "mode": "000" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["unreadable", "root-missing", "io-error"] },
      { "op": "drive_status", "device": "a" },
      { "op": "assert_response", "path": "result.status", "not_contains": "azdrive-sync-status-up-to-date" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 3 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 3 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_chmod", "device": "a", "path": "{root:a}", "mode": "755" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 3 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  },
