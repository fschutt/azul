  {
    "name": "FILEN-018: a pair whose folder is the root of a volume (a drive root, a mounted share) syncs normally",
    "description": "FILEN-018 (Filen): the traversal guard used startsWith(root + sep), which rejected every item of a pair rooted at Z:\\ or \\\\NAS\\share (7000+ errors) and froze the UI. Rule S8 keeps every path inside the root without breaking a root at a volume's top.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_volume", "device": "a", "fs": "apfs:16m" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "one.txt", "text": "one" },
      { "op": "drive_write", "device": "a", "path": "sub/two.txt", "text": "two" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "one.txt", "text": "one" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "sub/two.txt", "text": "two" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "sub/two.txt", "text": "two" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "bad-remote-name", "absent": true },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mount-point", "absent": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-018: a remote name of bytes that are no UTF-8 (an overlong slash) never becomes a file outside the root",
    "description": "FILEN-018. Rule S1.",
    "not_applicable": "AzDrive's drives cannot hold such a name: a plain drive's index is JSON, which holds UTF-8 only (raw bytes make the whole index unreadable, and nothing is written anywhere), S3 keys are UTF-8, and an encrypted drive refuses the name at its own write; sync-chaos sec-remote-traversal tests it on its own drive folder (engine adapter: listed as bad-remote-name <U+DCC0><U+DCAF>)",
    "steps": [
      {
        "op": "drive_cleanup"
      }
    ]
  }
