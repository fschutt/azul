[
  {
    "name": "FILEN-018: remote names that climb out (.., absolute, UNC, drive paths, backslashes) never become files outside the root",
    "description": "FILEN-018 (Filen): a cloud name with '..' segments was joined onto the local root, so download/mkdir/rename/delete could act outside it. Rules S8 (traversal refused before any path is built, on the whole key and each segment), M1, O1. sync-chaos sec-remote-traversal.",
    "only_on": ["macos", "linux"],
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "../escape.txt", "text": "escape" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "a/../../escape2.txt", "text": "escape" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "../../../outside/.ssh/authorized_keys", "text": "ssh-ed25519 AAAA-the-attackers-key" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "{outside}/pwned.txt", "text": "absolute" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "\\\\server\\share\\unc.txt", "text": "unc" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "a\\..\\..\\back.txt", "text": "backslash" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "C:\\drive.txt", "text": "drive" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "C:relative.txt", "text": "drive relative" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "dir/C:inner.txt", "text": "drive relative inside" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "report.txt:hidden", "text": "alternate data stream" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "ok.txt", "text": "ok" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "outside_untouched" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "{run}/devices/b/escape.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "{run}/devices/b/escape2.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "{run}/devices/escape.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "{run}/escape.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "ok.txt", "text": "ok" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "bad-remote-name", "key": "../escape.txt" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "bad-remote-name", "key": "a/../../escape2.txt" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "bad-remote-name", "key": "../../../outside/.ssh/authorized_keys" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "bad-remote-name", "key": "{outside}/pwned.txt" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "bad-remote-name", "key": "C:relative.txt" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "portability", "key": "dir/C:inner.txt" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 3 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
