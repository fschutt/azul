[
  {
    "name": "a file another app holds locked cannot be replaced: listed and retried, the rest of the pass arrives, then it updates",
    "description": "KDRIVE-015 (kDrive): files were 'blacklisted' (excluded for good) when Windows locked them or their parent folders. Rules P9, E6 and O1: a locked file is retried with backoff and listed (locked); the other files of the pass arrive; once unlocked it updates. sync-chaos port-locked-file.",
    "only_on": ["macos"],
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "open-in-excel.xlsx", "text": "v1" },
      { "op": "drive_write", "device": "a", "path": "other.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_chflags", "device": "b", "path": "open-in-excel.xlsx", "flags": "uchg" },
      { "op": "drive_write", "device": "a", "path": "open-in-excel.xlsx", "text": "v2" },
      { "op": "drive_write", "device": "a", "path": "other.txt", "text": "v2" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "other.txt", "text": "v2" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "open-in-excel.xlsx", "text": "v1" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "locked", "key": "open-in-excel.xlsx" },
      { "op": "drive_chflags", "device": "b", "path": "open-in-excel.xlsx", "flags": "nouchg" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "open-in-excel.xlsx", "text": "v2" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "locked", "key": "open-in-excel.xlsx", "absent": true, "when": "last" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "another user renames a folder whose file is open here (the folder locked): retried until the lock goes, never excluded",
    "description": "KDRIVE-015 (kDrive): Windows locks every parent folder of a file open in Excel, and a rename of one of them could not propagate. Rules P9 and E6: the rename is retried with backoff and done once the handle is closed; no item is permanently excluded.",
    "only_on": ["macos"],
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "team/a.xlsx", "text": "sheet" },
      { "op": "drive_write", "device": "a", "path": "team/b.txt", "text": "notes" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_chflags", "device": "b", "path": "team", "flags": "uchg" },
      { "op": "drive_rename", "device": "a", "from": "team", "to": "team-2026" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["locked", "busy", "io-error"], "key": "team*" },
      { "op": "drive_check", "check": "kept_live", "texts": ["sheet", "notes"] },
      { "op": "drive_chflags", "device": "b", "path": "team", "flags": "nouchg" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "team-2026/a.xlsx", "text": "sheet" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "team/a.xlsx", "absent": true },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "cloud-only copies of files another computer rewrites every few minutes stay cloud-only and are never excluded",
    "description": "KDRIVE-015 (kDrive): many files were blacklisted though never hydrated locally. Rules P13 and O1: a cloud-only file whose drive version changes stays cloud-only and listed as nothing.",
    "pending": "drive_evict {device, path or glob}: make files cloud-only, as 'free up space'",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "shared/progress.txt", "text": "0" },
      { "op": "drive_write", "device": "a", "path": "shared/db.sqlite", "size": 40000, "seed": 5 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_evict", "device": "b", "glob": "shared/*" },
      { "op": "drive_append", "device": "a", "path": "shared/progress.txt", "text": " 1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_append", "device": "a", "path": "shared/progress.txt", "text": " 2" },
      { "op": "drive_overwrite_in_place", "device": "a", "path": "shared/db.sqlite", "size": 40000, "seed": 6 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_states", "device": "b" },
      { "op": "assert_response", "path": "result.files[\"shared/progress.txt\"].cloud_only", "equals": true },
      { "op": "assert_response", "path": "result.files[\"shared/db.sqlite\"].cloud_only", "equals": true },
      { "op": "drive_problems", "device": "b" },
      { "op": "assert_response", "path": "result.problems", "len": 0 },
      { "op": "drive_cleanup" }
    ]
  },
