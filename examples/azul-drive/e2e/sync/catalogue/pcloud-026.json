[
  {
    "name": "the executable bit travels as part of the file; links are inert (listed, never followed out of the root)",
    "description": "PCLOUD-026 (pCloud): no POSIX permissions and no symlinks, so the exec bit and links were lost. Rules P6/S1/S2 (sync-chaos port-exec-bit, sec-symlink-out-file, sec-folder-replaced-by-link): the user's x bit syncs (nothing else of the mode); links are listed (symlink-skipped), never followed, a loop ends the scan.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "bin/deploy.sh", "text": "#!/bin/sh\necho hi\n", "exec": true },
      { "op": "drive_write", "device": "a", "path": "lib/real.txt", "text": "real" },
      { "op": "drive_symlink", "device": "a", "path": "lib/rel-link", "target": "real.txt" },
      { "op": "drive_symlink", "device": "a", "path": "abs-out", "target": "{outside}/secret.txt" },
      { "op": "drive_symlink", "device": "a", "path": "dangling", "target": "does-not-exist" },
      { "op": "drive_symlink", "device": "a", "path": "loop", "target": "." },
      { "op": "drive_chmod", "device": "a", "path": "lib/real.txt", "mode": "666" },
      { "op": "drive_sync", "device": "a", "timeout_ms": 20000 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "bin/deploy.sh", "exec": true },
      { "op": "drive_check", "check": "remote_file", "key": "bin/deploy.sh", "exec": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "lib/real.txt", "mode_max": "755" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "symlink-skipped", "key": "abs-out" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "symlink-skipped", "key": "dangling" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "symlink-skipped", "key": "loop" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "abs-out", "absent": true },
      { "op": "drive_check", "check": "remote_never_has" },
      { "op": "drive_check", "check": "outside_untouched" },
      { "op": "drive_chmod", "device": "a", "path": "bin/deploy.sh", "mode": "644" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "bin/deploy.sh", "exec": false },
      { "op": "drive_check", "check": "remote_file", "key": "bin/deploy.sh", "exec": false },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "with link syncing on, a relative link inside the root round-trips as a link; one pointing outside never does",
    "description": "PCLOUD-026 (pCloud): symlinks lost. Rule S1: a pairing may sync relative links inside the root as link objects; S2: a link out of the root is never created.",
    "pending": "drive_pair {\"device\":\"a\",\"links\":\"inside-root\"} (the pairing option that syncs relative links whose target stays inside the root as link objects; the strict default skips them)",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a", "links": "inside-root" },
      { "op": "drive_pair", "device": "b", "links": "inside-root" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "bin/deploy.sh", "text": "#!/bin/sh\necho hi\n", "exec": true },
      { "op": "drive_write", "device": "a", "path": "lib/real.txt", "text": "real" },
      { "op": "drive_symlink", "device": "a", "path": "lib/rel-link", "target": "real.txt" },
      { "op": "drive_symlink", "device": "a", "path": "abs-out", "target": "{outside}/secret.txt" },
      { "op": "drive_symlink", "device": "a", "path": "dangling", "target": "does-not-exist" },
      { "op": "drive_symlink", "device": "a", "path": "loop", "target": "." },
      { "op": "drive_sync", "device": "a", "timeout_ms": 20000 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "link", "device": "b", "path": "lib/rel-link" },
      { "op": "drive_check", "check": "link", "device": "b", "path": "abs-out", "absent": true },
      { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["symlink-skipped", "link-refused"], "key": "abs-out" },
      { "op": "drive_check", "check": "outside_untouched" },
      { "op": "drive_cleanup" }
    ]
  }
]
