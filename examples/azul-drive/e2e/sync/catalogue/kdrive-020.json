[
  {
    "name": "the root's disk is ejected and plugged in again (a new device id): the same folder is recognised, nothing is sent again or deleted",
    "description": "KDRIVE-020 (kDrive): a sync folder on an external SSD stayed paused after a reboot and could not be resumed. Rules D3 and A1: the root marker recognises the folder plugged in again; the pass after it sends nothing and deletes nothing. sync-chaos delete-root-remounted.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a", "fs": "apfs:16m" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "docs", "count": 8, "text_prefix": "doc" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_detach", "device": "a" },
      { "op": "drive_attach", "device": "a" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "remote_puts", "device": "a", "max": 8 },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "root-replaced", "absent": true },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 8 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "the root's disk is unplugged at start, then plugged in again: the pairing waits with root-missing and resumes with nothing to send",
    "description": "KDRIVE-020 (kDrive): a paused sync that could not be resumed, and a missing root. Rules D3 and O1: a missing root changes nothing and says so; the same folder back (its root marker) resumes; nothing is sent again or deleted.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "docs", "count": 8, "text_prefix": "doc" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rename", "device": "a", "from": "{root:a}", "to": "{run}/usb-unplugged" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "root-missing", "when": "last" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 8 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 8 },
      { "op": "drive_rename", "device": "a", "from": "{run}/usb-unplugged", "to": "{root:a}" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "assert_response", "path": "result.deleted", "equals": 0 },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "root-missing", "absent": true, "when": "last" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "root-replaced", "absent": true },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_index", "remote": "r" },
      { "op": "assert_response", "path": "result.deleted", "len": 0 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "space macOS can purge on demand counts as free: the sync is not refused for want of space",
    "description": "KDRIVE-020 (kDrive): the client read 'free' (49 GB) instead of 'available including purgeable' (240 GB) and refused to sync. Rule E3: the reserve is measured against the space the system will really give.",
    "pending": "drive_disk {device, purgeable_bytes}: space the system frees on demand (macOS purgeable), which the engine's free-space check must count as available",
    "only_on": ["macos"],
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "big.bin", "size": 5000000, "seed": 201 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_disk", "device": "b", "free_bytes": 1000000, "purgeable_bytes": 5000000000 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "big.bin", "same_as": "{root:a}/big.bin" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "disk-reserve", "absent": true },
      { "op": "drive_cleanup" }
    ]
  }
]
