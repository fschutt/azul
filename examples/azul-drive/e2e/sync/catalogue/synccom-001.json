[
  {
    "name": "SYNCCOM-001: a file this device cannot read for a while is listed, never taken for deleted, and syncs again once readable",
    "description": "SYNCCOM-001 (Sync.com): a temporary local file-access error (a permission hiccup) while comparing local and remote state removed files from Sync and from the other devices. Rule D6: a file that cannot be opened is unknown, never deleted; O1 lists it. sync-chaos delete-unreadable-not-deleted.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "payroll.xlsx", "text": "salaries" },
      { "op": "drive_write", "device": "a", "path": "other.txt", "text": "other" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_chmod", "device": "a", "path": "payroll.xlsx", "mode": "000" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "unreadable", "key": "payroll.xlsx" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "payroll.xlsx", "text": "salaries" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "payroll.xlsx", "text": "salaries" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_chmod", "device": "a", "path": "payroll.xlsx", "mode": "644" },
      { "op": "drive_write", "device": "a", "path": "payroll.xlsx", "text": "salaries, raised" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "payroll.xlsx", "text": "salaries, raised" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "unreadable", "absent": true, "when": "last" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "SYNCCOM-001: a folder whose scan fails propagates zero deletions",
    "description": "SYNCCOM-001 (Sync.com): a failed local folder scan deleted the folder from Sync. Rule D6: nothing below an unreadable folder is deleted until a complete, clean read.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "clients", "count": 8, "text_prefix": "client" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_chmod", "device": "a", "path": "clients", "mode": "000" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "unreadable", "key": "clients*" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "clients/*", "count": 8 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "clients/*", "count": 8 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "max_ops", "device": "a", "change": "trash", "max": 0 },
      { "op": "drive_chmod", "device": "a", "path": "clients", "mode": "755" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "SYNCCOM-001: a root whose volume is briefly unavailable (an empty folder in its place) changes nothing anywhere",
    "description": "SYNCCOM-001 (Sync.com): the volume briefly unavailable during the compare. Rule D3: a pass whose root lacks its marker changes nothing anywhere and says so. sync-chaos delete-root-unmounted.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "docs", "count": 8, "text_prefix": "doc" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_replace_root", "device": "a" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["root-replaced", "root-missing"], "when": "last" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 8 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 8 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "SYNCCOM-001: an I/O error on one folder during one scan propagates zero deletions",
    "description": "SYNCCOM-001 (Sync.com): readdir() failing with EIO for one scan. Rule D6. chmod gives only EACCES.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "clients", "count": 8, "text_prefix": "client" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_local_fault", "device": "a", "path": "clients", "readdir_error": "EIO", "passes": 1 },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "clients/*", "count": 8 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "clients/*", "count": 8 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
