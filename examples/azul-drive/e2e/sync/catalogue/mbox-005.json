[
  {
    "name": "2,000 small files go up and down, and the next pass on each device hashes and sends nothing again",
    "description": "MBOX-005 (mailbox.org WebDAV and OX Drive): opening a folder took minutes because checksums were computed on demand from storage and recomputed after an aborted sync. Rules E7 and A1: many small files are packed with one commit per batch, and a file whose size, mtime, ctime and inode are unchanged keeps its hash. sync-chaos res-many-small-files, res-many-small-files-20k.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "bulk", "count": 2000, "size": 200, "seed": 3 },
      { "op": "drive_sync", "device": "a", "timeout_ms": 600000 },
      { "op": "drive_sync", "device": "b", "timeout_ms": 600000 },
      { "op": "drive_check", "check": "remote_count", "glob": "bulk/*", "count": 2000 },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "bulk/*", "count": 2000 },
      { "op": "drive_sync", "device": "a", "timeout_ms": 600000 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b", "timeout_ms": 600000 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "after a restart the hashes of unchanged files are taken from the base, not computed again",
    "description": "MBOX-005: OX's fix keeps checksums computed before an aborted sync. Rule A1: the base keeps each file's hash with its size, mtime, ctime and inode; only a changed file is hashed again.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "bulk", "count": 2000, "size": 200, "seed": 3 },
      { "op": "wait", "ms": 2500, "real": true },
      { "op": "drive_sync", "device": "a", "timeout_ms": 600000 },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_write", "device": "a", "path": "changed.txt", "text": "the one new file" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_counters", "device": "a" },
      { "op": "assert_response", "path": "result.hashed", "at_most": 1 },
      { "op": "drive_cleanup" }
    ]
  }
]
