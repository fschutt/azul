{
  "name": "a large file moved to another folder sends no content again and lands in no trash",
  "description": "KOOFR-005 (Koofr desktop before August 2019): a moved or copied file was uploaded again in full instead of a server-side move. Rule A3: a delete and a new file with the same bytes on the same side is a move, on both sides: no trash, no new upload. sync-chaos merge-rename-folder-is-move, perf-delta-upload.",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "inbox/film.bin", "size": 33554432, "seed": 5 },
    { "op": "drive_write", "device": "a", "path": "inbox/keep.txt", "text": "keeps the folder" },
    { "op": "drive_mkdir", "device": "a", "path": "archive" },
    { "op": "drive_sync", "device": "a", "timeout_ms": 600000 },
    { "op": "drive_sync", "device": "b", "timeout_ms": 600000 },
    { "op": "drive_rename", "device": "a", "from": "inbox/film.bin", "to": "archive/film.bin" },
    { "op": "drive_sync", "device": "a" },
    { "op": "assert_response", "path": "result.up", "equals": 0 },
    { "op": "drive_counters", "device": "a" },
    { "op": "assert_response", "path": "result.bytes_up", "at_most": 34603008 },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "archive/film.bin", "same_as": "{root:a}/archive/film.bin" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "inbox/film.bin", "absent": true },
    { "op": "drive_check", "check": "trash_empty", "device": "a" },
    { "op": "drive_check", "check": "trash_empty", "device": "b" },
    { "op": "trash", "check": "max_ops", "device": "b", "max": 0 },
    { "op": "drive_check", "check": "remote_consistent" },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_cleanup" }
  ]
}
