      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "doc 0" },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "doc 59" },
      { "op": "drive_check", "check": "kept", "texts": ["doc 0", "doc 59"] },
