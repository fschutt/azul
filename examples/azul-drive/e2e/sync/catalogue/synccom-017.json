[
  {
    "name": "a folder of 12,000 files reaches a new device whole, through two interruptions (no per-folder cap)",
    "description": "SYNCCOM-017 (Sync.com): a fresh install missed files in the first sync, folders were capped at 10,000 files. Rules E7/E8/A4 (sync-chaos res-many-small-files-20k, res-kill9-random): no cap, an interrupted first sync converges, nothing doubled or lost.",
    "pending": "drive_many {\"device\":\"a\",\"dir\":\"big\",\"count\":12000,\"flat\":true,\"text_prefix\":\"rec\"} (all files in ONE folder; drive_many always splits into d000.. subfolders of 500)",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "big", "count": 12000, "flat": true, "text_prefix": "rec" },
      { "op": "drive_sync", "device": "a", "timeout_ms": 3600000 },
      { "op": "drive_fault", "device": "b", "cut_after_ops": 200 },
      { "op": "drive_sync", "device": "b", "expect": "any", "timeout_ms": 3600000 },
      { "op": "drive_fault", "device": "b", "clear": true },
      { "op": "drive_sync", "device": "b", "crash_at": "before-base-save", "expect": "crash", "timeout_ms": 3600000 },
      { "op": "drive_sync", "device": "b", "timeout_ms": 3600000 },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "big/*", "count": 12000 },
      { "op": "drive_check", "check": "remote_count", "glob": "big/*", "count": 12000 },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_sync", "device": "b", "timeout_ms": 600000 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
