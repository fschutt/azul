      { "op": "drive_rm", "device": "a", "glob": "docs/d000/f00003*" },
      { "op": "drive_rm", "device": "a", "glob": "docs/d000/f00004*" },
      { "op": "drive_rm", "device": "a", "glob": "docs/d000/f00005*" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held", "absent": true, "when": "last" },
