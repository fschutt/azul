      { "op": "drive_reinstall", "device": "a" },
      { "op": "drive_camera_upload", "device": "a", "assets": [{"id": "A1", "name": "vacation.2024.png", "size": 50000, "seed": 21}, {"id": "A2", "name": "IMG_0001.JPG", "size": 50000, "seed": 22}, {"id": "A3", "name": "IMG_0001.JPG", "size": 50000, "seed": 23}], "compress": false },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 3 },
      { "op": "drive_cleanup" }
    ]
  }
