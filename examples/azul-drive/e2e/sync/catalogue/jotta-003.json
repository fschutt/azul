{
  "name": "an object whose stored bytes no longer match its hash: the reader lists hash-mismatch every pass and nothing is sent again, by it or by the writer",
  "description": "JOTTA-003 (Jottacloud): the server answered a different MD5 for the same file on each read, so hundreds of GB were re-uploaded on every run. Rule S15 (a hash mismatch is refused and named: an integrity alarm, O1) and A3 (merge on the base's hashes: a server answer never makes an unchanged local file look changed).",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "media/movie.bin", "size": 200000, "seed": 3 },
    { "op": "drive_write", "device": "a", "path": "media/notes.txt", "text": "notes" },
    { "op": "drive_write", "device": "a", "path": "media/poster.jpg", "size": 50000, "seed": 4 },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_tamper", "remote": "r", "action": "corrupt_blob", "key": "media/movie.bin" },
    { "op": "drive_open", "device": "c", "remote": "r" },
    { "op": "drive_pair", "device": "c" },
    { "op": "drive_wait_idle" },
    { "op": "drive_sync", "device": "c", "expect": "any" },
    { "op": "drive_sync", "device": "c", "expect": "any" },
    { "op": "drive_sync", "device": "c", "expect": "any" },
    { "op": "drive_check", "check": "problem", "device": "c", "code": "hash-mismatch", "key": "media/movie.bin", "when": "last" },
    { "op": "drive_check", "check": "file", "device": "c", "path": "media/movie.bin", "absent": true },
    { "op": "drive_check", "check": "file", "device": "c", "path": "media/notes.txt", "text": "notes" },
    { "op": "drive_check", "check": "no_temp_files", "device": "c" },
    { "op": "drive_check", "check": "remote_puts", "device": "c", "max": 0 },
    { "op": "drive_sync", "device": "a" },
    { "op": "assert_response", "path": "result.up", "equals": 0 },
    { "op": "drive_sync", "device": "b" },
    { "op": "assert_response", "path": "result.up", "equals": 0 },
    { "op": "drive_check", "check": "remote_puts", "device": "a", "max": 3 },
    { "op": "drive_check", "check": "remote_puts", "device": "b", "max": 0 },
    { "op": "drive_check", "check": "file", "device": "b", "path": "media/movie.bin", "same_as": "{root:a}/media/movie.bin" },
    { "op": "drive_cleanup" }
  ]
}
