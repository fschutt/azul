[
  {
    "name": "a bulk upload held in the middle does not block another pairing's pass or the device's own answers",
    "description": "KOOFR-019 (Koofr Android before 3.7.0): a running media backup blocked all other communication with the server. Rule E6 and section 1: each pairing's pass runs on its own; the problem list, status and the folder stay answerable while a transfer runs. sync-chaos mobile-camera-upload.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_create", "remote": "r2" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "c", "remote": "r2" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "c" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "DCIM", "count": 500, "size": 8192, "seed": 9 },
      { "op": "drive_sync", "device": "a", "pause_at": "mid-read", "expect": "any", "timeout_ms": 600000 },
      { "op": "drive_status", "device": "a" },
      { "op": "assert_response", "path": "result.running", "equals": true },
      { "op": "drive_problems", "device": "a" },
      { "op": "drive_list", "device": "a" },
      { "op": "drive_write", "device": "c", "path": "notes.txt", "text": "another drive" },
      { "op": "drive_sync", "device": "c", "timeout_ms": 20000 },
      { "op": "drive_check", "check": "remote_file", "remote": "r2", "key": "notes.txt", "text": "another drive" },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a", "timeout_ms": 600000 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "DCIM/*", "count": 500 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a listing of the drive answers within normal time while the upload queue is full",
    "description": "KOOFR-019, the browsing half. Rule E6: metadata requests and bulk transfers use separate lanes, so a listing is never queued behind 500 uploads.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "DCIM", "count": 500, "size": 8192, "seed": 9 },
      { "op": "drive_fault", "device": "a", "latency_ms": 50 },
      { "op": "drive_sync_bg", "device": "a" },
      { "op": "drive_browse", "device": "a", "path": "", "timeout_ms": 2000 },
      { "op": "drive_wait", "device": "a", "timeout_ms": 600000 },
      { "op": "drive_fault", "device": "a", "clear": true },
      { "op": "drive_cleanup" }
    ]
  }
]
