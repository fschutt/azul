[
  {
    "name": "a backend move that lost the newest changes looks like an older index: it is refused, nothing here is deleted",
    "description": "MAGENTA-001 (Telekom MagentaCLOUD's 2021 move to Nextcloud): trash and old end-to-end-encrypted files were not migrated, WebDAV passwords died, the old client stopped. Rules V4 and S15: a migration keeps every committed file, trash and versions; an index older than the last one seen is refused (remote-rollback) and nothing is deleted. sync-chaos srv-restore-onto-replacement, crypto-keys-and-recovery.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "docs/a.txt", "text": "a" },
      { "op": "drive_write", "device": "a", "path": "docs/b.txt", "text": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_snapshot", "remote": "r", "name": "before" },
      { "op": "drive_write", "device": "a", "path": "docs/c.txt", "text": "written after the copy" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "rollback", "to": "before" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "remote-rollback" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "remote-rollback" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "docs/c.txt", "text": "written after the copy" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "docs/c.txt", "text": "written after the copy" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a drive copied to a new backend keeps files, tombstones and encrypted objects, and the devices reconnect without a re-sync",
    "description": "MAGENTA-001: the migration drill the competitor skipped. Rule V4: restores onto a replacement and backend migrations keep trash, versions and every committed file; clients converge without deletes or transfers.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "docs/a.txt", "text": "a" },
      { "op": "drive_write", "device": "a", "path": "docs/deleted.txt", "text": "in the trash" },
      { "op": "drive_write", "device": "a", "path": "docs/b.txt", "text": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "a", "path": "docs/deleted.txt" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_migrate", "remote": "r", "to": "r2" },
      { "op": "drive_repoint", "device": "a", "remote": "r2" },
      { "op": "drive_repoint", "device": "b", "remote": "r2" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r2", "key": "docs/a.txt", "text": "a" },
      { "op": "drive_index", "remote": "r2" },
      { "op": "assert_response", "path": "result.deleted", "contains": "docs/deleted.txt" },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "in the trash" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
