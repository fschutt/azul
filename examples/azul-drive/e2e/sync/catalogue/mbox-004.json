[
  {
    "name": "modification times travel through the drive to the nanosecond, and a touch alone sends nothing",
    "description": "MBOX-004 (mailbox.org WebDAV with rclone bisync): the server kept no modification times, so two-way sync could not run. Rules P6 and P12: times travel and are set on downloads; time is a hint, so a touch alone sends no content. sync-chaos port-mtime-roundtrip.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "epoch.txt", "mtime": 1000000000, "text": "one second after the epoch" },
      { "op": "drive_write", "device": "a", "path": "photo-2003.jpg", "mtime": 1049760000123456789, "text": "an old photo" },
      { "op": "drive_write", "device": "a", "path": "y2038.txt", "mtime": 2147483648000000000, "text": "past 32-bit time" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "mtime", "device": "b", "path": "epoch.txt", "ns": 1000000000 },
      { "op": "drive_check", "check": "mtime", "device": "b", "path": "photo-2003.jpg", "ns": 1049760000123456789 },
      { "op": "drive_check", "check": "mtime", "device": "b", "path": "y2038.txt", "ns": 2147483648000000000 },
      { "op": "drive_utime", "device": "a", "path": "photo-2003.jpg", "mtime": 1049760001000000000 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "photo-2003.jpg", "text": "an old photo" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "an edit that keeps the size and the modification time is still seen and sent",
    "description": "MBOX-004: a client must never rely on the time alone. Rules A1 and P12: the cache key includes ctime and inode, so content changed under an unchanged mtime is hashed again and synced.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "report.txt", "mtime": 1700000000000000000, "text": "version one" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_overwrite_in_place", "device": "a", "path": "report.txt", "text": "version two" },
      { "op": "drive_utime", "device": "a", "path": "report.txt", "mtime": 1700000000000000000 },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 1 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "report.txt", "text": "version two" },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "report.txt", "count": 0 },
      { "op": "drive_cleanup" }
    ]
  }
]
