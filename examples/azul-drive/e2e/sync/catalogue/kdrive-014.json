      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "loop-frozen", "absent": true },
      { "op": "drive_cleanup" }
