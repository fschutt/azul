[
  {
    "name": "one device deletes a folder and a file while the other, offline, adds a file to that folder and edits that file: the new work survives",
    "description": "KDRIVE-014 (kDrive): there was no conflict case for an edit under a deleted parent, so the edit was lost. Rules C2 and A3: an edit beats a delete and a new file in a deleted folder survives. sync-chaos merge-delete-folder-vs-new-file.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "d/old.txt", "text": "old" },
      { "op": "drive_write", "device": "a", "path": "f.txt", "text": "f v1" },
      { "op": "drive_write", "device": "a", "path": "stays.txt", "text": "stays" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rmtree", "device": "a", "path": "d" },
      { "op": "drive_rm", "device": "a", "path": "f.txt" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "b", "path": "d/new.txt", "text": "new on b" },
      { "op": "drive_write", "device": "b", "path": "f.txt", "text": "f edited on b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "d/new.txt", "text": "new on b" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "f.txt", "text": "f edited on b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "d/old.txt", "absent": true },
      { "op": "drive_check", "check": "kept_live", "texts": ["new on b", "f edited on b"] },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
