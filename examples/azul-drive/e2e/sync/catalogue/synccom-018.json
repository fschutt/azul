[
  {
    "name": "the sync state lost at an update: no conflict copy of an unchanged file, no deleted file back, no older version over a newer one",
    "description": "SYNCCOM-018 (Sync.com): an app update filled the drive with conflict files, restored deleted files and reverted files to older versions. Rules D5/A1/C4 (sync-chaos state-upgrade-migration): a lost state rebuilds by content hash; unchanged files agree, tombstones hold, a pending local edit is kept.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "keep.txt", "text": "keep" },
      { "op": "drive_write", "device": "a", "path": "gone.txt", "text": "deleted before the update" },
      { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x as synced" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "b", "path": "gone.txt" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x edited before the update" },
      { "op": "drive_wipe_state", "device": "a" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "gone.txt", "absent": true },
      { "op": "drive_check", "check": "remote_file", "key": "gone.txt", "absent": true },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "keep.txt", "count": 0 },
      { "op": "drive_check", "check": "file", "device": "a", "path": "keep.txt", "text": "keep" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "x.txt", "text": "x edited before the update" },
      { "op": "drive_check", "check": "kept_live", "texts": ["x edited before the update"] },
      { "op": "drive_check", "check": "kept", "texts": ["x as synced"] },
      { "op": "drive_cleanup" }
    ]
  },
