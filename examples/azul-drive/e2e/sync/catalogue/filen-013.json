[
  {
    "name": "FILEN-013: a folder whose name holds ':' syncs under its own name, is flagged for Windows, and is never renamed",
    "description": "FILEN-013 (Filen): a macOS name 'photos 2020:2021' was rewritten to 'photos 2020-2021', taken for another folder, and its contents were never backed up while sync said done. Rules P4, P5 (valid here, listed for the system that cannot hold it), O1.",
    "only_on": ["macos", "linux"],
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "photos 2020:2021/one.jpg", "text": "one" },
      { "op": "drive_write", "device": "a", "path": "photos 2020:2021/two.jpg", "text": "two" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "photos 2020:2021/one.jpg", "text": "one" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "photos 2020:2021/two.jpg", "text": "two" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "photos 2020-2021*", "count": 0 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "photos 2020:2021/one.jpg", "text": "one" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "portability", "key": "photos 2020:2021*" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
