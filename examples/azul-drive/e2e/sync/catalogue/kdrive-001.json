      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 31 },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 31 },
      { "op": "drive_cleanup" }
    ]
