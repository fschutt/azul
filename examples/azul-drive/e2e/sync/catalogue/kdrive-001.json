  {
    "name": "an upgrade over a folder of cloud-only files: none is deleted, all stay cloud-only",
    "description": "KDRIVE-001 (kDrive): the user's files were all dehydrated placeholders when the update ran. Rules P13, D5: an upgrade over a state of cloud-only files keeps every entry.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
