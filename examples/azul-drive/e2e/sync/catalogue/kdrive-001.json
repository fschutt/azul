[
  {
    "name": "a state broken by an upgrade, then the app restarted: nothing is deleted on the drive or here",
    "description": "KDRIVE-001 (kDrive): a client update recorded local deletes the user never made, and about 8,900 files were deleted locally and on the server. Rules D5, D6 and D1: lost or corrupted state is never a reason to delete; the next pass says state-reset and pairs afresh by hash, no tombstone, no trash. sync-chaos state-upgrade-migration, delete-state-lost.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "photos", "count": 30, "size": 2048, "seed": 131 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_corrupt_state", "device": "a" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "state-reset" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 30 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 30 },
      { "op": "drive_index", "remote": "r" },
      { "op": "assert_response", "path": "result.deleted", "len": 0 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 30 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
