[
  {
    "name": "a file moved into a folder where another device just made one of the same name: one name, the other version held and kept",
    "description": "ICEDRIVE-014 (Icedrive): moving a folder into one that already held files of the same names left several files of identical name in one folder. Rules C1, A3 and P1: a name exists once in a folder; the move meets the other device's new file as a conflict held for the user, keep both makes one conflict copy, both versions live, nothing is lost.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "target/keep.txt", "text": "kept" },
      { "op": "drive_write", "device": "a", "path": "incoming/report.txt", "text": "report from incoming" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "target/report.txt", "text": "report already in target" },
      { "op": "drive_rename", "device": "b", "from": "incoming/report.txt", "to": "target/report.txt" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.conflicts", "equals": 1 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "key": "target/report.txt" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "target/report.txt", "count": 1 },
      { "op": "drive_resolve", "device": "b", "key": "target/report.txt", "choice": "both" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "target/report.txt", "count": 1 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "target/report.txt", "count": 1 },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "target/report.txt", "count": 1 },
      { "op": "drive_check", "check": "kept_live", "texts": ["report from incoming", "report already in target"] },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "incoming/report.txt", "absent": true },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "Holiday.jpg, holiday.jpg and a decomposed variant on the drive reach a disk that folds them: one comes down, the others are listed, none overwritten",
    "description": "ICEDRIVE-014 (Icedrive): the mount app quietly consolidated same-named files. Rules P1, P2, P5 and O1: the one committed first comes down, every other is listed as name-collision and stays on the drive, nothing is overwritten or trashed, and the passes settle. sync-chaos port-case-collision-remote.",
    "only_on": ["macos", "windows"],
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "photos/Holiday.jpg", "text": "upper" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "photos/holiday.jpg", "text": "lower" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "photos/Caf\u00e9.jpg", "text": "composed" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "photos/Cafe\u0301.jpg", "text": "decomposed" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "photos/Holiday.jpg", "text": "upper" },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "photos/?oliday.jpg", "count": 1 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "photos/Caf\u00e9.jpg", "text": "composed" },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "photos/Caf*", "count": 1 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "name-collision", "key": "photos/holiday.jpg" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "name-collision", "key": "photos/Cafe\u0301.jpg" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "photos/holiday.jpg", "text": "lower" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "photos/Cafe\u0301.jpg", "text": "decomposed" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  }
]
