  {
    "name": "an editor's safe save (sibling renamed over, backup~ and swap file left) is one update",
    "description": "PCLOUD-014 (pCloud) via sync-chaos port-editor-save. Rules P10/P11: the side files stay local, no conflict copy, no trash entry.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "src/main.c", "text": "int main(){return 0;}" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_editor_save", "device": "a", "path": "src/main.c", "text": "int main(){return 1;}", "style": "backup", "keep_swap": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "src/main.c", "text": "int main(){return 1;}" },
      { "op": "drive_check", "check": "remote_count", "count": 1 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "src/main.c~", "absent": true },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "src/main.c", "count": 0 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  }
