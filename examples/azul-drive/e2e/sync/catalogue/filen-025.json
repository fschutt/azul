  {
    "name": "FILEN-025: one pairing whose folder is gone (an unplugged drive) does not stall another pairing",
    "description": "FILEN-025 (Filen): one pair on an offline external drive stalled the whole worker. Rules D3 (a missing root changes nothing and says so), E6 (never a global stall).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_create", "remote": "r2" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "c", "remote": "r2" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "c" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "on-usb.txt", "text": "on the usb disk" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_remove_root", "device": "a" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "root-missing", "when": "last" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "on-usb.txt", "text": "on the usb disk" },
      { "op": "drive_write", "device": "c", "path": "other.txt", "text": "the other pairing goes on" },
      { "op": "drive_sync", "device": "c" },
      { "op": "drive_check", "check": "remote_file", "remote": "r2", "key": "other.txt", "text": "the other pairing goes on" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "root-missing", "when": "last" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "on-usb.txt", "text": "on the usb disk" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-025: a pass paused in the middle on one device does not starve another device of the same drive",
    "description": "FILEN-025 (Filen): a pair paused mid-cycle held the account-wide lock and every other device starved until resume. Rule E6: never a global stall.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "slow.bin", "size": 100000, "seed": 4 },
      { "op": "drive_sync_bg", "device": "a", "pause_at": "before-upload" },
      { "op": "drive_write", "device": "b", "path": "b.txt", "text": "b goes on" },
      { "op": "drive_sync", "device": "b", "timeout_ms": 30000 },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "b.txt", "text": "b goes on" },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "slow.bin", "same_as": "{root:a}/slow.bin" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "b.txt", "text": "b goes on" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
