      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "notes.txt", "text": "v1" },
      { "op": "drive_fault", "device": "a", "clear": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "notes.txt", "text": "v2, pending" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "sign-in-needed", "absent": true, "when": "last" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_cleanup" }
    ]
