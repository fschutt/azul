[
  {
    "name": "a cleanup tool deletes the state database while AzDrive is stopped, another one is cut mid-write: rescans reconcile by hash, no duplicate, nothing deleted",
    "description": "KDRIVE-026 (kDrive): CCleaner or CleanMyMac deleting the client's database files led to 'problematic synchronisations'. Rules D5, D6 and A1: a lost or corrupted state says state-reset and pairs afresh by content hash; nothing is uploaded again, nothing deleted, no conflict copy. sync-chaos delete-state-lost.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "work", "count": 20, "text_prefix": "page" },
      { "op": "drive_write", "device": "a", "path": "z.txt", "text": "z" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "b", "path": "z.txt" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_wipe_state", "device": "a" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "state-reset" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 21 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 20 },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "z.txt", "count": 0 },
      { "op": "drive_corrupt_state", "device": "b" },
      { "op": "drive_restart", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.deleted", "equals": 0 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "state-reset" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 20 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a cloud-only file's stub copied into another pairing's folder is never uploaded as a stub",
    "description": "KDRIVE-026 (kDrive): 1 KB dehydrated placeholders copied out of the folder were used to seed a new sync. Rules P13 and A6: a copy of a cloud-only file is hydrated first or refused, never uploaded as a stub.",
    "pending": "drive_evict {device, path or glob} (make a file cloud-only) and drive_copy {device, from, to} (a plain file copy through the OS, as Explorer or Finder copies a placeholder)",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_create", "remote": "r2" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_open", "device": "c", "remote": "r2" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_pair", "device": "c" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "photo.jpg", "size": 300000, "seed": 261 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_evict", "device": "b", "path": "photo.jpg" },
      { "op": "drive_copy", "device": "b", "from": "photo.jpg", "to": "{root:c}/photo.jpg" },
      { "op": "drive_sync", "device": "c", "expect": "any" },
      { "op": "drive_check", "check": "remote_file", "remote": "r2", "key": "photo.jpg", "same_as": "{root:a}/photo.jpg" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "an Adobe-style save (the new file written beside, renamed over the old one, a backup left) is one update, no duplicate",
    "description": "KDRIVE-026 (kDrive): Infomaniak documents Photoshop, Illustrator and Lightroom producing duplicates when saving into the sync folder. Rules P10 and P11: an atomic save is one update; backup and swap files never go up; one file on the drive, no conflict copy. sync-chaos port-editor-save.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "art.psd", "size": 200000, "seed": 262 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_editor_save", "device": "a", "path": "art.psd", "text": "art v2", "style": "backup" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 1 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "art.psd", "text": "art v2" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 1 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "art.psd", "count": 0 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  }
]
