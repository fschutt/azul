[
  {
    "name": "FILEN-022: excluding a folder, a remote file under an excluded folder deleted elsewhere, and including again: nothing is deleted on either side at any step",
    "description": "FILEN-022 (Filen): an ignored local folder was deleted locally when it was trashed in the web UI; a re-included subtree read as deleted and its cloud copy was trashed. Rules P11 (excluding or including again deletes nothing), S16, D6. sync-chaos port-selective-sync (the engine's ignore file is .azcloudignore).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "build/\n" },
      { "op": "drive_write", "device": "a", "path": "keep/a.txt", "text": "kept" },
      { "op": "drive_write", "device": "a", "path": "build/out.bin", "text": "artifact" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "build/*", "count": 0 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "build/remote.bin", "text": "from a device without the rule", "writer": "old-pc" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "build/remote.bin", "absent": true },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "build/remote.bin" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "build/out.bin", "text": "artifact" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "# nothing excluded\n" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "keep/\n" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "build/out.bin", "text": "artifact" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "build/out.bin", "text": "artifact" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "keep/a.txt", "text": "kept" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "keep/a.txt", "text": "kept" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "keep/a.txt", "text": "kept" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "ignore-change" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-022: folders named like system folders deep in the tree (Software/Windows) sync with their files",
    "description": "FILEN-022 (Filen): the default ignore list matched any folder named 'Windows' anywhere, so Software/Windows was created empty in the cloud with no error. Rules P11 (only the systems' own bookkeeping is ignored), O1.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "Software/Windows/setup.txt", "text": "installer notes" },
      { "op": "drive_write", "device": "a", "path": "Archive/OS/Windows/readme.txt", "text": "old readme" },
      { "op": "drive_write", "device": "a", "path": "Archive/OS/System32/notes.txt", "text": "notes" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "Software/Windows/setup.txt", "text": "installer notes" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "Archive/OS/Windows/readme.txt", "text": "old readme" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Software/Windows/setup.txt", "text": "installer notes" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Archive/OS/Windows/readme.txt", "text": "old readme" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Archive/OS/System32/notes.txt", "text": "notes" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-022: a negated rule (node_modules/ but !keep/node_modules/) syncs the re-included subtree and deletes nothing",
    "description": "FILEN-022 (Filen): 'node_modules' with '!keep/node_modules/' read the re-included subtree as deleted and trashed its cloud copy. Rules P11, S16, D6.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "node_modules/\n!keep/node_modules/\n" },
      { "op": "drive_write", "device": "a", "path": "node_modules/x.js", "text": "ignored" },
      { "op": "drive_write", "device": "a", "path": "keep/node_modules/y.js", "text": "kept" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "keep/node_modules/y.js", "text": "kept" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "node_modules/x.js", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "keep/node_modules/y.js", "text": "kept" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "node_modules/x.js", "text": "ignored" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "keep/node_modules/y.js", "text": "kept" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-022: a folder rule ('build/') does not hide a file of the same name when the folder is replaced by a file",
    "description": "FILEN-022 (Filen): a dir rule 'build/' with the dir later replaced by a file 'build': the file never synced. Rules P11 (a trailing slash matches folders only), O1.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "build/\n" },
      { "op": "drive_write", "device": "a", "path": "build/out.bin", "text": "artifact" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rmtree", "device": "a", "path": "build" },
      { "op": "drive_write", "device": "a", "path": "build", "text": "now a file" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "build", "text": "now a file" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "build", "text": "now a file" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-022: user files whose names contain the engine's own bookkeeping names mid-name sync once and never loop",
    "description": "FILEN-022 (Filen): a user file containing '.filen.trash.local' mid-name re-downloaded every cycle. Rules S17 (only .azlin/ at the root is the engine's), P11, D4.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "report.azlin.sync.trash.txt", "text": "mine" },
      { "op": "drive_write", "device": "a", "path": "projects/.azlin/notes.txt", "text": "not the root's .azlin" },
      { "op": "drive_write", "device": "a", "path": "notes.azcloudignore.bak", "text": "a backup of an ignore file" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "report.azlin.sync.trash.txt", "text": "mine" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "projects/.azlin/notes.txt", "text": "not the root's .azlin" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "report.azlin.sync.trash.txt", "text": "mine" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "projects/.azlin/notes.txt", "text": "not the root's .azlin" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "notes.azcloudignore.bak", "text": "a backup of an ignore file" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-022: editing the ignore file on one machine sends nothing but the ignore file",
    "description": "FILEN-022 (Filen): editing .filenignore on one machine re-uploaded 2000 unchanged files (20 GB) as new versions. Rules P11, P12 (nothing unchanged is sent).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "*.log\n" },
      { "op": "drive_many", "device": "a", "dir": "lib", "count": 40, "size": 2000, "seed": 3 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "*.log\n*.bak\n" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 1 },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.down", "equals": 1 },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
