{
  "name": "FILEN-015: 0-byte files and empty folders at every depth exist on both sides, and a file truncated to 0 bytes syncs as 0 bytes",
  "description": "FILEN-015 (Filen): empty files were skipped ('Empty files are currently not supported at all'), backups incomplete, whole trees ignored. Rule P7: 0-byte files are real files, a truncation to 0 syncs as 0 bytes, empty folders are index entries. sync-chaos port-empty-folders, port-sparse-zero-byte.",
  "steps": [
    { "op": "drive_create", "remote": "r" },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": "pkg/__init__.py", "text": "" },
    { "op": "drive_write", "device": "a", "path": "a/b/c/empty.txt", "text": "" },
    { "op": "drive_write", "device": "a", "path": "backup/dedup.db", "text": "" },
    { "op": "drive_mkdir", "device": "a", "path": "empty/inner/deeper" },
    { "op": "drive_write", "device": "a", "path": "data.txt", "text": "content" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "pkg/__init__.py", "size": 0 },
    { "op": "drive_check", "check": "file", "device": "b", "path": "a/b/c/empty.txt", "size": 0 },
    { "op": "drive_check", "check": "file", "device": "b", "path": "backup/dedup.db", "size": 0 },
    { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "pkg/__init__.py", "text": "" },
    { "op": "drive_read", "device": "b", "path": "empty/inner/deeper" },
    { "op": "assert_response", "path": "result.kind", "equals": "dir" },
    { "op": "drive_overwrite_in_place", "device": "a", "path": "data.txt", "text": "" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "file", "device": "b", "path": "data.txt", "size": 0 },
    { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "data.txt", "text": "" },
    { "op": "drive_mkdir", "device": "b", "path": "from-b/empty" },
    { "op": "drive_write", "device": "b", "path": "from-b/zero.txt", "text": "" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "file", "device": "a", "path": "from-b/zero.txt", "size": 0 },
    { "op": "drive_read", "device": "a", "path": "from-b/empty" },
    { "op": "assert_response", "path": "result.kind", "equals": "dir" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
    { "op": "drive_check", "check": "converged" },
    { "op": "drive_cleanup" }
  ]
}
