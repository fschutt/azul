[
  {
    "name": "the same files deleted here and on the drive in one cycle converge: deleted on both, no re-download, no extra delete",
    "description": "PCLOUD-023 (pCloud): deleted files kept coming back (a resurrection loop) until the client deleted everything in the synced folders. Rules D2/D4/A3: idempotent convergence of two equal deletes.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "media", "count": 20, "text_prefix": "clip" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "a", "path": "media/d000/f000001.txt" },
      { "op": "drive_rm", "device": "a", "path": "media/d000/f000002.txt" },
      { "op": "drive_rm", "device": "a", "path": "media/d000/f000003.txt" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "media/d000/f000001.txt" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "media/d000/f000002.txt" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "media/d000/f000003.txt" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 17 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 17 },
      { "op": "drive_check", "check": "remote_count", "count": 17 },
      { "op": "trash", "check": "max_ops", "device": "a", "max": 0 },
      { "op": "trash", "check": "max_ops", "device": "b", "max": 3 },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "clip 1" },
      { "op": "drive_cleanup" }
    ]
  },
