[
  {
    "name": "FILEN-005: remote entries that cannot be read are unknown: the local copies stay, an unsynced local edit too",
    "description": "FILEN-005 (Filen): an entry whose metadata failed to decrypt, or a child without its parent folder, vanished from the remote tree and the local copies were deleted (permanent for unsynced edits). Rules D6, M1 (a bad entry is listed and frozen, never deleted), O1. sync-chaos delete-remote-entry-unreadable.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x" },
      { "op": "drive_write", "device": "a", "path": "y.txt", "text": "y" },
      { "op": "drive_write", "device": "a", "path": "z.txt", "text": "z" },
      { "op": "drive_write", "device": "a", "path": "w.txt", "text": "w" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "raw_entry", "key": "x.txt", "entry_json": "{\"hash\": \"bad tag\", \"size\": -1}" },
      { "op": "drive_tamper", "remote": "r", "action": "raw_entry", "key": "y.txt", "entry_json": "\"not even an object\"" },
      { "op": "drive_tamper", "remote": "r", "action": "raw_entry", "key": "z.txt", "entry_json": "{\"hash\": \"bad tag\", \"size\": -1}" },
      { "op": "drive_write", "device": "a", "path": "z.txt", "text": "z edited here, not synced yet" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "x.txt", "text": "x" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "y.txt", "text": "y" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "z.txt", "text": "z edited here, not synced yet" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "w.txt", "text": "w" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "remote-entry-unreadable", "key": "x.txt" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "remote-entry-unreadable", "key": "y.txt" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "x.txt", "text": "x" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "y.txt", "text": "y" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "remote-entry-unreadable", "key": "x.txt" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-005: on an encrypted drive, an entry that fails to decrypt and a folder whose entry is missing delete nothing here",
    "description": "FILEN-005 (Filen): the encrypted form of the trigger (a bad AEAD tag, a missing parent folder record). Rules D6, M1, M2.",
    "pending": "drive_tamper corrupt_entry / drop_folder on an encrypted remote: its entries live in sealed packs of the drive's metadata repository (a pack per change, sealed per chunk), so a server without the key damages a chunk, never one entry; the stand-in can aim at the chunk that holds a path once azul-storage's meta module tells which pack and chunk hold it (MetaRepo: path -> pointer blob -> pack, chunk)",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x" },
      { "op": "drive_write", "device": "a", "path": "photos/one.jpg", "text": "one" },
      { "op": "drive_write", "device": "a", "path": "photos/two.jpg", "text": "two" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "corrupt_entry", "key": "x.txt" },
      { "op": "drive_tamper", "remote": "r", "action": "drop_folder", "key": "photos" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "x.txt", "text": "x" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "photos/one.jpg", "text": "one" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "photos/two.jpg", "text": "two" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "remote-entry-unreadable", "key": "x.txt" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  }
]
