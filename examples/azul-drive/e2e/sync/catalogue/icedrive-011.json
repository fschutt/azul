[
  {
    "name": "a 64 MiB download from an encrypted drive cut mid-way, three times: never a truncated or 0-byte file under the real name",
    "description": "ICEDRIVE-011 (Icedrive): a 401 MB MP4 download from the encrypted area stopped at about 200 MB and left a corrupted file; the mobile app made a 0-byte file after 15 tries. Rules A5 (atomic download: a temp file beside the target, renamed in only when whole and its hash matches) and E5: a cut download leaves nothing under the final name and the old version whole, no temp file is left, and the next pass completes. sync-chaos mobile-restore, res-truncated-download.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "films/older.mp4", "size": 1048576, "seed": 32 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "films/video.mp4", "size": 67108864, "seed": 31 },
      { "op": "drive_write", "device": "a", "path": "films/older.mp4", "size": 67108864, "seed": 33 },
      { "op": "drive_sync", "device": "a", "timeout_ms": 600000 },
      { "op": "drive_sync", "device": "b", "pause_at": "download-start", "timeout_ms": 600000 },
      { "op": "drive_fault", "device": "b", "partition": true },
      { "op": "drive_cont", "device": "b" },
      { "op": "drive_wait", "device": "b", "expect": "any", "timeout_ms": 600000 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "films/video.mp4", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "films/older.mp4", "size": 1048576 },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["remote-offline", "transient"], "when": "last" },
      { "op": "drive_fault", "device": "b", "clear": true },
      { "op": "drive_sync", "device": "b", "pause_at": "download-start", "timeout_ms": 600000 },
      { "op": "drive_fault", "device": "b", "partition": true },
      { "op": "drive_cont", "device": "b" },
      { "op": "drive_wait", "device": "b", "expect": "any", "timeout_ms": 600000 },
      { "op": "drive_fault", "device": "b", "clear": true },
      { "op": "drive_sync", "device": "b", "pause_at": "download-start", "timeout_ms": 600000 },
      { "op": "drive_fault", "device": "b", "partition": true },
      { "op": "drive_cont", "device": "b" },
      { "op": "drive_wait", "device": "b", "expect": "any", "timeout_ms": 600000 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "films/video.mp4", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "films/older.mp4", "size": 1048576 },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_fault", "device": "b", "clear": true },
      { "op": "drive_sync", "device": "b", "timeout_ms": 600000 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "films/video.mp4", "same_as": "{root:a}/films/video.mp4" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "films/older.mp4", "same_as": "{root:a}/films/older.mp4" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "the server answers a short body as complete: the download is refused by its hash, the old version stays, no 0-byte file",
    "description": "ICEDRIVE-011 (Icedrive): a download that stopped half way was kept as the file. Rules A5, S15 and O1: a body cut at half (and one cut to 0 bytes) fails its hash, nothing is renamed in, the file is listed as hash-mismatch. sync-chaos res-truncated-download.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "video.mp4", "size": 4000000, "seed": 9 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "video.mp4", "size": 4000000, "seed": 10 },
      { "op": "drive_write", "device": "a", "path": "new.mov", "size": 2000000, "seed": 11 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "truncate_blob", "key": "video.mp4", "keep": 2000000 },
      { "op": "drive_tamper", "remote": "r", "action": "truncate_blob", "key": "new.mov", "keep": 0 },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "video.mp4" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "new.mov" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "video.mp4", "size": 4000000 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "new.mov", "absent": true },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  }
]
