[
  {
    "name": "a PC off for days comes back with its old unchanged copy: it downloads the newest version and never uploads the old one",
    "description": "KDRIVE-016 (kDrive): PC B, off for a few days while PC A edited Excel files, wrote its old copy over the newer server version in a loop until all 30 revisions held the old content. Rules C1, C3 and A3: an unchanged local file against a newer drive version is a download, never an upload; no conflict copy, no loop, every version kept on the drive. sync-chaos merge-versions-no-false-conflict.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "budget.xlsx", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "budget.xlsx", "text": "v2" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "a", "path": "budget.xlsx", "text": "v3" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "a", "path": "budget.xlsx", "text": "v4" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "a", "path": "budget.xlsx", "text": "v5" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_clock", "device": "b", "jump": 345600 },
      { "op": "drive_restart", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "assert_response", "path": "result.down", "equals": 1 },
      { "op": "assert_response", "path": "result.conflicts", "equals": 0 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "budget.xlsx", "text": "v5" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "budget.xlsx", "text": "v5" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "budget.xlsx", "text": "v5" },
      { "op": "drive_write", "device": "b", "path": "budget.xlsx", "text": "v6 from b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "b", "path": "budget.xlsx", "text": "v7 from b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "budget.xlsx", "text": "v7 from b" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "budget.xlsx", "count": 0 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "budget.xlsx", "count": 0 },
      { "op": "drive_check", "check": "kept", "texts": ["v1", "v2", "v3", "v4", "v5", "v6 from b"] },
      { "op": "drive_cleanup" }
    ]
  },
  {
