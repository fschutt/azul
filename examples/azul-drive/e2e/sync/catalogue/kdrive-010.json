  {
    "name": "a Windows junction to outside the root is a link, and a link synced to an exFAT root gets a per-item error",
    "description": "KDRIVE-010 (kDrive): junctions, and a junction downloaded onto a non-NTFS volume. Rules S5, S1 and O1. sync-chaos port-windows-ntfs.",
    "pending": "the sync keeps no links yet (MISS25-A): the engine needs link entries in the drive's index (a RemoteFile of kind 'link' with its relative target, behind an index feature 'links' so an older version leaves them alone), a scan that takes a relative link whose target stays inside the folder as such an entry under the pairing's link policy (SyncSetup.links: skip | in-root), the merge comparing a link by its target, and a download that makes the link through beneath (never through another link, refusing a target that leaves the folder); then drive_pair links: in-root and drive_tamper put kind: link (group B) drive it",
    "only_on": ["windows"],
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b", "fs": "exfat:64m", "links": "in-root" },
      { "op": "drive_wait_idle" },
      { "op": "drive_junction", "device": "a", "path": "junction", "target": "{outside}/victim" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["symlink-skipped", "link-refused"], "key": "junction" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "junction*", "count": 0 },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "in-root-link", "kind": "link", "target": "docs" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code_any": ["link-refused", "invalid-here"], "key": "in-root-link" },
      { "op": "drive_check", "check": "outside_untouched" },
      { "op": "drive_cleanup" }
    ]
  }
