[
  {
    "name": "links in the root (an accented name to a secret outside, a link to a subfolder) are listed and never followed",
    "description": "KDRIVE-010 (kDrive): symlinks with accented paths, links to folders and stat() that followed links gave broken links, errors and wrong dates. Rule S1: links in the root are inert: never followed when scanning or reading; with the strict default each is listed (symlink-skipped) and skipped; the secret behind one never reaches the drive. sync-chaos sec-remote-link-objects, sec-write-through-local-link.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "sub/file.txt", "text": "in sub" },
      { "op": "drive_symlink", "device": "a", "path": "l\u00e9-link", "target": "{outside}/secret.txt" },
      { "op": "drive_symlink", "device": "a", "path": "dirlink", "target": "sub" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "symlink-skipped", "key": "l\u00e9-link" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "symlink-skipped", "key": "dirlink" },
      { "op": "drive_check", "check": "remote_never_has", "remote": "r" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 1 },
      { "op": "drive_check", "check": "link", "device": "b", "path": "l\u00e9-link", "absent": true },
      { "op": "drive_check", "check": "link", "device": "b", "path": "dirlink", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "sub/file.txt", "text": "in sub" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 1 },
      { "op": "drive_check", "check": "outside_untouched" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "link objects from another device pointing out of the root are never created",
    "description": "KDRIVE-010 (kDrive): links synced as links. Rules S2, S8, M1 and O1: a remote link pointing out of the root (relative, absolute, /etc) is refused and listed (link-refused); nothing is written outside. sync-chaos sec-remote-link-objects.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "b", "path": "docs/a.txt", "text": "doc" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "escape1", "kind": "link", "target": "../../../outside/.ssh" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "escape2", "kind": "link", "target": "{outside}/.ssh" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "etc", "kind": "link", "target": "/etc" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "escape2/authorized_keys", "text": "ssh-ed25519 AAAA-the-attackers-key" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "outside_untouched" },
      { "op": "drive_check", "check": "link", "device": "b", "path": "escape1", "absent": true },
      { "op": "drive_check", "check": "link", "device": "b", "path": "escape2", "absent": true },
      { "op": "drive_check", "check": "link", "device": "b", "path": "etc", "absent": true },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "link-refused", "key": "escape1" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "link-refused", "key": "escape2" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "link-refused", "key": "etc" },
      { "op": "drive_cleanup" }
    ]
  },
  {
