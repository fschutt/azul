      { "op": "drive_write", "device": "b", "path": "docs/a.txt", "text": "doc" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "escape1", "kind": "link", "target": "../../../outside/.ssh" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "docs-alias", "kind": "link", "target": "docs" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "docs-alias/planted.txt", "text": "through a link" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "outside_untouched" },
      { "op": "drive_check", "check": "link", "device": "b", "path": "escape1", "absent": true },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "link-refused", "key": "escape1" },
      { "op": "drive_check", "check": "link", "device": "b", "path": "docs-alias" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "docs/planted.txt", "absent": true },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "through-link", "key": "docs-alias/planted.txt" },
