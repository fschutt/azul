[
  {
    "name": "FILEN-010: a file still being written goes up once, complete, after it is quiet; the other device never sees a half-written version",
    "description": "FILEN-010 (Filen): a file still being written (a download, a zip, a copy) was uploaded truncated and never again when it grew. Rules A6 (a file settles before it is sent), E2, D6 (a settling file is unknown). sync-chaos res-growing-file (the growth as appends between passes).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r", "settle_ms": 1500 },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "other.txt", "text": "other" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "export.mov", "text": "frame 1\n" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "export.mov", "absent": true },
      { "op": "drive_append", "device": "a", "path": "export.mov", "text": "frame 2\n" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "export.mov", "absent": true },
      { "op": "drive_append", "device": "a", "path": "export.mov", "text": "frame 3\n" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "settling", "key": "export.mov" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "export.mov", "absent": true },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "export.mov", "absent": true },
      { "op": "wait", "ms": 2500, "real": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "export.mov", "text": "frame 1\nframe 2\nframe 3\n" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "export.mov", "text": "frame 1\nframe 2\nframe 3\n" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "settling", "absent": true, "when": "last" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-010: a file edited after the scan saw it and before the pass ended is sent with the edit by the next pass",
    "description": "FILEN-010 (Filen): a file edited after the scanner lstat'd it but before the walk finished lost the edit until an unrelated change. Rules A6, E2 (a frozen pass re-checks before it writes).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "g.txt", "text": "first half" },
      { "op": "drive_sync_bg", "device": "a", "pause_at": "after-scan" },
      { "op": "drive_append", "device": "a", "path": "g.txt", "text": " and the second half" },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "g.txt", "text": "first half and the second half" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "g.txt", "text": "first half and the second half" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-010: a file that grows while it is read for upload never reaches the drive torn",
    "description": "FILEN-010 (Filen): a truncated version uploaded while the file grew. Rules A6, E5 (changed-during-sync).",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "big.log", "fill": "A", "size": 300000 },
      { "op": "drive_sync_bg", "device": "a", "pause_at": "mid-read" },
      { "op": "drive_append", "device": "a", "path": "big.log", "text": "tail added while it was read" },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "changed-during-sync", "key": "big.log" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "big.log", "same_as": "{root:a}/big.log" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "big.log", "same_as": "{root:a}/big.log" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  }
]
