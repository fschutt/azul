[
  {
    "name": "remote names with control characters, DEL, C1 codes, noncharacters or a backslash are refused once and listed; later passes do nothing for them",
    "description": "JOTTA-011 (Jottacloud): names with invalid UTF-8, a trailing U+00A0, noncharacters or backslashes made the sync loop (re-upload/retry forever). Rules P4 (refused everywhere: controls, DEL, C1, backslash, noncharacters), S8 and O1 (listed, never a retry loop). sync-chaos port-control-chars.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "bell\u0007.txt", "text": "c0" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "del\u007f.txt", "text": "del" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "nel\u0085.txt", "text": "c1" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "esc\u001b[31mred.txt", "text": "escape" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "back\\slash.txt", "text": "backslash" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "nonchar\ufffe.txt", "text": "fffe" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "nonchar\ufdd0.txt", "text": "fdd0" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "ok.txt", "text": "ok" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 1 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "ok.txt", "text": "ok" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "bad-remote-name", "key": "bell\u0007.txt", "when": "last" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "bad-remote-name", "key": "del\u007f.txt", "when": "last" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "bad-remote-name", "key": "nel\u0085.txt", "when": "last" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "bad-remote-name", "key": "nonchar\ufffe.txt", "when": "last" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "bad-remote-name", "key": "nonchar\ufdd0.txt", "when": "last" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_check", "check": "remote_puts", "device": "b", "max": 0 },
      { "op": "drive_counters", "device": "b" },
      { "op": "assert_response", "path": "result.ops.delete", "equals": 0 },
      { "op": "drive_status", "device": "b" },
      { "op": "assert_response", "path": "result.status", "contains": "azdrive-sync-status-skipped" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "names ending in a no-break space, a space or a dot are synced once and flagged only for Windows; no pass repeats them",
    "description": "JOTTA-011 (Jottacloud): separate fixes for a trailing 0xA0, trailing whitespace on Windows. Rules P3/P5 (valid here, synced here, listed for the system that cannot hold it) and D4 (no loop).",
    "only_on": ["macos", "linux"],
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "trail-nbsp\u00a0", "text": "nbsp" },
      { "op": "drive_write", "device": "a", "path": "trail-space ", "text": "space" },
      { "op": "drive_write", "device": "a", "path": "trail-dot.", "text": "dot" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 3 },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.down", "equals": 3 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "trail-nbsp\u00a0", "text": "nbsp" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "trail-space ", "text": "space" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "trail-dot.", "text": "dot" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "portability", "key": "trail-space " },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "portability", "key": "trail-dot." },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_check", "check": "remote_puts", "device": "a", "max": 3 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a local file whose name is not valid UTF-8 is listed as bad-name and never uploaded or retried in a loop",
    "description": "JOTTA-011 (Jottacloud): 'sync looping if file/folder names contain invalid utf8 characters' (fixed 2026-08). Rule P4 (invalid UTF-8 refused everywhere) and O1.",
    "only_on": ["linux"],
    "pending": "drive_write {\"device\": \"a\", \"path_hex\": \"696e76616c6964ff2e747874\", \"text\": \"not utf-8\"}: a file whose name is raw bytes (not UTF-8), Linux only",
    "expect": "fail",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path_hex": "696e76616c6964ff2e747874", "text": "not utf-8" },
      { "op": "drive_write", "device": "a", "path": "ok.txt", "text": "ok" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "bad-name", "when": "last" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 1 },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "remote_puts", "device": "a", "max": 1 },
      { "op": "drive_cleanup" }
    ]
  }
]
