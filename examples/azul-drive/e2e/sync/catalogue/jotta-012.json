{
  "name": "a folder whose name holds a newline is filtered like a file, and deleting it locally leaves nothing queued: no loop, not even after a restart",
  "description": "JOTTA-012 (Jottacloud): a directory named with a newline failed remote mkdir on every scan, and after its local deletion the daemon looped forever trying to delete the never-created remote folder. Rules P4 (controls refused everywhere, for folders as for files), O1 and D4 (no endless retry).",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_mkdir", "device": "a", "path": "a\nb" },
    { "op": "drive_write", "device": "a", "path": "a\nb/one.txt", "text": "one" },
    { "op": "drive_write", "device": "a", "path": "a\nb/two.txt", "text": "two" },
    { "op": "drive_write", "device": "a", "path": "fine.txt", "text": "fine" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "bad-name" },
    { "op": "drive_check", "check": "remote_count", "remote": "r", "count": 1 },
    { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "fine.txt", "text": "fine" },
    { "op": "drive_rmtree", "device": "a", "path": "a\nb" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_check", "check": "problem", "device": "a", "code": "bad-name", "absent": true, "when": "last" },
    { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
    { "op": "drive_restart", "device": "a" },
    { "op": "drive_sync", "device": "a" },
    { "op": "assert_response", "path": "result.up", "equals": 0 },
    { "op": "assert_response", "path": "result.deleted", "equals": 0 },
    { "op": "drive_status", "device": "a" },
    { "op": "assert_response", "path": "result.queued", "equals": false },
    { "op": "assert_response", "path": "result.status", "contains": "azdrive-sync-status-up-to-date" },
    { "op": "drive_counters", "device": "a" },
    { "op": "assert_response", "path": "result.ops.delete", "equals": 0 },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "files_count", "device": "b", "count": 1 },
    { "op": "drive_cleanup" }
  ]
}
