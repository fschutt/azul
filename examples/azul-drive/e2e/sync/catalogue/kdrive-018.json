[
  {
    "name": "600 photos at once arrive as 600 distinct files; a downloaded photo is never sent back up",
    "description": "KDRIVE-018 (kDrive): uploading 500+ photos at once created duplicates and missed some; a photo downloaded from the drive was re-uploaded by photo sync. Rules E7, A3 and E8: every file goes up exactly once, none overwrites another; a file that came down is in the base and is never uploaded again; the passes after settle.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "DCIM/100APPLE", "count": 600, "size": 4096, "seed": 181 },
      { "op": "drive_sync", "device": "a", "timeout_ms": 600000 },
      { "op": "assert_response", "path": "result.up", "equals": 600 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "DCIM/*", "count": 600 },
      { "op": "drive_sync", "device": "b", "timeout_ms": 600000 },
      { "op": "assert_response", "path": "result.down", "equals": 600 },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "DCIM/*", "count": 600 },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.up", "equals": 0 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
