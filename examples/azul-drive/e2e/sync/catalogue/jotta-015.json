      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "plan.txt", "text": "v4 from b" },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "plan.txt", "count": 0 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "plan.txt", "count": 0 },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "conflict-held", "absent": true },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "absent": true },
      { "op": "drive_cleanup" }
    ]
  }
