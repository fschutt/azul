[
  {
    "name": "a delete made on another device moves the file here into the trash, and the drive keeps the version",
    "description": "KOOFR-022 (Koofr): deletions from the server must not unlink local copies (Koofr's SyncTrash is the mitigation worth copying). Rule D2 (deletes are recoverable: the local trash, the drive's versions for 90 days) and D7 (logged). sync-chaos delete-goes-to-trash.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "contract.pdf", "text": "signed contract" },
      { "op": "drive_write", "device": "a", "path": "other.txt", "text": "other" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "a", "path": "contract.pdf" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "contract.pdf", "absent": true },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "signed contract" },
      { "op": "drive_check", "check": "kept", "texts": ["signed contract"] },
      { "op": "trash", "check": "max_ops", "device": "b", "max": 1 },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "contract.pdf", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "other.txt", "text": "other" },
      { "op": "drive_clock", "device": "b", "jump": 2592000 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "kept", "texts": ["signed contract"] },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "files deleted on the drive by someone else (the web, a script) go into this device's trash, never unlinked",
    "description": "KOOFR-022 (Koofr): a delete made on the server itself (web, another client) propagates here. Rule D2: it lands in the device's trash; D7: each move is logged.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "docs/one.txt", "text": "doc one" },
      { "op": "drive_write", "device": "a", "path": "docs/two.txt", "text": "doc two" },
      { "op": "drive_write", "device": "a", "path": "docs/three.txt", "text": "doc three" },
      { "op": "drive_write", "device": "a", "path": "docs/keep.txt", "text": "doc keep" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "docs/one.txt" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "docs/two.txt" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "docs/one.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "docs/two.txt", "absent": true },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "doc one" },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "doc two" },
      { "op": "trash", "check": "max_ops", "device": "b", "max": 2 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "docs/keep.txt", "text": "doc keep" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "the drive emptied from the web (every file deleted): held for the user, then the confirmed deletes go to the trash",
    "description": "KOOFR-022 (Koofr), the catalogue's 1,000-files form: a bulk delete on the server. Rule D1 (the mass-delete breaker holds it), then D2 (confirmed deletes land in the trash, never unlinked).",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "docs", "count": 30, "text_prefix": "doc" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "delete_all" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "mass-delete-held" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 30 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_answer", "device": "b", "question": "mass_delete", "delete_too": true },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 0 },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "doc 0" },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "doc 29" },
      { "op": "trash", "check": "max_ops", "device": "b", "max": 30 },
      { "op": "drive_cleanup" }
    ]
  }
]
