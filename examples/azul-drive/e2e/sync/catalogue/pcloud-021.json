[
  {
    "name": "KeePass's save (temp, old renamed aside, temp renamed in, old deleted) at 5 Hz uploads only the database",
    "description": "PCLOUD-021 (pCloud): '.kdbx.part' and '.kdbx-old.part' copies appeared and synced, ghost files downloaded endlessly, the second PC got nothing. Rules P10/D6/P11 (sync-chaos port-office-save-interrupted): an atomic save is one change, a pass mid-save deletes nothing, the side files never reach the drive.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
