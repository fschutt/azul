      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Passwords.kdbx", "text": "db v1" },
      { "op": "drive_rename", "device": "a", "from": "Passwords.kdbx.tmp", "to": "Passwords.kdbx" },
      { "op": "drive_rm", "device": "a", "path": "Passwords.kdbx.old" },
      { "op": "drive_sync_bg", "device": "a" },
      { "op": "wait", "ms": 200, "real": true },
      { "op": "drive_write", "device": "a", "path": "Passwords.kdbx.tmp", "text": "db v3" },
      { "op": "drive_rename", "device": "a", "from": "Passwords.kdbx", "to": "Passwords.kdbx.old" },
      { "op": "drive_rename", "device": "a", "from": "Passwords.kdbx.tmp", "to": "Passwords.kdbx" },
      { "op": "drive_rm", "device": "a", "path": "Passwords.kdbx.old" },
      { "op": "drive_sync_bg", "device": "a" },
      { "op": "wait", "ms": 200, "real": true },
      { "op": "drive_write", "device": "a", "path": "Passwords.kdbx.tmp", "text": "db v4" },
      { "op": "drive_rename", "device": "a", "from": "Passwords.kdbx", "to": "Passwords.kdbx.old" },
      { "op": "drive_rename", "device": "a", "from": "Passwords.kdbx.tmp", "to": "Passwords.kdbx" },
      { "op": "drive_rm", "device": "a", "path": "Passwords.kdbx.old" },
      { "op": "drive_sync_bg", "device": "a" },
      { "op": "wait", "ms": 200, "real": true },
      { "op": "drive_write", "device": "a", "path": "Passwords.kdbx.tmp", "text": "db v5" },
      { "op": "drive_rename", "device": "a", "from": "Passwords.kdbx", "to": "Passwords.kdbx.old" },
      { "op": "drive_rename", "device": "a", "from": "Passwords.kdbx.tmp", "to": "Passwords.kdbx" },
      { "op": "drive_rm", "device": "a", "path": "Passwords.kdbx.old" },
      { "op": "drive_sync_bg", "device": "a" },
      { "op": "wait", "ms": 200, "real": true },
      { "op": "drive_wait_idle", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_count", "count": 1 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 1 },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Passwords.kdbx", "text": "db v5" },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "Passwords.kdbx", "count": 0 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "save-in-progress" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
