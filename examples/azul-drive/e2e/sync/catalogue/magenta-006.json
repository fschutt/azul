[
  {
    "name": "another device keeps sending the same photos with new times: this device downloads nothing and trashes nothing",
    "description": "MAGENTA-006 (old MagentaCLOUD client on macOS with an iPhone app on the same account): the Mac re-synced for hours each day and sent thousands of files to the trash until the phone app was removed. Rules A3, P12 and D7: identity is content, so the same bytes with a new time are no change; no trash move without a real delete. sync-chaos delete-loop-detector, mobile-camera-upload.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "phone", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "phone" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "phone", "path": "DCIM/1.jpg", "size": 65536, "seed": 1 },
      { "op": "drive_write", "device": "phone", "path": "DCIM/2.jpg", "size": 65536, "seed": 2 },
      { "op": "drive_write", "device": "phone", "path": "DCIM/3.jpg", "size": 65536, "seed": 3 },
      { "op": "drive_sync", "device": "phone" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_utime", "device": "phone", "path": "DCIM/1.jpg", "mtime": 1700000000000000000 },
      { "op": "drive_utime", "device": "phone", "path": "DCIM/2.jpg", "mtime": 1700000000000000000 },
      { "op": "drive_sync", "device": "phone" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "drive_utime", "device": "phone", "path": "DCIM/1.jpg", "mtime": 1710000000000000000 },
      { "op": "drive_utime", "device": "phone", "path": "DCIM/3.jpg", "mtime": 1710000000000000000 },
      { "op": "drive_sync", "device": "phone" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "DCIM/2.jpg", "size": 65536, "seed": 2, "writer": "photo-app" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "max_ops", "change": "trash", "device": "a", "max": 0 },
      { "op": "drive_check", "check": "files_count", "device": "a", "glob": "DCIM/*", "count": 3 },
      { "op": "drive_cleanup" }
    ]
  },
  {
