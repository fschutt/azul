  {
    "name": "excluding a folder from this device and including it again deletes nothing and downloads nothing unchanged",
    "description": "MAGENTA-006 (selective sync of 3 GB of 500 GB on the Mac). Rule P11: excluding or including again deletes nothing, on this device or the drive.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "big", "count": 20, "text_prefix": "big" },
      { "op": "drive_write", "device": "a", "path": "small/notes.txt", "text": "notes" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_select", "device": "b", "exclude": ["big/*"] },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "glob": "big/*", "count": 20 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_select", "device": "b", "exclude": [] },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "big/*", "count": 20 },
      { "op": "drive_check", "check": "max_ops", "change": "trash", "device": "b", "max": 0 },
      { "op": "drive_cleanup" }
    ]
