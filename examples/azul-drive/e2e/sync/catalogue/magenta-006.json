      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "flap.txt", "text": "flip-flop" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "flap.txt" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "flap.txt", "text": "flip-flop" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
