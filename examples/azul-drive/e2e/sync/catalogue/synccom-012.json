      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "report.pdf", "text": "the victim's report" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "Report.pdf", "text": "the attacker's report" },
