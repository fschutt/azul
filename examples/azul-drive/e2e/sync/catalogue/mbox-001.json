[
  {
    "name": "a drive that refuses writes (the account moved) still sends its files down; the edits here wait and go up once it answers again, without a re-sync",
    "description": "MBOX-001 (mailbox.org OX Drive after the move to a new suite): the old URL answered 500 for writes, web files did not come down, the client paused itself for good and needed a fresh setup. Rules E6, O1 and D5: a failing upload is retried per file and listed, downloads go on, the pairing and its state are kept, and after the fault exactly the pending edits go up. sync-chaos res-credentials-revoked.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "notes.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_fault", "device": "a", "refuse_ops": ["put", "put_if"] },
      { "op": "drive_write", "device": "b", "path": "web.txt", "text": "made on the web" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "notes.txt", "text": "v2, pending" },
      { "op": "drive_write", "device": "a", "path": "new.txt", "text": "pending too" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["transient", "remote-offline", "other"], "when": "last" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "web.txt", "text": "made on the web" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "notes.txt", "text": "v2, pending" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_status", "device": "a" },
      { "op": "assert_response", "path": "result.status", "not_contains": "up-to-date" },
      { "op": "drive_fault", "device": "a", "clear": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 2 },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "state-reset", "absent": true },
      { "op": "drive_check", "check": "remote_file", "key": "notes.txt", "text": "v2, pending" },
      { "op": "drive_check", "check": "remote_file", "key": "new.txt", "text": "pending too" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a drive that answers 'moved permanently' is reported as moved, the folder and its queue are kept, and the pass resumes at the new address",
    "description": "MBOX-001: the client kept the old server URL. Rule O1 and D5: a moved server is a named state (not a silent pause), keeps the local tree and queue, and needs no full re-sync.",
    "pending": "drive_fault field moved (bool: every request answers 301 Moved Permanently to another base address, as an account moved to a new suite) and an engine problem code for it (the list has no 'server-moved')",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "notes.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_fault", "device": "a", "moved": true },
      { "op": "drive_write", "device": "a", "path": "notes.txt", "text": "v2, pending" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "server-moved", "when": "last" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "notes.txt", "text": "v2, pending" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_fault", "device": "a", "clear": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.up", "equals": 1 },
      { "op": "drive_check", "check": "remote_file", "key": "notes.txt", "text": "v2, pending" },
      { "op": "drive_cleanup" }
    ]
  }
]
