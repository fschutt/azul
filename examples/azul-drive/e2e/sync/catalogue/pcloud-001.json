[
  {
    "name": "one client, account A logged out and account B logged in: B's folder, index and problem list hold nothing of A",
    "description": "PCLOUD-001 (pCloud): other customers' folder trees (names, dates) appeared in users' pCloud Drive. Rule M2 (sync-chaos sec-never-mix-accounts): responses are keyed by account; nothing of one account reaches another.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r1", "encrypted": false },
      { "op": "drive_create", "remote": "r2", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r1", "device_name": "alice-mac" },
      { "op": "drive_open", "device": "b", "remote": "r2", "device_name": "bob-pc" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "alice-private/tax-2025.pdf", "text": "alice's tax return" },
      { "op": "drive_write", "device": "b", "path": "bob.txt", "text": "bob's file" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_unpair", "device": "a" },
      { "op": "drive_open", "device": "a2", "remote": "r2", "device_name": "alice-mac" },
      { "op": "drive_pair", "device": "a2" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a2" },
      { "op": "drive_check", "check": "file", "device": "a2", "path": "bob.txt", "text": "bob's file" },
      { "op": "drive_check", "check": "file", "device": "a2", "path": "alice-private/tax-2025.pdf", "absent": true },
      { "op": "drive_check", "check": "files_count", "device": "a2", "count": 1 },
      { "op": "drive_index", "remote": "r2" },
      { "op": "assert_response", "path": "result.files", "not_contains": "alice-private" },
      { "op": "drive_index", "remote": "r1" },
      { "op": "assert_response", "path": "result.files", "not_contains": "bob.txt" },
      { "op": "drive_problems", "device": "a2" },
      { "op": "assert_response", "path": "result.problems", "not_contains": "alice-private" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a listing the server answers with another account's index is dropped and reported",
    "description": "PCLOUD-001 (pCloud): an authorization edge case served foreign trees. Rule M2: a response for another account is dropped and listed; no node, name or time of it is shown or written.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r1", "encrypted": false },
      { "op": "drive_create", "remote": "r2", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r1", "device_name": "alice-mac" },
      { "op": "drive_open", "device": "b", "remote": "r2", "device_name": "bob-pc" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "alice-private/tax-2025.pdf", "text": "alice's tax return" },
      { "op": "drive_write", "device": "b", "path": "bob.txt", "text": "bob's file" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_open", "device": "a2", "remote": "r2" },
      { "op": "drive_pair", "device": "a2" },
      { "op": "drive_wait_idle" },
      { "op": "drive_fault", "device": "a2", "answer_from": "r1" },
      { "op": "drive_sync", "device": "a2", "expect": "any" },
      { "op": "drive_check", "check": "file", "device": "a2", "path": "alice-private/tax-2025.pdf", "absent": true },
      { "op": "drive_check", "check": "problem", "device": "a2", "code_any": ["remote-index-unreadable", "other"] },
      { "op": "drive_states", "device": "a2" },
      { "op": "assert_response", "path": "result.files", "not_contains": "alice-private" },
      { "op": "drive_cleanup" }
    ]
  }
]
