[
  {
    "name": "the first sync of a folder that already holds the drive's files makes no duplicates and no conflict",
    "description": "MBOX-010 (mailbox.org OX Drive for macOS and Windows): the first sync created duplicate files and folders. Rule C4: a first sync of two non-empty sides is a union where the same bytes agree; nothing is copied, nothing is deleted. sync-chaos delete-state-lost, state-upgrade-migration.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "docs/one.txt", "text": "one" },
      { "op": "drive_write", "device": "a", "path": "docs/two.txt", "text": "two" },
      { "op": "drive_write", "device": "a", "path": "photo.jpg", "size": 65536, "seed": 4 },
      { "op": "drive_many", "device": "a", "dir": "bulk", "count": 100, "size": 128, "seed": 9 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_write", "device": "b", "path": "docs/one.txt", "text": "one" },
      { "op": "drive_write", "device": "b", "path": "docs/two.txt", "text": "two" },
      { "op": "drive_write", "device": "b", "path": "photo.jpg", "size": 65536, "seed": 4 },
      { "op": "drive_many", "device": "b", "dir": "bulk", "count": 100, "size": 128, "seed": 9 },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.conflicts", "equals": 0 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "absent": true },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "docs/one.txt", "count": 0 },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "photo.jpg", "count": 0 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 103 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "assert_response", "path": "result.down", "equals": 0 },
      { "op": "drive_check", "check": "remote_count", "count": 103 },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "state left over from an earlier install is detected: the device pairs afresh, does not pause, deletes and duplicates nothing",
    "description": "MBOX-010 (trigger a): a reinstall with leftover state went straight to 'paused' until the files were removed by hand. Rules D5 and D6: lost or foreign state is reported (state-reset), and the rebuild by content hash deletes nothing on either side. sync-chaos delete-state-lost.",
    "pending": "an encrypted drive lists no deleted files (no tombstones the merge can read), so at a fresh pairing or a lost state a file the drive deleted meanwhile looks new here and is sent again (D5 on encrypted drives needs the drive's deletes from its history)",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": true },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "x.txt", "text": "x" },
      { "op": "drive_write", "device": "a", "path": "y.txt", "text": "y" },
      { "op": "drive_write", "device": "a", "path": "z.txt", "text": "z" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "b", "path": "z.txt" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_corrupt_state", "device": "a" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "state-reset" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 3 },
      { "op": "drive_check", "check": "remote_count", "count": 2 },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "x.txt", "count": 0 },
      { "op": "drive_status", "device": "a" },
      { "op": "assert_response", "path": "result.status", "not_contains": "paused" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "two accounts sync at the same time on one computer and never see each other's files",
    "description": "MBOX-010 (trigger c): OX Drive for Windows disabled parallel multi-account syncing because it could not guarantee it. Rule M2: each pairing's requests and state are keyed by its own drive; two pairings run side by side.",
    "steps": [
      { "op": "drive_create", "remote": "r1" },
      { "op": "drive_create", "remote": "r2" },
      { "op": "drive_open", "device": "a", "remote": "r1" },
      { "op": "drive_open", "device": "c", "remote": "r2" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "c" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "a-only.txt", "text": "account one" },
      { "op": "drive_write", "device": "c", "path": "c-only.txt", "text": "account two" },
      { "op": "drive_many", "device": "a", "dir": "bulk", "count": 200, "text_prefix": "one" },
      { "op": "drive_many", "device": "c", "dir": "bulk", "count": 200, "text_prefix": "two" },
      { "op": "drive_sync_bg", "device": "a" },
      { "op": "drive_sync_bg", "device": "c" },
      { "op": "drive_wait", "device": "a" },
      { "op": "drive_wait", "device": "c" },
      { "op": "drive_check", "check": "remote_file", "remote": "r1", "key": "a-only.txt", "text": "account one" },
      { "op": "drive_check", "check": "remote_file", "remote": "r2", "key": "a-only.txt", "absent": true },
      { "op": "drive_check", "check": "remote_file", "remote": "r2", "key": "c-only.txt", "text": "account two" },
      { "op": "drive_check", "check": "remote_file", "remote": "r1", "key": "c-only.txt", "absent": true },
      { "op": "drive_check", "check": "remote_count", "remote": "r1", "glob": "bulk/*", "count": 200 },
      { "op": "drive_check", "check": "remote_count", "remote": "r2", "glob": "bulk/*", "count": 200 },
      { "op": "drive_check", "check": "file", "device": "a", "path": "c-only.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "c", "path": "a-only.txt", "absent": true },
      { "op": "drive_cleanup" }
    ]
  }
]
