[
  {
    "name": "an announced point-in-time restore brings a deleted folder back on every device, and no device deletes it again",
    "description": "INFOMANIAK-007 (Infomaniak kDrive Rewind): a restore locked the whole drive for minutes, lost permanently deleted items and versions, and put conflicts in a 'Restore (date)' folder. Rules V4, V3 and D2: a point-in-time restore keeps trash and versions, is announced (a signed restore epoch), and the clients heal to it without deleting it again. sync-chaos srv-point-in-time-restore.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "docs", "count": 20, "text_prefix": "doc" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_snapshot", "remote": "r", "name": "t0" },
      { "op": "drive_rmtree", "device": "a", "path": "docs" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held" },
      { "op": "drive_answer", "device": "a", "question": "mass_delete", "delete_too": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "docs/*", "count": 0 },
      { "op": "drive_tamper", "remote": "r", "action": "restore", "to": "t0" },
      { "op": "drive_write", "device": "b", "path": "during-restore.txt", "text": "b keeps working" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "server-restored" },
      { "op": "drive_check", "check": "files_count", "device": "a", "glob": "docs/*", "count": 20 },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "docs/*", "count": 20 },
      { "op": "drive_check", "check": "remote_count", "glob": "docs/*", "count": 20 },
      { "op": "drive_check", "check": "file", "device": "a", "path": "during-restore.txt", "text": "b keeps working" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "the same older index put back without an announcement is refused, nothing is deleted or resurrected silently",
    "description": "INFOMANIAK-007: a restore must not be something a broken or hostile server can fake. Rules S15 and V3: an index older than the last one seen is refused (remote-rollback) unless an announced restore raised the restore epoch.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "docs", "count": 5, "text_prefix": "doc" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_snapshot", "remote": "r", "name": "t0" },
      { "op": "drive_write", "device": "a", "path": "later.txt", "text": "written after the snapshot" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "rollback", "to": "t0" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "remote-rollback" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "remote-rollback" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "later.txt", "text": "written after the snapshot" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "later.txt", "text": "written after the snapshot" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  }
]
