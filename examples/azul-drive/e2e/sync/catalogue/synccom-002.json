[
  {
    "name": "SYNCCOM-002: 40 of 50 files deleted at once are held until the user confirms; then they go to the other device's trash",
    "description": "SYNCCOM-002 (Sync.com): tens of thousands of files deleted overnight from hundreds of folders with no user deletes. Rules D1 (a mass-delete breaker that cannot be bypassed), D2, D7. sync-chaos delete-mass-delete-held.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "photos", "count": 50, "text_prefix": "photo" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "a", "glob": "photos/d000/f00000*" },
      { "op": "drive_rm", "device": "a", "glob": "photos/d000/f00001*" },
      { "op": "drive_rm", "device": "a", "glob": "photos/d000/f00002*" },
      { "op": "drive_rm", "device": "a", "glob": "photos/d000/f00003*" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "photos/*", "count": 50 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 50 },
      { "op": "drive_answer", "device": "a", "question": "mass_delete", "delete_too": true },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "photos/*", "count": 10 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 10 },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "photo 0" },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "photo 39" },
      { "op": "drive_check", "check": "kept", "texts": ["photo 0", "photo 39"] },
      { "op": "drive_check", "check": "max_ops", "device": "b", "change": "trash", "max": 40 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "SYNCCOM-002: the drive suddenly losing most files (no user delete here) is held on the device, nothing is emptied",
    "description": "SYNCCOM-002 (Sync.com): the mass delete came with no user deletion. Rules D1, D6.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "work", "count": 30, "text_prefix": "work" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_tamper", "remote": "r", "action": "delete_all" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "mass-delete-held" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 30 },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held" },
      { "op": "drive_check", "check": "files_count", "device": "a", "count": 30 },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "SYNCCOM-002: a confirmed mass delete is undone in one step by a restore of the drive to a time before it",
    "description": "SYNCCOM-002 (Sync.com): the deleted-files view restored only folder by folder, with 'purge' next to 'restore'. Rules D2 (the drive keeps tombstones and versions 90 days), V4 (point-in-time restore keeps everything, the clients converge without deletes). sync-chaos srv-point-in-time-restore.",
    "pending": "drive_tamper action 'restore' {to: a snapshot} (an announced restore of the drive): it fails until the stand-in remote has the server's restore announcement",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "docs", "count": 20, "text_prefix": "doc" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_snapshot", "remote": "r", "name": "t0" },
      { "op": "drive_rmtree", "device": "a", "path": "docs" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_answer", "device": "a", "question": "mass_delete", "delete_too": true },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "docs/*", "count": 0 },
      { "op": "drive_tamper", "remote": "r", "action": "restore", "to": "t0" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "a", "glob": "docs/*", "count": 20 },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "docs/*", "count": 20 },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "docs/*", "count": 20 },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "remote-rollback", "absent": true },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  }
]
