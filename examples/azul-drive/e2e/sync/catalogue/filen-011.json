[
  {
    "name": "FILEN-011: two files differing only in case on a case-sensitive disk both go up and both come down to another such disk",
    "description": "FILEN-011 (Filen): on Linux, Image01.JPG and Image01.jpg: only one was uploaded, the other silently skipped as a duplicate (4 of 150,000 photos lost). Rules P1 (case collisions are handled per target disk, nothing is skipped silently), O1.",
    "only_on": ["linux"],
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "Image01.JPG", "text": "upper" },
      { "op": "drive_write", "device": "a", "path": "Image01.jpg", "text": "lower" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "Image01.*", "count": 2 },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "Image01.JPG", "text": "upper" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "Image01.jpg", "text": "lower" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Image01.JPG", "text": "upper" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Image01.jpg", "text": "lower" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "name-collision", "absent": true },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-011: Report.txt and report.txt from a case-sensitive device reach a disk that ignores case: one comes down, the other is listed, nothing is overwritten",
    "description": "FILEN-011 (Filen): the case-insensitive side silently dropped or overwrote one of the pair and looped. Rules P1 (the one committed first comes down, the other is listed and stays on the drive), P5, O1. sync-chaos port-case-collision-remote (the remote half).",
    "only_on": ["macos", "windows"],
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "Report.txt", "text": "upper", "writer": "linux-pc" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "report.txt", "text": "lower", "writer": "linux-pc" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Report.txt", "text": "upper" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 1 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "name-collision", "key": "report.txt" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "Report.txt", "text": "upper" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "report.txt", "text": "lower" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-011: Report.txt and report.txt from the drive both come down to a case-sensitive disk",
    "description": "FILEN-011 (Filen): the pair must survive on every side. Rule P1.",
    "only_on": ["linux"],
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "Report.txt", "text": "upper", "writer": "linux-pc" },
      { "op": "drive_tamper", "remote": "r", "action": "put", "key": "report.txt", "text": "lower", "writer": "linux-pc" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "Report.txt", "text": "upper" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "report.txt", "text": "lower" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 2 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "name-collision", "absent": true },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-011: a different file under an existing name from another device is a conflict kept twice, never a silent replacement",
    "description": "FILEN-011 (Filen): uploading a different file under an existing name silently replaced it and hid it as an older version. Rule C1: never overwrite; AzDrive holds the conflict for the user and keep both makes one conflict copy.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "photo.jpg", "text": "a's photo" },
      { "op": "drive_write", "device": "b", "path": "photo.jpg", "text": "b's photo" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "assert_response", "path": "result.conflicts", "equals": 1 },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "conflict-held", "key": "photo.jpg" },
      { "op": "drive_resolve", "device": "b", "key": "photo.jpg", "choice": "both" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "conflict_copies", "device": "b", "path": "photo.jpg", "count": 1 },
      { "op": "drive_check", "check": "kept_live", "texts": ["a's photo", "b's photo"] },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-011: a case-only rename is a rename on both sides: no re-upload loop, no delete",
    "description": "FILEN-011 (Filen): case-only divergence caused endless re-upload and a spurious local delete on case-insensitive volumes. Rule P1: a case-only rename is a rename on both sides.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "notes.txt", "text": "notes" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rename", "device": "a", "from": "notes.txt", "to": "Notes.txt" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "Notes.txt", "text": "notes" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "*otes.txt", "count": 1 },
      { "op": "drive_list", "device": "b" },
      { "op": "assert_response", "path": "result.files", "contains": "\"Notes.txt\"" },
      { "op": "assert_response", "path": "result.files", "not_contains": "\"notes.txt\"" },
      { "op": "drive_check", "check": "trash_empty", "device": "b" },
      { "op": "drive_check", "check": "trash_empty", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  }
]
