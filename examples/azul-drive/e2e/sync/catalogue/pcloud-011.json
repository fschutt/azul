[
  {
    "name": "40 of 50 files deleted elsewhere are held until confirmed, then go to this device's trash and the drive's versions",
    "description": "PCLOUD-011 (pCloud): hundreds of local files vanished with nothing in the trash and no way to tell when. Rules D1/D2/D7 (sync-chaos delete-mass-delete-held): held, then recoverable and logged.",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "photos", "count": 50, "text_prefix": "photo" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rm", "device": "a", "glob": "photos/d000/f00000*" },
      { "op": "drive_rm", "device": "a", "glob": "photos/d000/f00001*" },
      { "op": "drive_rm", "device": "a", "glob": "photos/d000/f00002*" },
      { "op": "drive_rm", "device": "a", "glob": "photos/d000/f00003*" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "mass-delete-held" },
      { "op": "drive_check", "check": "remote_count", "glob": "photos/*", "count": 50 },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 50 },
      { "op": "drive_answer", "device": "a", "question": "mass_delete", "delete_too": true },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "remote_count", "glob": "photos/*", "count": 10 },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 10 },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "photo 0" },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "photo 39" },
      { "op": "drive_check", "check": "kept", "texts": ["photo 0", "photo 39"] },
      { "op": "trash", "check": "max_ops", "device": "b", "max": 40 },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "every delete the client makes is journaled with its time and reason and can be undone from the client",
    "description": "PCLOUD-011 (pCloud): files deleted from the computer with no record of when or why. Rule D7: every destructive step is in the operations log; D2: it is a move into the trash, reversible.",
    "pending": "drive_ops {\"device\":\"b\"} (the device's operations log as data: ops.jsonl entries with at, op, key, reason and the remote change applied; max_ops only bounds the count) and drive_untrash {\"device\":\"b\",\"path\":\"photos\"} (restore from the client's trash, as the window does)",
    "steps": [
      { "op": "drive_harness" },
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "photos", "count": 5, "text_prefix": "photo" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_rmtree", "device": "a", "path": "photos" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_answer", "device": "a", "question": "mass_delete", "delete_too": true },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_ops", "device": "b" },
      { "op": "assert_response", "path": "result.ops", "len": 5 },
      { "op": "assert_response", "path": "result.ops", "contains": "\"reason\"" },
      { "op": "assert_response", "path": "result.ops", "contains": "\"at\"" },
      { "op": "drive_untrash", "device": "b", "path": "photos" },
      { "op": "drive_check", "check": "files_count", "device": "b", "glob": "photos/*", "count": 5 },
      { "op": "drive_cleanup" }
    ]
  }
]
