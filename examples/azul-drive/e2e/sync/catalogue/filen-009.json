[
  {
    "name": "FILEN-009: a short body from the drive (a cut transfer reported as complete) is refused by its hash and stays listed; the old version stays, no 0-byte file",
    "description": "FILEN-009 (Filen): an aborted download resolved instead of failing, the short file was moved into place and recorded as synced, so it never downloaded again. Rules A5/S15 (every byte checked against its hash before the rename), P7 (a failed download never leaves a 0-byte file), O1. sync-chaos res-truncated-download.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "video.mp4", "text": "the old video, complete" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "video.mp4", "text": "the new video, also complete" },
      { "op": "drive_write", "device": "a", "path": "new.mov", "text": "a new movie" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "truncate_blob", "key": "video.mp4", "keep": 10 },
      { "op": "drive_tamper", "remote": "r", "action": "truncate_blob", "key": "new.mov", "keep": 0 },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "video.mp4" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "new.mov" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "video.mp4", "text": "the old video, complete" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "new.mov", "absent": true },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "video.mp4", "when": "last" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "video.mp4", "text": "the old video, complete" },
      { "op": "drive_base", "device": "b" },
      { "op": "assert_response", "path": "result.entries", "not_contains": "the new video" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-009: the connection drops during a download: the old file is intact, no temp file, and the next pass downloads it",
    "description": "FILEN-009 (Filen): the trigger 'kill the connection at 50 % of a download'. Rules A5, E5, E6.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "{run}/expected-v1.bin", "size": 3000000, "seed": 1 },
      { "op": "drive_write", "device": "a", "path": "big.bin", "size": 3000000, "seed": 1 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "big.bin", "size": 3000000, "seed": 2 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_fault", "device": "b", "cut_after_ops": 2 },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "big.bin", "same_as": "{run}/expected-v1.bin" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_fault", "device": "b", "clear": true },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "big.bin", "same_as": "{root:a}/big.bin" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-009: an upload that fails after the file was hashed is sent again by the next pass",
    "description": "FILEN-009 (Filen): an upload failed after its hash was written to the dedup cache, so every retry skipped the edit (permanent divergence). Rules A4/A7 (the base records only what the drive committed), E6, E8.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "f.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "f.txt", "text": "v2 edited" },
      { "op": "drive_fault", "device": "a", "refuse_ops": ["put", "put_if"] },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "f.txt", "text": "v1" },
      { "op": "drive_fault", "device": "a", "clear": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "f.txt", "text": "v2 edited" },
      { "op": "drive_write", "device": "a", "path": "f.txt", "text": "v3 edited" },
      { "op": "drive_sync", "device": "a", "crash_at": "after-blob", "expect": "crash" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "f.txt", "text": "v3 edited" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "f.txt", "text": "v3 edited" },
      { "op": "drive_check", "check": "remote_consistent", "remote": "r" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "FILEN-009: on an encrypted drive, a body that ends early and is reported as complete is refused and retried",
    "description": "FILEN-009 (Filen): the SDK resolved an aborted stream as a success. Rules A5, S15. truncate_blob works only on a plain remote, and no fault cuts a body mid-stream.",
    "pending": "drive_fault arg short_body_after_bytes (n) with report_ok (bool): a GET body ends after n bytes, as an error or (report_ok) as a short success; no fault cuts a body mid-stream and truncate_blob fails on an encrypted remote",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "video.mp4", "size": 3000000, "seed": 9 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "video.mp4", "size": 3000000, "seed": 10 },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_fault", "device": "b", "short_body_after_bytes": 1500000, "report_ok": true },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "video.mp4" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_fault", "device": "b", "clear": true },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "video.mp4", "same_as": "{root:a}/video.mp4" },
      { "op": "drive_cleanup" }
    ]
  }
]
