{
  "name": "a folder excluded by the ignore file stays excluded after the state is rebuilt (an upgrade), and an exclusion by rename takes effect",
  "description": "ICLOUD-015 (sync-chaos port-selective-sync, state-upgrade-migration): after the Sonoma upgrade iCloud's *.nosync exclusion stopped working and millions of excluded files started uploading. Rules P11, S16 and D5: the folder's ignore file decides, before and after a new local state (wiped and rebuilt as by an upgrade); nothing excluded goes up, nothing is listed as an error for it, and a folder renamed into an excluded name stops syncing without its local copy being touched.",
  "steps": [
    { "op": "drive_create", "remote": "r", "encrypted": false },
    { "op": "drive_open", "device": "a", "remote": "r" },
    { "op": "drive_open", "device": "b", "remote": "r" },
    { "op": "drive_pair", "device": "a" },
    { "op": "drive_pair", "device": "b" },
    { "op": "drive_wait_idle" },
    { "op": "drive_write", "device": "a", "path": ".azcloudignore", "text": "*.nosync/\n" },
    { "op": "drive_many", "device": "a", "dir": "repos.nosync", "count": 1000, "size": 64, "text_prefix": "object" },
    { "op": "drive_write", "device": "a", "path": "notes/todo.txt", "text": "synced" },
    { "op": "drive_sync", "device": "a", "timeout_ms": 300000 },
    { "op": "drive_check", "check": "remote_count", "glob": "repos.nosync/*", "count": 0 },
    { "op": "drive_check", "check": "remote_file", "key": ".azcloudignore", "text": "*.nosync/\n" },
    { "op": "drive_sync", "device": "b" },
    { "op": "drive_check", "check": "files_count", "device": "b", "glob": "repos.nosync/*", "count": 0 },
    { "op": "drive_wipe_state", "device": "a" },
    { "op": "drive_restart", "device": "a" },
    { "op": "drive_sync", "device": "a", "timeout_ms": 300000 },
    { "op": "assert_response", "path": "result.up", "equals": 0 },
    { "op": "drive_check", "check": "remote_count", "glob": "repos.nosync/*", "count": 0 },
    { "op": "drive_problems", "device": "a" },
    { "op": "assert_response", "path": "result.problems", "not_contains": "repos.nosync" },
    { "op": "drive_write", "device": "a", "path": "build/out.o", "text": "artifact" },
    { "op": "drive_sync", "device": "a" },
    { "op": "drive_rename", "device": "a", "from": "build", "to": "build.nosync" },
    { "op": "drive_sync", "device": "a", "expect": "any" },
    { "op": "drive_check", "check": "remote_count", "glob": "build.nosync/*", "count": 0 },
    { "op": "drive_check", "check": "file", "device": "a", "path": "build.nosync/out.o", "text": "artifact" },
    { "op": "drive_check", "check": "files_count", "device": "a", "glob": "repos.nosync/*", "count": 1000 },
    { "op": "drive_check", "check": "trash_empty", "device": "a" },
    { "op": "drive_cleanup" }
  ]
}
