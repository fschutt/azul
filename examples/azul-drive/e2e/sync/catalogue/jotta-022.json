[
  {
    "name": "the connection drops in the middle of 20 uploads: the drive's index never names a blob that is not there, and the next pass finishes",
    "description": "JOTTA-022 (Jottacloud): 'incomplete file uploads to not be retried' left files missing until a later patch. Rules E5 (the index never names a blob that is not stored) and A7 (blobs first, then the index). sync-chaos res-partition-mid-transfer.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_many", "device": "a", "dir": "up", "count": 20, "text_prefix": "part" },
      { "op": "drive_fault", "device": "a", "cut_after_ops": 8 },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "remote_consistent" },
      { "op": "drive_check", "check": "problem", "device": "a", "code_any": ["remote-offline", "transient"], "when": "last" },
      { "op": "drive_status", "device": "a" },
      { "op": "assert_response", "path": "result.status", "not_contains": "azdrive-sync-status-up-to-date" },
      { "op": "drive_fault", "device": "a", "clear": true },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_count", "remote": "r", "glob": "up/*", "count": 20 },
      { "op": "drive_check", "check": "remote_consistent" },
      { "op": "drive_status", "device": "a" },
      { "op": "assert_response", "path": "result.status", "contains": "azdrive-sync-status-up-to-date" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a pass cut at every upload step (after a blob, after the commit, mid-read, before the upload) and a download cut before its rename: every file is either up or still queued, never 'done' while partial",
    "description": "JOTTA-022 (Jottacloud): the catalogue's 'kill the daemon at random points during uploads'. Rules E8 (a kill at any moment converges in the next pass), A4/A5/A7. sync-chaos res-crash-points.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "f1.txt", "text": "one" },
      { "op": "drive_sync", "device": "a", "crash_at": "after-blob", "expect": "crash" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "f1.txt", "text": "one" },
      { "op": "drive_write", "device": "a", "path": "f2.txt", "text": "two" },
      { "op": "drive_sync", "device": "a", "crash_at": "after-commit", "expect": "crash" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "f2.txt", "text": "two" },
      { "op": "drive_write", "device": "a", "path": "f3.bin", "size": 300000, "seed": 22 },
      { "op": "drive_sync", "device": "a", "crash_at": "mid-read", "expect": "crash" },
      { "op": "drive_restart", "device": "a" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "f3.bin", "same_as": "{root:a}/f3.bin" },
      { "op": "drive_write", "device": "a", "path": "f4.txt", "text": "four" },
      { "op": "drive_sync", "device": "a", "crash_at": "before-upload", "expect": "crash" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b", "crash_at": "before-rename", "expect": "crash" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "no_temp_files", "device": "a" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_check", "check": "kept_live", "texts": ["one", "two", "four"] },
      { "op": "drive_check", "check": "remote_consistent" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "a stored revision that cannot be read is listed, not fetched forever; a newer revision replaces it",
    "description": "JOTTA-022 (Jottacloud): the old app could get stuck downloading the same invalid revision forever. Rules S15 (wrong bytes refused, named), E6 (per file, the rest goes on).",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "bad.txt", "text": "first revision" },
      { "op": "drive_write", "device": "a", "path": "good.txt", "text": "good" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "corrupt_blob", "key": "bad.txt" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_sync", "device": "b", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "key": "bad.txt", "when": "last" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "bad.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "good.txt", "text": "good" },
      { "op": "drive_check", "check": "no_temp_files", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "bad.txt", "text": "second revision" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "bad.txt", "text": "second revision" },
      { "op": "drive_check", "check": "problem", "device": "b", "code": "hash-mismatch", "absent": true, "when": "last" },
      { "op": "drive_cleanup" }
    ]
  }
]
