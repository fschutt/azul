[
  {
    "name": "a pass frozen between its plan and its commit while another device commits the same file: the compare-and-swap fails, the pass merges again, both versions stay",
    "description": "JOTTA-002 (Jottacloud): two runs into the same tree left tens of thousands of same-named duplicate folders in one parent (the server did not keep one entry per name). Rule A7 (the index is committed by compare-and-swap; the loser reads it again and merges) and C1 (never overwrite: AzDrive holds the clash for the user, keep both makes one copy). sync-chaos res-sleep-mid-commit.",
    "steps": [
      { "op": "drive_create", "remote": "r", "encrypted": false },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "shared.txt", "text": "v1" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_write", "device": "a", "path": "shared.txt", "text": "a's version" },
      { "op": "drive_sync", "device": "a", "pause_at": "before-upload" },
      { "op": "assert_response", "path": "result.outcome", "equals": "paused" },
      { "op": "drive_write", "device": "b", "path": "shared.txt", "text": "b's version" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_cont", "device": "a" },
      { "op": "drive_wait", "device": "a", "expect": "any" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a", "expect": "any" },
      { "op": "drive_check", "check": "problem", "device": "a", "code": "conflict-held", "key": "shared.txt" },
      { "op": "drive_resolve", "device": "a", "key": "shared.txt", "choice": "both" },
      { "op": "drive_wait_idle" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "kept_live", "texts": ["a's version", "b's version"] },
      { "op": "drive_check", "check": "conflict_copies", "device": "a", "path": "shared.txt", "count": 1 },
      { "op": "drive_check", "check": "remote_consistent" },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_cleanup" }
    ]
  },
