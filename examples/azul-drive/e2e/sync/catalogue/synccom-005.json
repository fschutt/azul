[
  {
    "name": "SYNCCOM-005: a member's device that was behind (offline, old state) reconnects: a file deleted elsewhere stays deleted and a moved one exists only at its new place",
    "description": "SYNCCOM-005 (Sync.com): deleted or moved files in shared folders reappeared daily at the original location from a not fully synced device. Rules A3 (moves), D2 (applied deletes go to that device's trash), E1; tombstones and moves win over stale local presence. sync-chaos merge-delete-folder-vs-new-file.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_open", "device": "b", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_pair", "device": "b" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "S/x.txt", "text": "x" },
      { "op": "drive_write", "device": "a", "path": "S/y.txt", "text": "y" },
      { "op": "drive_write", "device": "a", "path": "S/keep.txt", "text": "keep" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_fault", "device": "b", "partition": true },
      { "op": "drive_rm", "device": "a", "path": "S/x.txt" },
      { "op": "drive_rename", "device": "a", "from": "S/y.txt", "to": "S/z.txt" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_restart", "device": "b" },
      { "op": "drive_fault", "device": "b", "clear": true },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "file", "device": "b", "path": "S/x.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "S/y.txt", "absent": true },
      { "op": "drive_check", "check": "file", "device": "b", "path": "S/z.txt", "text": "y" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "S/x.txt", "absent": true },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "S/y.txt", "absent": true },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "S/z.txt", "text": "y" },
      { "op": "drive_check", "check": "trash_has", "device": "b", "text": "x" },
      { "op": "drive_check", "check": "files_count", "device": "b", "count": 2 },
      { "op": "drive_check", "check": "converged" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_sync", "device": "b" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "b" },
      { "op": "drive_cleanup" }
    ]
  },
  {
    "name": "SYNCCOM-005: someone the folder is shared with deletes a file in it: the owner's copy goes to the owner's trash and the drive keeps the version",
    "description": "SYNCCOM-005 (Sync.com): members deleting in shared folders. Rules D2 (a share participant's delete lands in the owner's trash and versions), M1. sync-chaos delete-share-participant-deletes.",
    "steps": [
      { "op": "drive_create", "remote": "r" },
      { "op": "drive_open", "device": "a", "remote": "r" },
      { "op": "drive_pair", "device": "a" },
      { "op": "drive_wait_idle" },
      { "op": "drive_write", "device": "a", "path": "shared/plan.md", "text": "the plan" },
      { "op": "drive_write", "device": "a", "path": "shared/budget.xlsx", "text": "the budget" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_tamper", "remote": "r", "action": "delete", "key": "shared/plan.md" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "file", "device": "a", "path": "shared/plan.md", "absent": true },
      { "op": "drive_check", "check": "trash_has", "device": "a", "text": "the plan" },
      { "op": "drive_check", "check": "kept", "texts": ["the plan"] },
      { "op": "drive_check", "check": "file", "device": "a", "path": "shared/budget.xlsx", "text": "the budget" },
      { "op": "drive_sync", "device": "a" },
      { "op": "drive_check", "check": "last_pass_quiet", "device": "a" },
      { "op": "drive_check", "check": "remote_file", "remote": "r", "key": "shared/plan.md", "absent": true },
      { "op": "drive_cleanup" }
    ]
  }
]
