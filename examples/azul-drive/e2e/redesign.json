[
  {
    "name": "azdrive_starts_as_the_rail_and_the_toggle_opens_the_source_list",
    "description": "AzDrive on the sidebar family: the window starts in Home with the sidebar as the icon rail, the location (the parents of the open place over the folder's name) in the File tab, the command line at the foot saying how the folder stands; the toggle at the foot of the rail opens the whole source list. There is no address row any more. The test leaves the source list open: the next ones use its rows.",
    "only_on": [
      "linux",
      "windows",
      "macos"
    ],
    "steps": [
      {
        "op": "resize",
        "width": 1100,
        "height": 760
      },
      {
        "op": "set_mode",
        "mode": "light"
      },
      {
        "op": "set_theme",
        "theme": "flora"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_settled"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-rail"
      },
      {
        "op": "assert_not_exists",
        "selector": ".__azul-native-sidebar-expanded"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-location"
      },
      {
        "op": "assert_exists",
        "selector": "#__azdrive_ribbon"
      },
      {
        "op": "assert_exists",
        "selector": "#__azdrive_command_bar"
      },
      {
        "op": "assert_not_exists",
        "selector": ".__azul-native-address-bar"
      },
      {
        "op": "assert_text",
        "selector": ".__azul-native-location-name",
        "expected": "Home"
      },
      {
        "op": "assert_text",
        "selector": "#__azdrive_command_bar_status",
        "expected": "6 items"
      },
      {
        "op": "print",
        "text": "SHOT The window at rest, in Home: the sidebar is the icon rail, the location (Home, with its pen and the dots) is the File tab, the folder in the middle, the preview at the right, the command line with the folder's status at the foot"
      },
      {
        "op": "take_screenshot"
      },
      {
        "op": "click",
        "selector": ".__azul-native-sidebar-toggle"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-expanded"
      },
      {
        "op": "assert_not_exists",
        "selector": ".__azul-native-sidebar-rail"
      },
      {
        "op": "find_node_by_text",
        "text": "Favorites"
      },
      {
        "op": "assert_response",
        "contains": "\"found\":true"
      },
      {
        "op": "find_node_by_text",
        "text": "Locations"
      },
      {
        "op": "assert_response",
        "contains": "\"found\":true"
      },
      {
        "op": "print",
        "text": "SHOT The toggle opened the source list: Favorites, Locations and Cloud, the status pies at its foot"
      },
      {
        "op": "take_screenshot"
      }
    ]
  },
  {
    "name": "azdrive_a_folder_row_of_the_sidebar_navigates_and_a_parent_of_the_location_goes_back",
    "description": "A click on a folder of the source list opens it and the location names it; a click on the first parent of the location (This PC) goes up to the overview.",
    "only_on": [
      "linux",
      "windows",
      "macos"
    ],
    "steps": [
      {
        "op": "resize",
        "width": 1100,
        "height": 760
      },
      {
        "op": "set_mode",
        "mode": "light"
      },
      {
        "op": "set_theme",
        "theme": "flora"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_settled"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-expanded"
      },
      {
