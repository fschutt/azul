      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_settled"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_text",
        "selector": ".__azul-native-location-name",
        "expected": "Documents"
