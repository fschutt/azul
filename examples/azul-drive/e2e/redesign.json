[
  {
    "name": "azdrive_starts_as_the_rail_and_the_toggle_opens_the_source_list",
    "description": "AzDrive on the sidebar family: the window starts in Home with the sidebar as the icon rail, the location (the parents of the open place over the folder's name) in the File tab, the command line at the foot saying how the folder stands; the toggle at the foot of the rail opens the whole source list and closes it again. There is no address row any more.",
    "only_on": [
      "linux",
      "windows",
      "macos"
    ],
    "steps": [
      {
        "op": "resize",
        "width": 1100,
        "height": 760
      },
      {
        "op": "set_mode",
        "mode": "light"
      },
      {
        "op": "set_theme",
        "theme": "flora"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-rail"
      },
      {
        "op": "assert_not_exists",
        "selector": ".__azul-native-sidebar-expanded"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-location"
      },
      {
        "op": "assert_exists",
        "selector": "#__azdrive_ribbon"
      },
      {
        "op": "assert_exists",
        "selector": "#__azdrive_command_bar"
      },
      {
        "op": "assert_exists",
        "selector": "#__azdrive_command_bar_status"
      },
      {
        "op": "assert_not_exists",
        "selector": ".__azul-native-address-bar"
      },
      {
        "op": "assert_text",
        "selector": ".__azul-native-location-name",
        "expected": "Home"
      },
      {
        "op": "take_screenshot"
      },
      {
        "op": "click",
        "selector": ".__azul-native-sidebar-toggle"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-expanded"
      },
      {
        "op": "assert_not_exists",
        "selector": ".__azul-native-sidebar-rail"
      },
      {
        "op": "find_node_by_text",
        "text": "Favorites"
      },
      {
        "op": "assert_response",
        "contains": "\"found\":true"
      },
      {
        "op": "find_node_by_text",
        "text": "Locations"
      },
      {
        "op": "assert_response",
        "contains": "\"found\":true"
      },
      {
        "op": "take_screenshot"
      },
      {
        "op": "click",
        "selector": ".__azul-native-sidebar-toggle"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-rail"
      }
    ]
  },
  {
