[
  {
    "name": "azreader_phone_taps",
    "description": "On a phone: the page over the whole screen; a tap in the middle shows the toolbar and the slider, a tap on the right side turns the page, a tap in the middle again hides them.",
    "only_on": ["android", "ios"],
    "steps": [
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "azreader_open_sample"},
      {"op": "azreader_wait", "for": "chapter"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azreader_reading"},
      {"op": "assert_exists", "selector": "#__azreader_zone-middle"},
      {"op": "assert_not_exists", "selector": "#__azreader_toolbar"},
      {"op": "assert_not_exists", "selector": "#__azreader_slider"},
      {"op": "print", "text": "frame: the page fills the screen, no controls"},
      {"op": "take_screenshot"},
      {"op": "click", "selector": "#__azreader_zone-middle"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azreader_toolbar"},
      {"op": "assert_exists", "selector": "#__azreader_slider"},
      {"op": "print", "text": "frame: a tap in the middle: the toolbar over the page and the slider under it"},
      {"op": "take_screenshot"},
      {"op": "click", "selector": "#__azreader_zone-right"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "print", "text": "frame: a tap on the right side: the next page"},
      {"op": "take_screenshot"},
      {"op": "click", "selector": "#__azreader_zone-left"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "click", "selector": "#__azreader_zone-middle"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_not_exists", "selector": "#__azreader_toolbar"},
      {"op": "assert_not_exists", "selector": "#__azreader_slider"}
    ]
  }
]
