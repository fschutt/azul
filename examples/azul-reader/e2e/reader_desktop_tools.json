[
  {
    "name": "azreader_desktop_tools",
    "description": "The reader's toolbar on a desktop: the zoom (100 % to 110 % and back), the fit button, the strip with the pages, the contents and the bookmarks (a bookmark made and listed), the strip closed, a copy of the book and the chapter as a PDF (the exports recorded: no dialog under e2e), back to the library.",
    "only_on": ["linux", "macos", "windows"],
    "steps": [
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "azreader_open_sample"},
      {"op": "azreader_wait", "for": "chapter"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azreader_toolbar"},
      {"op": "assert_exists", "selector": "#__azreader_tb-zoom-in"},
      {"op": "assert_exists", "selector": "#__azreader_tb-fit"},
      {"op": "assert_exists", "selector": "#__azreader_tb-download"},
      {"op": "assert_exists", "selector": "#__azreader_tb-print"},
      {"op": "assert_exists", "selector": "#__azreader_strip"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the reader on a desktop: toolbar, strip of pages, the page"},
      {"op": "take_screenshot"},
      {"op": "click", "selector": "#__azreader_tb-zoom-in"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "find_node_by_text", "text": "110 %"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "click", "selector": "#__azreader_tb-zoom-out"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "find_node_by_text", "text": "100 %"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "click", "selector": "#__azreader_tb-fit"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the fit button went on to one page"},
      {"op": "take_screenshot"},
      {"op": "click", "selector": "#__azreader_strip-contents"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azreader_toc"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the strip lists the contents"},
      {"op": "take_screenshot"},
      {"op": "click", "selector": "#__azreader_strip-bookmarks"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azreader_bookmarks"},
      {"op": "click", "selector": "#__azreader_tb-bookmark"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: a bookmark on the page, the strip lists it"},
      {"op": "take_screenshot"},
      {"op": "click", "selector": "#__azreader_strip-pages"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "click", "selector": "#__azreader_tb-strip"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_not_exists", "selector": "#__azreader_strip"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the strip closed: the page has the window"},
      {"op": "take_screenshot"},
      {"op": "mock", "set": {"reset": true, "save_bytes": {"accept": true}}},
      {"op": "click", "selector": "#__azreader_tb-download"},
      {"op": "azreader_wait", "for": "notice"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_saved_file", "name_ends_with": ".epub", "mime": "application/epub+zip", "min_len": 1000},
      {"op": "find_node_by_text", "text": "alice-sample.epub"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: a copy of the book saved (the notice under the pages)"},
      {"op": "take_screenshot"},
      {"op": "click", "selector": "#__azreader_tb-print"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_saved_file", "name_ends_with": ".pdf", "mime": "application/pdf", "min_len": 500, "contains": "%PDF"},
      {"op": "click", "selector": "#__azreader_tb-library"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azreader_library"}
    ]
  }
]
