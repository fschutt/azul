[
  {
    "name": "azul_code_phone_small_drawer_sheet_keys_host",
    "description": "AzCode in a 360 x 640 window (off), as a phone shows it: the editor is the screen, the explorer a drawer over a scrim, the panel a sheet from the bottom, a key row over the keyboard's place, one status bar line. Pictures, in order: 1 first look, 2 the drawer (explorer), 3 the file in the editor, 4 the key row, 5 the panel's sheet, 6 drawn up, 7 pushed down, 8 the terminal in the sheet (a host's), 9 source control, 10 run, 11 light.",
