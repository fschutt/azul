[
  {
    "name": "azul_code_phone_pixel8_drawer_sheet_keys_host",
    "description": "AzCode in a 411 x 914 window (pixel8), as a phone shows it: the editor is the screen, the explorer a drawer over a scrim, the panel a sheet from the bottom, a key row over the keyboard's place, one status bar line. Pictures, in order: 1 first look, 2 the drawer (explorer), 3 the file in the editor, 4 the key row, 5 an edit (braces typed by the key row: the top bar has Save), 6 the panel's sheet, 7 drawn up, 8 pushed down to its peek, 9 the terminal in the sheet (a host's), 10 source control, 11 run, 12 light.",
    "only_on": [
      "linux",
      "macos",
      "windows"
    ],
