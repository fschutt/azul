[
  {
    "name": "azul_maps_back_steps_out_one_view_at_a_time_desktop",
    "description": "Back (an Escape) in a 1280 x 800 window: the way goes to its place, the place to the search, the search's text goes (no pictures).",
    "only_on": [
      "linux",
      "macos",
      "windows"
    ],
    "steps": [
      {
        "op": "set_display_preset",
        "preset": "off"
      },
      {
        "op": "resize",
        "width": 1280.0,
        "height": 800.0
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_settled"
      },
      {
        "op": "set_mode",
        "mode": "light"
      },
      {
        "op": "wait",
        "ms": 3000,
        "real": true
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "click",
        "selector": "#__azmaps_search"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "text_input",
        "text": "Stuttgart"
      },
      {
        "op": "wait",
        "ms": 600,
        "real": true
      },
      {
        "op": "tick_ms",
        "ms": 300
      },
      {
        "op": "wait",
        "ms": 900,
        "real": true
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "tick_ms",
        "ms": 200
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "click",
        "selector": "#__azmaps_suggestion-0"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": "#__azmaps_place"
      },
      {
        "op": "click",
        "selector": "#__azmaps_place-route"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": "#__azmaps_travel"
      },
      {
        "op": "key_down",
        "key": "Escape"
      },
      {
        "op": "key_up",
        "key": "Escape"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": "#__azmaps_place"
      },
      {
        "op": "assert_not_exists",
        "selector": "#__azmaps_travel"
      },
      {
        "op": "key_down",
        "key": "Escape"
      },
      {
        "op": "key_up",
        "key": "Escape"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": "#__azmaps_chips"
      },
      {
        "op": "assert_not_exists",
        "selector": "#__azmaps_place"
      },
      {
        "op": "assert_exists",
        "selector": "#__azmaps_search-clear"
      },
      {
        "op": "key_down",
        "key": "Escape"
      },
      {
        "op": "key_up",
        "key": "Escape"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_not_exists",
        "selector": "#__azmaps_search-clear"
      }
    ]
  }
]
