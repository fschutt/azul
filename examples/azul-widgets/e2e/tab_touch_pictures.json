[
  {
    "name": "azul_widgets_touch_tabs_pictures_a_strip_in_the_status_bar_around_the_camera",
    "description": "The pictures of the tab strip in the status bar's band (QA's contact sheet: tabs/): the window is a Pixel 8 (411 x 914 dp) with the camera in the middle, then an iPhone with the Dynamic Island, light and dark, flat and flora, a pill far along the row selected (the row scrolls to put it whole in a lane), the phone on its side, and the same page with no phone. Every picture is a CPU render of the window at rest. The assertions are the page's own: they keep the scenario honest on every platform.",
    "steps": [
      { "op": "resize", "width": 411, "height": 914 },
      { "op": "set_mode", "mode": "light" },
      { "op": "set_theme", "theme": "flat" },
      { "op": "wait_frame" },
      { "op": "scroll_into_view", "text": "A phone to try it on", "block": "center", "behavior": "instant" },
      { "op": "wait_frame" },
      { "op": "click", "text": "Pixel 8" },
      { "op": "wait_frame" },
      { "op": "wait_frame" },
      { "op": "wait_settled" },
      { "op": "get_display_features" },
      { "op": "assert_response", "contains": "\"preset\":\"pixel8\"" },
      { "op": "take_screenshot" },

      { "op": "click", "text": "Design" },
      { "op": "wait_frame" },
      { "op": "wait_frame" },
      { "op": "wait_settled" },
      { "op": "find_node_by_text", "text": "Design panel" },
      { "op": "assert_response", "contains": "\"found\":true" },
      { "op": "take_screenshot" },

      { "op": "click", "text": "Account" },
      { "op": "wait_frame" },
      { "op": "wait_frame" },
      { "op": "wait_settled" },
      { "op": "take_screenshot" },

      { "op": "set_mode", "mode": "dark" },
      { "op": "wait_frame" },
      { "op": "wait_frame" },
      { "op": "wait_settled" },
      { "op": "take_screenshot" },

      { "op": "set_theme", "theme": "flora" },
      { "op": "wait_frame" },
      { "op": "wait_frame" },
      { "op": "wait_settled" },
      { "op": "take_screenshot" },

      { "op": "set_mode", "mode": "light" },
      { "op": "click", "text": "iPhone 16 Pro" },
      { "op": "wait_frame" },
      { "op": "wait_frame" },
      { "op": "wait_settled" },
      { "op": "get_display_features" },
      { "op": "assert_response", "contains": "\"shape\":\"Pill\"" },
      { "op": "take_screenshot" },

      { "op": "resize", "width": 852, "height": 393 },
      { "op": "wait_frame" },
      { "op": "wait_frame" },
      { "op": "wait_settled" },
      { "op": "take_screenshot" },

      { "op": "resize", "width": 411, "height": 914 },
      { "op": "click", "text": "No phone" },
      { "op": "wait_frame" },
      { "op": "wait_frame" },
      { "op": "wait_settled" },
      { "op": "get_display_features" },
      { "op": "assert_response", "contains": "\"preset\":\"off\"" },
      { "op": "scroll_into_view", "text": "A phone to try it on", "block": "center", "behavior": "instant" },
      { "op": "wait_frame" },
      { "op": "wait_settled" },
      { "op": "take_screenshot" }
    ]
  }
]
