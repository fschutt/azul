        "expect": [{ "accelerator": "Cmd+Shift+K", "status": "active", "owner": "window" }]
      },
      { "op": "global_hotkey", "accelerator": "Cmd+Shift+K" },
      { "op": "wait_frame" },
      { "op": "find_node_by_text", "text": "1 time(s) since it was enabled" },
      { "op": "click", "text": "Disable Cmd+Shift+K" },
      { "op": "wait_frame" },
      {
        "op": "assert_global_hotkeys",
        "expect": [{ "accelerator": "Cmd+Shift+K", "status": "not_registered" }]
      },
      { "op": "global_hotkey_answer", "accelerator": "Cmd+Shift+K", "answer": "taken" },
      { "op": "click", "text": "Enable Cmd+Shift+K" },
      { "op": "wait_frame" },
      {
        "op": "assert_global_hotkeys",
        "expect": [{ "accelerator": "Cmd+Shift+K", "status": "taken", "owner": "window" }]
      },
      { "op": "click", "text": "Retry Cmd+Shift+K" },
