[
  {
    "name": "azul_widgets_tab_overflow_fades_at_the_lanes_in_a_phone_sized_window",
    "description": "Twelve touch pills in the status bar's band (Pixel 8, then an iPhone with the island): at rest, dragged 150 px, 300 px and to the end. A pill that slides out of a lane fades out at the lane's edge (the window's edge, the camera's cover) and the row shows no scrollbar; at rest and at the end the first and the last pill stand beyond the fade. Frames: Pixel 8 x4, Pixel 8 dark, iPhone x4, in this order. Flora first. The window is resized to the phone's size: desktop hosts only.",
    "only_on": [
      "linux",
      "windows",
      "macos"
    ],
    "steps": [
      {
        "op": "resize",
        "width": 411,
        "height": 914
      },
      {
        "op": "set_mode",
        "mode": "light"
      },
      {
        "op": "set_theme",
        "theme": "flora"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "scroll_into_view",
        "text": "A phone to try it on",
        "block": "center",
        "behavior": "instant"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "click",
        "text": "Pixel 8"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "tick_ms",
        "ms": 600
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "get_display_features"
      },
      {
        "op": "assert_response",
        "contains": "\"preset\":\"pixel8\""
      },
      {
        "op": "get_scrollable_nodes"
      },
      {
        "op": "assert_response",
        "contains": "\"can_scroll_x\":true"
      },
      {
