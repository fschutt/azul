  {
    "name": "azul_widgets_a_dialog_with_a_text_field_on_a_phone",
    "description": "The modal Dialog 'Rename file...' (a title, a text field, two buttons) of a window with ONE surface (a phone, the emulator or the Simulator): shown as a bottom sheet over its scrim; a press on the text field puts the soft keyboard up and the sheet stands ON it, not behind it (the scrim's bottom padding is the keyboard's height); Escape closes it. The first picture is the sheet at rest, the second the sheet over the keyboard (the engine's frame has the room the keyboard takes; the recording of the run has the keyboard itself).",
    "config": {
      "continue_on_failure": true
    },
    "steps": [
      {
        "op": "set_mode",
        "mode": "light"
      },
      {
        "op": "set_theme",
        "theme": "flora"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "scroll_into_view",
        "text": "Rename file…",
        "block": "center",
        "behavior": "instant"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "click",
        "text": "Rename file…"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_settled"
      },
      {
        "op": "list_popups"
      },
      {
        "op": "assert_response",
        "contains": "\"shown\":\"overlay\""
      },
      {
        "op": "assert_response",
        "contains": "\"covers_window\":true"
      },
      {
        "op": "assert_response",
        "contains": "\"top\":true"
      },
      {
        "op": "take_screenshot"
      },
      {
        "op": "click",
        "selector": "#rename-field"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait",
        "ms": 1500,
        "real": true
      },
      {
        "op": "wait_settled"
      },
      {
        "op": "list_popups"
      },
      {
        "op": "assert_response",
        "contains": "\"covers_window\":true"
      },
      {
        "op": "assert_response",
        "contains": "\"top\":true"
      },
      {
        "op": "take_screenshot"
      },
      {
        "op": "key_down",
        "key": "Escape"
      },
      {
        "op": "key_up",
        "key": "Escape"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "list_popups"
      },
      {
        "op": "assert_response",
        "not_contains": "\"shown\":\"overlay\""
      }
    ],
    "only_on": [
      "android",
      "ios"
    ]
  },
