[
  {
    "name": "azul_widgets_the_sidebar_starts_as_the_rail_and_the_toggle_opens_it",
    "description": "The Sidebar section of AzWidgets: the frame every heavy app shares. The sidebar starts as the icon rail (the collapsed state every app starts in); the toggle at the bottom of the rail opens it, the toggle of the expanded sidebar closes it; the 16 px handle exists as a state and a click on it brings the rail back. Each press is reported to the app (the line under the frame).",
    "only_on": [
      "linux",
      "windows",
      "macos"
    ],
    "steps": [
      {
        "op": "resize",
        "width": 1100,
        "height": 900
      },
      {
        "op": "set_mode",
        "mode": "light"
      },
      {
        "op": "set_theme",
        "theme": "flora"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "scroll_into_view",
        "selector": "#sidebar-demo-frame",
        "block": "center",
        "behavior": "instant"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-rail"
      },
      {
        "op": "assert_not_exists",
        "selector": ".__azul-native-sidebar-expanded"
      },
      {
        "op": "click",
        "selector": ".__azul-native-sidebar-toggle"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-expanded"
      },
      {
        "op": "assert_not_exists",
        "selector": ".__azul-native-sidebar-rail"
      },
      {
        "op": "find_node_by_text",
        "text": "Last report: the sidebar asks for state 0"
      },
      {
        "op": "assert_response",
        "contains": "\"found\":true"
      },
      {
        "op": "click",
        "selector": ".__azul-native-sidebar-toggle"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-rail"
      },
      {
        "op": "find_node_by_text",
        "text": "Last report: the sidebar asks for state 1"
      },
      {
        "op": "assert_response",
        "contains": "\"found\":true"
      },
      {
        "op": "click",
        "selector": "#sidebar-state-handle"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-handle"
      },
      {
        "op": "click",
        "selector": ".__azul-native-sidebar-grab"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-rail"
      },
      {
        "op": "find_node_by_text",
        "text": "Last report: the sidebar asks for state 1"
      },
      {
        "op": "assert_response",
        "contains": "\"found\":true"
      }
    ]
  },
