[
  {
    "name": "azcalculator_programmer",
    "description": "The programmer calculator, in a window wide and tall enough for it (720 x 560): its tab, 255 in every base, light and dark; and in a window of a small phone's size there is no tab for it (the bits and the word size need room and a pointer's precision). Host only: it resizes the window.",
    "only_on": ["linux", "macos", "windows"],
    "steps": [
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "set_display_preset", "preset": "off"},
      {"op": "resize", "width": 720, "height": 560},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azcalc_view"},
      {"op": "assert_exists", "selector": "#__azcalc_programmer"},
      {"op": "click", "text": "Standard"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_not_exists", "selector": "#__azcalc_programmer"},
      {"op": "assert_exists", "selector": "#__azcalc_keypad"},
      {"op": "click", "text": "Programmer"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azcalc_programmer"},
      {"op": "azcalculator_type", "text": "255"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the programmer calculator: 255 in every base"},
      {"op": "take_screenshot"},
      {"op": "set_mode", "mode": "dark"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the programmer calculator in the dark mode"},
      {"op": "take_screenshot"},
      {"op": "set_mode", "mode": "light"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "resize", "width": 360, "height": 640},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "find_node_by_text", "text": "Programmer"},
      {"op": "assert_response", "contains": "\"found\":false"},
      {"op": "assert_exists", "selector": "#__azcalc_keypad"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: a window too small for the programmer calculator has no tab for it and shows the standard one"},
      {"op": "take_screenshot"},
      {"op": "resize", "width": 340, "height": 560},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"}
    ]
  }
]
