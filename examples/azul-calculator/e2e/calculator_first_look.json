[
  {
    "name": "azcalculator_first_look",
    "description": "The first look of the standard calculator and what a calculation does: 12 x 7, a division by zero (an error, not a crash), 0.1 + 0.2 (exactly 0.3). Typed through the app's own e2e op, which does what the keyboard does, so that the same file runs on a desktop and on a phone.",
    "steps": [
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azcalc_view"},
      {"op": "assert_exists", "selector": "#__azcalc_display"},
      {"op": "assert_exists", "selector": "#__azcalc_keypad"},
      {"op": "assert_exists", "selector": "#__azcalc_memory-row"},
      {"op": "print", "text": "frame: the standard calculator, first look (the mode tabs, the display, the memory row, the keypad)"},
      {"op": "take_screenshot"},
      {"op": "azcalculator_type", "text": "12*7="},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "find_node_by_text", "text": "84"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "print", "text": "frame: 12 x 7 = 84"},
      {"op": "take_screenshot"},
      {"op": "azcalculator_type", "text": "/0="},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "find_node_by_text", "text": "Cannot divide"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "print", "text": "frame: a division by zero says so and does not crash"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "escape", "modifiers": {}},
      {"op": "key_up", "key": "escape", "modifiers": {}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "azcalculator_type", "text": "0.1+0.2="},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "find_node_by_text", "text": "0.3"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "print", "text": "frame: 0.1 + 0.2 = 0.3 (exact decimals)"},
      {"op": "take_screenshot"}
    ]
  }
]
