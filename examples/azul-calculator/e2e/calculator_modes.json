[
  {
    "name": "azcalculator_modes",
    "description": "The modes a window of any size has, through their tabs: Standard, Date, Convert, light, and again in the dark mode. The tabs are what the user's idea asked for: one tap, the current mode always shown. (The programmer and the graphing modes need a wider window: calculator_programmer.json, calculator_sizes.json.)",
    "steps": [
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azcalc_view"},
      {"op": "assert_exists", "selector": "#__azcalc_keypad"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the standard calculator and its mode tabs"},
      {"op": "take_screenshot"},
      {"op": "click", "text": "Date"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azcalc_date-view"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the date calculator"},
      {"op": "take_screenshot"},
      {"op": "click", "text": "Convert"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azcalc_convert-view"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the unit converter"},
      {"op": "take_screenshot"},
      {"op": "click", "text": "Standard"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azcalc_keypad"},
      {"op": "set_mode", "mode": "dark"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the standard calculator in the dark mode"},
      {"op": "take_screenshot"},
      {"op": "click", "text": "Date"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the date calculator in the dark mode"},
      {"op": "take_screenshot"},
      {"op": "click", "text": "Convert"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the unit converter in the dark mode"},
      {"op": "take_screenshot"},
      {"op": "click", "text": "Standard"},
      {"op": "set_mode", "mode": "light"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"}
    ]
  }
]
