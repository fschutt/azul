[
  {
    "name": "azmail_the_sidebar_is_the_folder_pane_and_collapses_to_an_18_px_rail",
    "description": "The main window of AzMail on a desktop (the sample account, 1280 x 860): the full-height sidebar is the folder pane (the account's address over its folders with their counts, the four module buttons), the tab strip is the title bar, the Preview is docked at the right. The toggle at the foot collapses the sidebar to the 18 px rail, with the app's quick-access buttons at its bottom; the toggle brings it back.",
    "only_on": [
      "linux",
      "macos",
      "windows"
    ],
    "steps": [
      {
        "op": "resize",
        "width": 1280,
        "height": 860
      },
      {
        "op": "set_mode",
        "mode": "light"
      },
      {
        "op": "set_theme",
        "theme": "flora"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": "#__azmail_ribbon"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-expanded"
      },
      {
        "op": "assert_not_exists",
        "selector": ".__azul-native-app-frame-rail"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-preview-right"
      },
      {
        "op": "assert_not_exists",
        "selector": ".__azul-native-preview-bottom"
      },
      {
        "op": "find_node_by_text",
        "text": "ada@example.org"
      },
      {
        "op": "assert_response",
        "contains": "\"found\":true"
      },
      {
        "op": "find_node_by_text",
        "text": "Inbox"
      },
      {
        "op": "assert_response",
        "contains": "\"found\":true"
      },
      {
        "op": "find_node_by_text",
        "text": "Sent Items"
      },
      {
        "op": "assert_response",
        "contains": "\"found\":true"
      },
      {
        "op": "find_node_by_text",
        "text": "Calendar"
      },
      {
        "op": "assert_response",
        "contains": "\"found\":true"
      },
      {
        "op": "click",
        "selector": ".__azul-native-sidebar-toggle"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-rail"
      },
      {
        "op": "assert_layout",
        "selector": ".__azul-native-sidebar-rail",
        "property": "width",
        "expected": 18,
        "tolerance": 0.6
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-quick-button"
      },
      {
        "op": "take_screenshot"
      },
      {
        "op": "click",
        "selector": ".__azul-native-sidebar-toggle"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "wait_frame"
      },
      {
        "op": "assert_exists",
        "selector": ".__azul-native-sidebar-expanded"
      }
    ]
  },
  {
