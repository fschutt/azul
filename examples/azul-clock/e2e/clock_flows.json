[
  {
    "name": "azclock_flows",
    "description": "What a person does with the clock, in the window itself (the editor and the city search are pages, so the same file runs on a desktop and on a phone): switch an alarm, make one in the editor, add a city from the search, start a timer from a preset, run the stopwatch with a lap, open the settings.",
    "steps": [
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "azclock_load_sample"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_node_count", "selector": ".__azclock_alarm-row", "expected": 3},
      {"op": "click", "selector": ".__azclock_alarm-switch"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the first alarm switched off (dimmed)"},
      {"op": "take_screenshot"},
      {"op": "click", "selector": ".__azclock_alarm-switch"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "click", "selector": "#__azclock_new"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azclock_editor"},
      {"op": "assert_exists", "selector": "#__azclock_editor-save"},
      {"op": "assert_exists", "selector": "#__azclock_editor-time"},
      {"op": "assert_node_count", "selector": ".__azclock_editor-day", "expected": 7},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the alarm editor (a page pushed over the list, Back and Save in the top bar)"},
      {"op": "take_screenshot"},
      {"op": "click", "text": "Weekdays"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "click", "text": "Sat"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the Weekdays preset and the Saturday chip: Monday to Saturday lit"},
      {"op": "take_screenshot"},
      {"op": "click", "selector": "#__azclock_editor-save"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_node_count", "selector": ".__azclock_alarm-row", "expected": 4},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: a fourth alarm"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "2", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "2", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_node_count", "selector": ".__azclock_city-row", "expected": 4},
      {"op": "click", "selector": "#__azclock_new"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azclock_city-query"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the add-city page (a search over every zone)"},
      {"op": "take_screenshot"},
      {"op": "click", "selector": "#__azclock_city-query"},
      {"op": "text_input", "text": "lima"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "find_node_by_text", "text": "Lima - America/Lima"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the search found Lima"},
      {"op": "take_screenshot"},
      {"op": "click", "text": "Lima - America/Lima"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_node_count", "selector": ".__azclock_city-row", "expected": 5},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: Lima added to the clock place"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "3", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "3", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "click", "text": "25 min"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_node_count", "selector": ".__azclock_timer-row", "expected": 3},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: a 25 min timer started from its preset"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "4", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "4", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "click", "text": "Reset"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "find_node_by_text", "text": "00:00:00.00"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "click", "text": "Start"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "wait", "ms": 1200},
      {"op": "click", "text": "Lap"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "click", "text": "Stop"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_node_count", "selector": ".__azclock_lap-row", "expected": 1},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the stopwatch ran, took a lap and stopped"},
      {"op": "take_screenshot"},
      {"op": "click", "selector": "#__azclock_settings"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#appkit-settings"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: the settings page"},
      {"op": "take_screenshot"}
    ]
  }
]
