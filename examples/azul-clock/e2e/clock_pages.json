[
  {
    "name": "azclock_pages_with_the_sample",
    "description": "The four places with the sample data (three alarms, two timers, four cities, five laps), light and then dark, one picture each. The sample comes through the app's own e2e op (azclock_load_sample): a phone has no command line for --sample. The Alarm place is chosen explicitly first: an app keeps the place it was left on, and the phones run the files one after the other on one installation.",
    "steps": [
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "azclock_load_sample"},
      {"op": "assert_response", "contains": "\"alarms\":3"},
      {"op": "key_down", "key": "1", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "1", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_node_count", "selector": ".__azclock_alarm-row", "expected": 3},
      {"op": "assert_exists", "selector": "#__azclock_next-alarm"},
      {"op": "print", "text": "frame: alarm place, sample, light"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "2", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "2", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_node_count", "selector": ".__azclock_city-row", "expected": 4},
      {"op": "assert_exists", "selector": "#__azclock_place"},
      {"op": "print", "text": "frame: clock place, sample, light"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "3", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "3", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_node_count", "selector": ".__azclock_timer-row", "expected": 2},
      {"op": "assert_exists", "selector": "#__azclock_timer-ring"},
      {"op": "print", "text": "frame: timer place, sample, light"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "4", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "4", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_node_count", "selector": ".__azclock_lap-row", "expected": 5},
      {"op": "find_node_by_text", "text": "04:17.36"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "print", "text": "frame: stopwatch place, sample, light"},
      {"op": "take_screenshot"},
      {"op": "set_mode", "mode": "dark"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "print", "text": "frame: stopwatch place, sample, dark"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "3", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "3", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "print", "text": "frame: timer place, sample, dark"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "2", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "2", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "print", "text": "frame: clock place, sample, dark"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "1", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "1", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "print", "text": "frame: alarm place, sample, dark"},
      {"op": "take_screenshot"},
      {"op": "set_mode", "mode": "light"},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"}
    ]
  }
]
