[
  {
    "name": "azclock_first_look",
    "description": "The first start with no data: the Alarm place with its empty state and the floating +, then the Clock, Timer and Stopwatch places (Alt+1 to Alt+4 are the bottom bar's four places), back to Alarm. The time stands big at the top of the Alarm and Clock places; every place has its own page.",
    "steps": [
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azclock_big-time"},
      {"op": "assert_exists", "selector": "#__azclock_header"},
      {"op": "assert_exists", "selector": "#__azclock_new"},
      {"op": "find_node_by_text", "text": "No alarms yet"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: alarm place, first start, no data (empty state, the floating +)"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "2", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "2", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azclock_world-view"},
      {"op": "find_node_by_text", "text": "No cities yet"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: clock place, first start"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "3", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "3", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azclock_timer-view"},
      {"op": "find_node_by_text", "text": "No timer yet"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: timer place, first start"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "4", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "4", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azclock_stopwatch-view"},
      {"op": "find_node_by_text", "text": "00:00:00.00"},
      {"op": "assert_response", "contains": "\"found\":true"},
      {"op": "wait", "ms": 800},
      {"op": "print", "text": "frame: stopwatch place, first start"},
      {"op": "take_screenshot"},
      {"op": "key_down", "key": "1", "modifiers": {"alt": true}},
      {"op": "key_up", "key": "1", "modifiers": {"alt": true}},
      {"op": "wait_frame"},
      {"op": "wait_frame"},
      {"op": "wait_settled"},
      {"op": "assert_exists", "selector": "#__azclock_alarms-view"}
    ]
  }
]
