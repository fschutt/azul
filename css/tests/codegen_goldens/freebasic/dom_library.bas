Declare Sub AzAppConfigAddComponentLibraryFn Cdecl Alias "AzAppConfig_addComponentLibrary" (ByVal appConfig As AzAppConfig Ptr, ByVal libraryName As AzString, ByVal registerFn As AzRegisterComponentLibraryFnType)

' Registers the library `user` on the app config at appConfig.
Sub AddUserLibrary(ByVal appConfig As AzAppConfig Ptr)
