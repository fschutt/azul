    fields(0) = StringField("title", "Hello", "Text of the <h2>")
    fields(1) = StringField("text", "Some text", "Text of the <p>")
    fields(2) = StringField("href", "https://azul.rs", "`href` of the <a>")
    fields(3) = StringField("author", "me", "Text of the <span>")
    Dim d As AzComponentDef
    d.id = AzComponentId_create(CssStr("user"), CssStr("card"))
    d.display_name = CssStr("Card")
    d.description = CssStr("Converted from a <div> subtree in AzBuilder")
    ' The CSS is applied per node by RenderCard.
    d.css = CssStr("")
    d.source = AzComponentSource_UserDefined
    d.data_model.name = CssStr("CardData")
    d.data_model.description = CssStr("Converted from a <div> subtree in AzBuilder")
    d.data_model.fields = AzComponentDataFieldVec_copyFromPtr(@fields(0), 4)
    ' copyFromPtr cloned them.
    For i As Integer = 0 To 3
        AzComponentDataField_delete(@fields(i))
    Next
    d.render_fn = @CardRenderFn
    d.codegen = AzComponentCodegen_renderFunction()
    d.render_fn_source = AzOptionString_none()
    Return d
End Function

' The component library `user` (the function libazul calls).
Function RegisterUserLibrary Cdecl () As AzComponentLibrary
    Dim defs(0 To 0) As AzComponentDef
    defs(0) = CardDef()
    Dim library As AzComponentLibrary
    library.name = CssStr("user")
    library.version = CssStr("0.1.0")
    library.description = CssStr("Exported from AzBuilder")
    library.components = AzComponentDefVec_copyFromPtr(@defs(0), 1)
    ' copyFromPtr cloned them.
    For i As Integer = 0 To 0
        AzComponentDef_delete(@defs(i))
    Next
    library.exportable = 1
    library.modifiable = 0
    library.data_models = AzComponentDataModelVec_create()
    library.enum_models = AzComponentEnumModelVec_create()
    Return library
End Function

