#include once "azul.bi"

Function CssStr(ByRef s As Const String) As AzString
    Return AzString_copyFromBytes(CPtr(UByte Ptr, StrPtr(s)), 0, Len(s))
End Function

' `user:card`: its texts and its link are parameters
Function RenderCard(ByRef title As Const String = "Hello", ByRef text As Const String = "Some text", ByRef href As Const String = "https://azul.rs", ByRef author As Const String = "me") As AzDom
    Dim t1 As AzDom
    t1 = AzDom_withCss(AzDom_createDiv(), CssStr("padding: 8px"))
    t1 = AzDom_withClass(t1, CssStr("card"))
    t1 = AzDom_withChild(t1, AzDom_createH2WithText(CssStr(title)))
    t1 = AzDom_withChild(t1, AzDom_createPWithText(CssStr(text)))
    t1 = AzDom_withChild(t1, AzDom_createA(CssStr(href), CssStr("Read more"), AzSmallAriaInfo_label(CssStr("Read more"))))
    t1 = AzDom_withChild(t1, AzDom_createSpanWithText(CssStr("by " & author)))
    Return t1
End Function

