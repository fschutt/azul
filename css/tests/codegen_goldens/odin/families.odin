// CSS: .content
style_content :: proc() -> azul.AzCssPropertyWithConditionsVec {
	return azul.AzCssPropertyWithConditionsVec_copyFromPtr(&[]azul.AzCssPropertyWithConditions{
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_content(azul.AzContent{inner = css_str("\"Hello\"")})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_counterReset(azul.AzCounterReset{counter_name = css_str("section"), value = 1})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_counterIncrement(azul.AzCounterIncrement{counter_name = css_str("section"), value = 1})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_listStyleType(azul.AzStyleListStyleType.UpperRoman)),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_listStylePosition(azul.AzStyleListStylePosition.Inside)),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_stringSet(azul.AzStringSet{inner = css_str("title \"Chapter\"")})),
	}[0], 6)
}

// CSS: .anim
style_anim :: proc() -> azul.AzCssPropertyWithConditionsVec {
	return azul.AzCssPropertyWithConditionsVec_copyFromPtr(&[]azul.AzCssPropertyWithConditions{
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_animation(azul.AzStyleAnimationVecValue{Exact = {tag = 6, payload = azul.AzStyleAnimationVec_copyFromPtr(&[]azul.AzStyleAnimation{azul.AzStyleAnimation{name = css_str("fadeIn"), duration = azul.AzCssDuration{inner = 300, unit = azul.AzCssDurationUnit.Milliseconds}, delay = azul.AzCssDuration{inner = 0, unit = azul.AzCssDurationUnit.Milliseconds}, iterations = azul.AzAnimationIterationCount_count(1), timing = azul.AzAnimationTiming_easeInOut(), clip = true}}[0], 1)}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_animationIn(azul.AzStyleAnimationVecValue{Exact = {tag = 6, payload = azul.AzStyleAnimationVec_copyFromPtr(&[]azul.AzStyleAnimation{azul.AzStyleAnimation{name = css_str("flyInLeft"), duration = azul.AzCssDuration{inner = 500, unit = azul.AzCssDurationUnit.Milliseconds}, delay = azul.AzCssDuration{inner = 0, unit = azul.AzCssDurationUnit.Milliseconds}, iterations = azul.AzAnimationIterationCount_count(1), timing = azul.AzAnimationTiming_spring(), clip = true}}[0], 1)}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_animationOut(azul.AzStyleAnimationVecValue{Exact = {tag = 6, payload = azul.AzStyleAnimationVec_copyFromPtr(&[]azul.AzStyleAnimation{azul.AzStyleAnimation{name = css_str("fadeOut"), duration = azul.AzCssDuration{inner = 200, unit = azul.AzCssDurationUnit.Milliseconds}, delay = azul.AzCssDuration{inner = 0, unit = azul.AzCssDurationUnit.Milliseconds}, iterations = azul.AzAnimationIterationCount_count(1), timing = azul.AzAnimationTiming_linear(), clip = true}}[0], 1)}})),
	}[0], 3)
}
