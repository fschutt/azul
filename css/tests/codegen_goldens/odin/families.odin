		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_borderBottomStyle(azul.AzStyleBorderBottomStyle{inner = azul.AzBorderStyle.Dotted})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_borderLeftStyle(azul.AzStyleBorderLeftStyle{inner = azul.AzBorderStyle.Double})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_borderTopWidth(azul.AzLayoutBorderTopWidth{inner = azul.AzPixelValue_px(1.0)})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_borderRightWidth(azul.AzLayoutBorderRightWidth{inner = azul.AzPixelValue_px(2.0)})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_borderBottomWidth(azul.AzLayoutBorderBottomWidth{inner = azul.AzPixelValue_px(3.0)})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_borderLeftWidth(azul.AzLayoutBorderLeftWidth{inner = azul.AzPixelValue_px(4.0)})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_boxShadowLeft(azul.AzStyleBoxShadow{offset_x = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(0.0)}, offset_y = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(2.0)}, blur_radius = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(4.0)}, spread_radius = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(1.0)}, clip_mode = azul.AzBoxShadowClipMode.Outset, color = azul.AzColorU{r = 0, g = 0, b = 0, a = 64}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_boxShadowRight(azul.AzStyleBoxShadow{offset_x = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(0.0)}, offset_y = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(2.0)}, blur_radius = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(4.0)}, spread_radius = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(1.0)}, clip_mode = azul.AzBoxShadowClipMode.Outset, color = azul.AzColorU{r = 0, g = 0, b = 0, a = 64}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_boxShadowTop(azul.AzStyleBoxShadow{offset_x = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(0.0)}, offset_y = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(2.0)}, blur_radius = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(4.0)}, spread_radius = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(1.0)}, clip_mode = azul.AzBoxShadowClipMode.Outset, color = azul.AzColorU{r = 0, g = 0, b = 0, a = 64}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_boxShadowBottom(azul.AzStyleBoxShadow{offset_x = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(0.0)}, offset_y = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(2.0)}, blur_radius = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(4.0)}, spread_radius = azul.AzPixelValueNoPercent{inner = azul.AzPixelValue_px(1.0)}, clip_mode = azul.AzBoxShadowClipMode.Outset, color = azul.AzColorU{r = 0, g = 0, b = 0, a = 64}})),
	}[0], 20)
}

// CSS: .scroll
style_scroll :: proc() -> azul.AzCssPropertyWithConditionsVec {
	return azul.AzCssPropertyWithConditionsVec_copyFromPtr(&[]azul.AzCssPropertyWithConditions{
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_scrollbarTrack(azul.AzStyleBackgroundContentValue{Exact = {tag = 6, payload = azul.AzStyleBackgroundContent_color(azul.AzColorU{r = 238, g = 238, b = 238, a = 255})}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_scrollbarThumb(azul.AzStyleBackgroundContentValue{Exact = {tag = 6, payload = azul.AzStyleBackgroundContent_color(azul.AzColorU{r = 136, g = 136, b = 136, a = 255})}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_scrollbarButton(azul.AzStyleBackgroundContentValue{Exact = {tag = 6, payload = azul.AzStyleBackgroundContent_color(azul.AzColorU{r = 204, g = 204, b = 204, a = 255})}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_scrollbarCorner(azul.AzStyleBackgroundContentValue{Exact = {tag = 6, payload = azul.AzStyleBackgroundContent_color(azul.AzColorU{r = 221, g = 221, b = 221, a = 255})}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_scrollbarResizer(azul.AzStyleBackgroundContentValue{Exact = {tag = 6, payload = azul.AzStyleBackgroundContent_color(azul.AzColorU{r = 187, g = 187, b = 187, a = 255})}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_scrollbarWidth(azul.AzLayoutScrollbarWidthValue{Exact = {tag = 6, payload = azul.AzLayoutScrollbarWidth.Thin}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_scrollbarColor(azul.AzStyleScrollbarColorValue{Exact = {tag = 6, payload = azul.AzStyleScrollbarColor_custom(azul.AzScrollbarColorCustom{thumb = azul.AzColorU{r = 136, g = 136, b = 136, a = 255}, track = azul.AzColorU{r = 238, g = 238, b = 238, a = 255}})}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_overscrollBehaviorX(azul.AzOverscrollBehaviorValue{Exact = {tag = 6, payload = azul.AzOverscrollBehavior.Contain}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_overscrollBehaviorY(azul.AzOverscrollBehaviorValue{Exact = {tag = 6, payload = azul.AzOverscrollBehavior.None}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_scrollbarVisibility(azul.AzScrollbarVisibilityModeValue{Exact = {tag = 6, payload = azul.AzScrollbarVisibilityMode.WhenScrolling}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_scrollbarFadeDelay(azul.AzScrollbarFadeDelayValue{Exact = {tag = 6, payload = azul.AzScrollbarFadeDelay{ms = 500}}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_scrollbarFadeDuration(azul.AzScrollbarFadeDurationValue{Exact = {tag = 6, payload = azul.AzScrollbarFadeDuration{ms = 200}}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_appRegion(azul.AzStyleAppRegionValue{Exact = {tag = 6, payload = azul.AzStyleAppRegion.Drag}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_spatialNavigationAction(azul.AzStyleSpatialNavigationActionValue{Exact = {tag = 6, payload = azul.AzStyleSpatialNavigationAction.Focus}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_spatialNavigationContain(azul.AzStyleSpatialNavigationContainValue{Exact = {tag = 6, payload = azul.AzStyleSpatialNavigationContain.Contain}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_spatialNavigationFunction(azul.AzStyleSpatialNavigationFunctionValue{Exact = {tag = 6, payload = azul.AzStyleSpatialNavigationFunction.Grid}})),
	}[0], 16)
}

// CSS: .effects
// dropped `text-shadow: 1px 1px 2px`: CssProperty::TextShadow holds a BoxOrStaticStyleBoxShadow (a pointer wrapper) and api.json has no constructor for it
style_effects :: proc() -> azul.AzCssPropertyWithConditionsVec {
	return azul.AzCssPropertyWithConditionsVec_copyFromPtr(&[]azul.AzCssPropertyWithConditions{
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_backgroundContent(azul.AzStyleBackgroundContentVec_copyFromPtr(&[]azul.AzStyleBackgroundContent{azul.AzStyleBackgroundContent_color(azul.AzColorU{r = 250, g = 250, b = 250, a = 255})}[0], 1))),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_backgroundPosition(azul.AzStyleBackgroundPositionVec_copyFromPtr(&[]azul.AzStyleBackgroundPosition{azul.AzStyleBackgroundPosition{horizontal = azul.AzBackgroundPositionHorizontal_center(), vertical = azul.AzBackgroundPositionVertical_center()}}[0], 1))),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_backgroundSize(azul.AzStyleBackgroundSizeVec_copyFromPtr(&[]azul.AzStyleBackgroundSize{azul.AzStyleBackgroundSize_cover()}[0], 1))),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_backgroundRepeat(azul.AzStyleBackgroundRepeatVec_copyFromPtr(&[]azul.AzStyleBackgroundRepeat{azul.AzStyleBackgroundRepeat.NoRepeat}[0], 1))),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_transform(azul.AzStyleTransformVec_copyFromPtr(&[]azul.AzStyleTransform{azul.AzStyleTransform_rotate(azul.AzAngleValue{metric = azul.AzAngleMetric.Degree, number = azul.AzFloatValue_create(45.0)})}[0], 1))),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_transformOrigin(azul.AzStyleTransformOrigin{x = azul.AzPixelValue_percent(50.0), y = azul.AzPixelValue_percent(50.0)})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_perspectiveOrigin(azul.AzStylePerspectiveOrigin{x = azul.AzPixelValue_px(10.0), y = azul.AzPixelValue_px(20.0)})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_backfaceVisibility(azul.AzStyleBackfaceVisibility.Hidden)),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_filter(azul.AzStyleFilterVecValue{Exact = {tag = 6, payload = azul.AzStyleFilterVec_copyFromPtr(&[]azul.AzStyleFilter{azul.AzStyleFilter_blur(azul.AzStyleBlur{width = azul.AzPixelValue_px(2.0), height = azul.AzPixelValue_px(2.0)})}[0], 1)}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_backdropFilter(azul.AzStyleFilterVecValue{Exact = {tag = 6, payload = azul.AzStyleFilterVec_copyFromPtr(&[]azul.AzStyleFilter{azul.AzStyleFilter_grayscale(azul.AzPercentageValue{number = azul.AzFloatValue_create(50.0)})}[0], 1)}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_mixBlendMode(azul.AzStyleMixBlendModeValue{Exact = {tag = 6, payload = azul.AzStyleMixBlendMode.Multiply}})),
	}[0], 11)
}

// CSS: .fragment
style_fragment :: proc() -> azul.AzCssPropertyWithConditionsVec {
	return azul.AzCssPropertyWithConditionsVec_copyFromPtr(&[]azul.AzCssPropertyWithConditions{
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_breakBefore(azul.AzPageBreak.Page)),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_breakAfter(azul.AzPageBreak.Avoid)),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_breakInside(azul.AzBreakInside.Avoid)),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_orphans(azul.AzOrphans{inner = 2})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_widows(azul.AzWidows{inner = 3})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_boxDecorationBreak(azul.AzBoxDecorationBreak.Clone)),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_columnCount(azul.AzColumnCount_integer(3))),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_columnWidth(azul.AzColumnWidth_length(azul.AzPixelValue_px(200.0)))),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_columnSpan(azul.AzColumnSpan.All)),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_columnFill(azul.AzColumnFill.Balance)),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_columnRuleWidth(azul.AzColumnRuleWidth{inner = azul.AzPixelValue_px(1.0)})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_columnRuleStyle(azul.AzColumnRuleStyle{inner = azul.AzBorderStyle.Solid})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_columnRuleColor(azul.AzColumnRuleColor{inner = azul.AzColorU{r = 204, g = 204, b = 204, a = 255}})),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_flowInto(azul.AzFlowInto_named(css_str("article")))),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_flowFrom(azul.AzFlowFrom_named(css_str("article")))),
	}[0], 15)
}

// CSS: .shape
style_shape :: proc() -> azul.AzCssPropertyWithConditionsVec {
	return azul.AzCssPropertyWithConditionsVec_copyFromPtr(&[]azul.AzCssPropertyWithConditions{
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_shapeOutside(azul.AzShapeOutside_shape(azul.AzCssShape_circle(azul.AzShapeCircle{center = azul.AzShapePoint{x = 0.0, y = 0.0}, radius = 50.0})))),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_shapeInside(azul.AzShapeInside_shape(azul.AzCssShape_circle(azul.AzShapeCircle{center = azul.AzShapePoint{x = 50.0, y = 50.0}, radius = 100.0})))),
		azul.AzCssPropertyWithConditions_simple(azul.AzCssProperty_clipPath(azul.AzClipPath_shape(azul.AzCssShape_circle(azul.AzShapeCircle{center = azul.AzShapePoint{x = 0.0, y = 0.0}, radius = 40.0})))),
