   t1[3] := az css property with conditions simple (az css property border spacing (AZLAYOUTBORDERSPACING (az pixel value px (2.0), az pixel value px (4.0))));
   t1[4] := az css property with conditions simple (az css property caption side (style caption side bottom));
   t1[5] := az css property with conditions simple (az css property empty cells (style empty cells hide));
