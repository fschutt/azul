   t3[1] := az css property with conditions simple (az css property content (t1));
   t3[2] := az css property with conditions simple (az css property counter reset (AZCOUNTERRESET (css str ("section"), 1)));
   t3[3] := az css property with conditions simple (az css property counter increment (AZCOUNTERINCREMENT (css str ("section"), 1)));
   t3[4] := az css property with conditions simple (az css property list style type (style list style type upper roman));
   t3[5] := az css property with conditions simple (az css property list style position (style list style position inside));
   t3[6] := az css property with conditions simple (az css property string set (t2));
   az css property with conditions vec copy from ptr (t3[1], LENG 6)
END;

