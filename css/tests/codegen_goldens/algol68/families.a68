   [15] AZCSSPROPERTYWITHCONDITIONS t6;
   inner OF t1 := 2;
   inner OF t2 := 3;
   inner OF t3 := az pixel value px (1.0);
   inner OF t4 := border style solid;
   inner OF t5 := AZCOLORU (REPR 204, REPR 204, REPR 204, REPR 255);
   t6[1] := az css property with conditions simple (az css property break before (page break page));
   t6[2] := az css property with conditions simple (az css property break after (page break avoid));
   t6[3] := az css property with conditions simple (az css property break inside (break inside avoid));
   t6[4] := az css property with conditions simple (az css property orphans (t1));
   t6[5] := az css property with conditions simple (az css property widows (t2));
   t6[6] := az css property with conditions simple (az css property box decoration break (box decoration break clone));
   t6[7] := az css property with conditions simple (az css property column count (az column count integer (3)));
   t6[8] := az css property with conditions simple (az css property column width (az column width length (az pixel value px (200.0))));
   t6[9] := az css property with conditions simple (az css property column span (column span all));
   t6[10] := az css property with conditions simple (az css property column fill (column fill balance));
   t6[11] := az css property with conditions simple (az css property column rule width (t3));
   t6[12] := az css property with conditions simple (az css property column rule style (t4));
   t6[13] := az css property with conditions simple (az css property column rule color (t5));
   t6[14] := az css property with conditions simple (az css property flow into (az flow into named (css str ("article"))));
   t6[15] := az css property with conditions simple (az css property flow from (az flow from named (css str ("article"))));
   az css property with conditions vec copy from ptr (t6[1], LENG 15)
END;

# CSS: .shape #
