   [5] AZCSSPROPERTYWITHCONDITIONS t3;
   inner OF t1 := az float value create (0.5);
   inner OF t2 := az pixel value px (10.0);
   t3[1] := az css property with conditions simple (az css property clip path (az clip path shape (az css shape circle (AZSHAPECIRCLE (AZSHAPEPOINT (0.0, 0.0), 40.0)))));
   t3[2] := az css property with conditions simple (az css property shape image threshold (t1));
   t3[3] := az css property with conditions simple (az css property shape inside (az shape inside shape (az css shape circle (AZSHAPECIRCLE (AZSHAPEPOINT (50.0, 50.0), 100.0)))));
   t3[4] := az css property with conditions simple (az css property shape margin (t2));
   t3[5] := az css property with conditions simple (az css property shape outside (az shape outside shape (az css shape circle (AZSHAPECIRCLE (AZSHAPEPOINT (0.0, 0.0), 50.0)))));
   az css property with conditions vec copy from ptr (t3[1], LENG 5)
END;

# CSS: .table #
