+        };
+        let second = {
+            let pf = PixfmtRgba32LcdLinear::new(&mut ra, &lut, LcdBlendParams::default());
+            pf.c3.as_ptr()
+        };
+        assert_eq!(first, second, "the second run took the first run's buffer");
+        let legacy = {
+            let pf = PixfmtRgba32Lcd::new(&mut ra, &lut);
+            pf.c3.as_ptr()
+        };
+        assert_eq!(legacy, first, "the legacy pixfmt shares the pool");
+    }
 }
