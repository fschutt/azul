 /// them. Pre-sizing to a comfortable span length means the buffer is
 /// allocated once per pixfmt rather than once per span.
 const SPAN_SCRATCH: usize = 256;
+
+std::thread_local! {
+    /// The span buffer the last pixfmt of this thread handed back when it was
+    /// dropped. A pixfmt is made per text RUN (a map draws thousands a
+    /// frame), so a buffer allocated per pixfmt was an allocation and a free
+    /// per run; threads drawing text in parallel each keep their own.
+    static SPAN_POOL: core::cell::Cell<Vec<u8>> = const { core::cell::Cell::new(Vec::new()) };
+}
+
+/// A span buffer for a new pixfmt: this thread's pooled one, or a fresh one.
+fn take_span_buffer() -> Vec<u8> {
+    let pooled = SPAN_POOL.try_with(core::cell::Cell::take).unwrap_or_default();
+    if pooled.capacity() >= SPAN_SCRATCH {
+        pooled
+    } else {
+        Vec::with_capacity(SPAN_SCRATCH)
+    }
+}
+
+/// Hands a dropped pixfmt's span buffer back to this thread's pool (the larger
+/// of it and what the pool holds stays).
+fn give_span_buffer(buffer: Vec<u8>) {
+    if buffer.capacity() == 0 {
+        return;
+    }
+    let _ = SPAN_POOL.try_with(move |pool| {
+        let held = pool.take();
+        pool.set(if held.capacity() >= buffer.capacity() { held } else { buffer });
+    });
+}
 
