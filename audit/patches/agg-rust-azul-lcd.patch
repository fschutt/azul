+#[cfg(test)]
+mod per_run_state_tests {
+    //! The per-run state of the linear LCD pixfmt (the tone LUT without a
+    //! lock, the span buffer from the thread's pool, the coverage table built
+    //! once per run) blends exactly the bytes it blended before.
+    use super::*;
+
+    /// The tone LUT as `coverage_tone_lut` computed it, uncached.
+    fn old_tone_lut(coverage_gamma: u8) -> [u8; 256] {
+        let g = f64::from(coverage_gamma.max(1)) / 100.0;
+        let inv = 1.0 / g;
+        let mut lut = [0u8; 256];
+        for (i, e) in lut.iter_mut().enumerate() {
+            let c = (i as f64 / 255.0).powf(inv);
+            *e = (c * 255.0).round() as u8;
+        }
+        lut
+    }
+
+    /// `PixfmtRgba32LcdLinear::composite_pixel` (with `boost`) before the
+    /// per-run state, over one RGBA row: the reference.
+    fn old_composite_pixel(
+        row: &mut [u8],
+        pixel: usize,
+        params: LcdBlendParams,
+        fg: &Rgba8,
+        a_fg: u32,
+        cov: [u32; 3],
+    ) {
+        let luts = SrgbLuts::get();
+        let cover_lut = old_tone_lut(params.coverage_gamma);
+        let boost = |c: u32| {
+            let c = u32::from(cover_lut[c as usize]);
+            let k = u32::from(params.contrast);
+            (c + (k * c * (255 - c)) / (255 * 255)).min(255)
+        };
+        let off = pixel * BPP;
+        let mut c = [0u32; 3];
+        let mut any = false;
+        for i in 0..3 {
+            let boosted = boost(cov[i]);
+            c[i] = boosted * a_fg / 255;
+            any |= c[i] != 0;
+        }
+        if !any {
+            return;
+        }
+        let fg_lin = [luts.lin(fg.r), luts.lin(fg.g), luts.lin(fg.b)];
+        let bg_lin = [luts.lin(row[off]), luts.lin(row[off + 1]), luts.lin(row[off + 2])];
+        let mut out = [0u32; 3];
+        for i in 0..3 {
+            out[i] = (fg_lin[i] * c[i] + bg_lin[i] * (255 - c[i])) / 255;
+        }
+        let clamp = u32::from(params.chroma_limit);
+        if clamp > 0 {
+            let c_mean = (c[0] + c[1] + c[2]) / 3;
+            for i in 0..3 {
+                let gray = (fg_lin[i] * c_mean + bg_lin[i] * (255 - c_mean)) / 255;
+                let o = i64::from(out[i]);
+                let g = i64::from(gray);
+                out[i] = (o + (i64::from(clamp) * (g - o)) / 255) as u32;
+            }
+        }
+        row[off] = luts.srgb(out[0]);
+        row[off + 1] = luts.srgb(out[1]);
+        row[off + 2] = luts.srgb(out[2]);
+        row[off + 3] = 255;
     }
+
+    /// `PixfmtRgba32LcdLinear::blend_solid_hspan` before the per-run state,
+    /// over one RGBA row of `width` pixels: the reference.
+    #[allow(clippy::too_many_arguments)]
+    fn old_blend_solid_hspan(
+        row: &mut [u8],
+        width: usize,
+        lut: &LcdDistributionLut,
+        params: LcdBlendParams,
+        order: LcdSubpixelOrder,
+        stripe_clip: Option<(i32, i32)>,
+        x: i32,
+        covers: &[CoverType],
+        c: &Rgba8,
+    ) {
+        let len = covers.len();
+        let dist_len = len + 4;
+        let mut c3 = vec![0u8; dist_len];
+        for i in 0..len {
+            let cv = covers[i];
+            c3[i] = c3[i].wrapping_add(lut.tertiary(cv));
+            c3[i + 1] = c3[i + 1].wrapping_add(lut.secondary(cv));
+            c3[i + 2] = c3[i + 2].wrapping_add(lut.primary(cv));
+            c3[i + 3] = c3[i + 3].wrapping_add(lut.secondary(cv));
+            c3[i + 4] = c3[i + 4].wrapping_add(lut.tertiary(cv));
+        }
+        let sp_first = x as i64 - 2;
+        let sp_last = sp_first + dist_len as i64;
+        let (clip_lo, clip_hi) = stripe_clip.unwrap_or((0, i32::MAX));
+        let sp_vis_first = sp_first.max(i64::from(clip_lo)).max(0);
+        let sp_vis_last = if clip_hi == i32::MAX {
+            sp_last
+        } else {
+            sp_last.min(i64::from(clip_hi))
+        };
+        if sp_vis_last <= sp_vis_first {
+            return;
+        }
+        let first_pixel = (sp_vis_first / 3) as usize;
+        let last_pixel = ((sp_vis_last - 1) / 3) as usize;
+        let a_fg = u32::from(c.a);
+        for pixel in first_pixel..=last_pixel {
+            if pixel >= width {
+                break;
+            }
+            let mut cov = [0u32; 3];
+            let mut any = false;
+            for stripe in 0..3 {
+                let sp = (pixel * 3 + stripe) as i64;
+                if sp >= sp_vis_first && sp < sp_vis_last {
+                    let v = c3[(sp - sp_first) as usize];
+                    cov[order.channel(stripe)] = u32::from(v);
+                    any |= v != 0;
+                }
+            }
+            if any {
+                old_composite_pixel(row, pixel, params, c, a_fg, cov);
+            }
+        }
+    }
