+    fn the_per_run_blend_is_the_blend_it_replaced() {
+        let luts = [
+            LcdDistributionLut::new(f64::from(0x56u32), f64::from(0x4Du32), f64::from(0x08u32)),
+            LcdDistributionLut::new(1.0, 0.0, 0.0),
+            LcdDistributionLut::new(1.0 / 3.0, 2.0 / 9.0, 1.0 / 9.0),
+        ];
+        let mut rng = Rng(0x9e37_79b9_7f4a_7c15);
+        for case in 0..3_000 {
+            let width = 1 + rng.below(24) as usize;
+            let lut = &luts[case % luts.len()];
+            let params = LcdBlendParams {
+                contrast: rng.pick(&[0, 0, 40, 255]),
+                chroma_limit: rng.pick(&[0, 0, 90, 255]),
+                coverage_gamma: rng.pick(&[100, 220, 220, 1, 50, 180, 255]),
