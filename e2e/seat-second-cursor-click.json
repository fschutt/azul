{
  "name": "seat_second_cursor_click",
  "description": "SECOND POINTER SEAT (9b-ii / 9b-ii-c, focus per seat 9b-ii-a-i-d): two focusable rows. The primary cursor (seat 0) rests on r1; a second seat (seat 7, an X11 MPX master pointer or a Wayland wl_seat) presses on r3. Since focus is PER SEAT (the user's ruling: two people editing two fields of one window), the seat's press moves SEAT 7's focus to r3 and leaves the primary's alone - nothing focused at first, r1 after the primary's own click - and the seat's second press keeps both where they are. Before the harness port (9b-ii-a-i-d-iv) a seat's press was applied to the one shared focus, which this scenario used to assert.",
  "setup": {
    "window_width": 400,
    "window_height": 300,
    "dpi": 96
  },
  "steps": [
    {
      "op": "mount",
      "html": [
        "<div id=\"list\">",
        "  <div class=\"row\" id=\"r0\" tabindex=\"0\"></div>",
        "  <div class=\"row\" id=\"r1\" tabindex=\"0\"></div>",
        "  <div class=\"row\" id=\"r2\" tabindex=\"0\"></div>",
        "  <div class=\"row\" id=\"r3\" tabindex=\"0\"></div>",
        "</div>"
      ],
      "css": [
        "html, body { margin: 0; padding: 0; }",
        "#list { width: 200px; }",
        ".row { width: 100%; height: 50px; background: blue; }"
      ]
    },
    {
      "op": "wait_frame"
    },
    {
      "op": "wait",
      "ms": 150
    },
    {
      "op": "assert_node_count",
      "selector": ".row",
      "expected": 4
    },
    {
      "op": "mouse_move",
      "x": 100,
      "y": 75
    },
    {
      "op": "wait_frame"
    },
    {
      "op": "mouse_move",
      "x": 100,
      "y": 175,
      "seat": 7
    },
    {
      "op": "mouse_down",
      "x": 100,
      "y": 175,
      "seat": 7
    },
    {
      "op": "wait_frame"
    },
    {
      "op": "mouse_up",
      "x": 100,
      "y": 175,
      "seat": 7
    },
    {
      "op": "wait_frame"
    },
    {
      "op": "wait",
      "ms": 100
    },
    {
      "op": "get_focus_state",
      "seat": 7
    },
    {
      "op": "assert_response",
      "contains": "r3"
    },
    {
      "op": "get_focus_state"
    },
    {
      "op": "assert_response",
      "contains": "\"has_focus\":false"
    },
    {
      "op": "click",
      "x": 100,
      "y": 75
    },
    {
      "op": "wait_frame"
    },
    {
      "op": "wait",
      "ms": 100
    },
    {
      "op": "get_focus_state"
    },
    {
      "op": "assert_response",
      "contains": "r1"
    },
    {
      "op": "get_focus_state",
      "seat": 7
    },
    {
      "op": "assert_response",
      "contains": "r3"
    },
    {
      "op": "mouse_down",
      "x": 100,
      "y": 175,
      "seat": 7
    },
    {
      "op": "wait_frame"
    },
    {
      "op": "mouse_up",
      "x": 100,
      "y": 175,
      "seat": 7
    },
    {
      "op": "wait_frame"
    },
    {
      "op": "wait",
      "ms": 100
    },
    {
      "op": "get_focus_state",
      "seat": 7
    },
    {
      "op": "assert_response",
      "contains": "r3"
    },
    {
      "op": "get_focus_state"
    },
    {
      "op": "assert_response",
      "contains": "r1"
    }
  ]
}
