{
  "name": "seat_focus_per_seat",
  "description": "PER-SEAT FOCUS (9b-ii-a-i-d, harness half 9b-ii-a-i-d-iv): a second pointer seat's press moves ITS OWN focus onto the field under ITS cursor while the primary's focus stays where it was, and each seat answers its own focus query. Before the harness port, a seat's press was applied to the primary's focus like any click and `get_focus_state` could only ask for the primary's.",
  "setup": {
    "window_width": 400,
    "window_height": 300,
    "dpi": 96
  },
  "steps": [
    {
      "op": "mount",
      "html": [
        "<div id=\"a\" contenteditable=\"true\">alpha</div>",
        "<div id=\"b\" contenteditable=\"true\">bravo</div>"
      ],
      "css": [
        "html, body { margin: 0; padding: 0; }",
        "#a, #b { display: block; width: 200px; height: 40px; font-size: 14px; }",
        "#b { margin-top: 20px; }"
      ]
    },
    { "op": "wait_frame" },
    { "op": "wait", "ms": 100 },

    { "op": "click", "x": 20, "y": 20 },
    { "op": "wait_frame" },
    { "op": "get_focus_state" },
    { "op": "assert_response", "contains": "#a" },

    { "op": "mouse_move", "x": 20, "y": 80, "seat": 7 },
    { "op": "mouse_down", "x": 20, "y": 80, "seat": 7 },
    { "op": "mouse_up", "x": 20, "y": 80, "seat": 7 },
    { "op": "wait_frame" },
    { "op": "wait", "ms": 50 },

    { "op": "get_focus_state", "seat": 7 },
    { "op": "assert_response", "contains": "#b" },
    { "op": "get_focus_state" },
    { "op": "assert_response", "contains": "#a" },

    { "op": "mouse_move", "x": 350, "y": 250, "seat": 7 },
    { "op": "mouse_down", "x": 350, "y": 250, "seat": 7 },
    { "op": "mouse_up", "x": 350, "y": 250, "seat": 7 },
    { "op": "wait_frame" },
    { "op": "get_focus_state", "seat": 7 },
    { "op": "assert_response", "contains": "\"has_focus\":false" },
    { "op": "get_focus_state" },
    { "op": "assert_response", "contains": "#a" }
  ]
}
