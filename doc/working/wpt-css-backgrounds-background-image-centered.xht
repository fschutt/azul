<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<title>Centered Background Gradient</title>
<style>
    #a {
        width: 200px;
        height: 150px;
        border-style: solid;
        border-width: 10px;
        background-position: center center;
        background-image: repeating-radial-gradient(blue, green 20px);
    }
</style>
</head>
<body>
    <div id="a"></div>

</body>
</html>
