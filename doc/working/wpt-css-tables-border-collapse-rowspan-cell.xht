<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<title>CSS Test: collapsed borders of row-spanning cells should paint correctly.</title>
<style>
  table {
    border-collapse: collapse;
  }

  td {
    border: 1px solid red;
    position: relative;
  }
</style>
</head>
<body><table>
  <tbody><tr>
    <td rowspan="2">
      Needs border
    </td>
  </tr>
  <tr>
    <td>
    </td>
  </tr>
</tbody></table>
</body>
</html>
