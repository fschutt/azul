<head>
<meta name="assert" content="This test checks the list marker aligns to the first baseline."/>
<style>
::marker { font-family:inherit; }
</style>
</head>
<body><div style="display:inline-block;">
  <ul>
    <li>
      <p>
        xx<br/>xx
      </p>
    </li>
  </ul>
</div>
</body>
</html>
