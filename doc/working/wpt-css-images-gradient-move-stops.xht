<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<title>Linear gradient which needs some positions changed and inferred.</title>
<style>
        #gradient {
            width: 400px;
            height: 300px;
            background-image: linear-gradient(to right, yellow, blue 70%, green 0);
        }
    
</style>
</head>
<body>
    <div id="gradient"></div>


</body>
</html>
