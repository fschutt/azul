<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<style>
  table {
    font-size: 15px;
    border: 1px solid green;
    margin-bottom: 5px;
  }

  th {
    width: 150px;
    border: 1px solid blue;
  }

  td {
    border: 1px solid purple;
  }
  
</style>
</head>
<body>
    <table style="text-align: start;">
      <tbody><tr>
        <th>A</th>
      </tr>
      <tr>
        <td>A</td>
      </tr>
    </tbody></table>
    <table style="text-align: end;">
      <tbody><tr>
        <th>A</th>
      </tr>
      <tr>
        <td>A</td>
      </tr>
    </tbody></table>
    <table>
      <tbody><tr>
        <th style="text-align: inherit;">A</th>
      </tr>
      <tr>
        <td>A</td>
      </tr>
    </tbody></table>
  

</body>
</html>
