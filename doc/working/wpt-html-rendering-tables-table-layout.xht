<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<title>Table layout attribute</title>
<meta name="assert" content="The layout attribute on table elements should have no effect."/>
</head>
<body><table border="" width="100%" layout="fixed">
<tbody><tr><td>aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</td><td>aaa
</td></tr></tbody></table>
<table border="" width="100%" layout="auto">
<tbody><tr><td>aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa</td><td>aaa
</td></tr></tbody></table>
</body>
</html>
