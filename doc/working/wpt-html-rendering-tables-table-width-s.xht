<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<style>
table {
  border-collapse: collapse;
}

td {
  padding: 0;
}
</style>
</head>
<body><table width="0">
  <tbody><tr>
    <td>
      a b
    </td>
  </tr>
</tbody></table>

<hr/>

<table width="1">
  <tbody><tr>
    <td>
      a b
    </td>
  </tr>
</tbody></table>
</body>
</html>
