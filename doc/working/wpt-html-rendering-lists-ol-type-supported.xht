<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<title>ol@type: supported types</title>
</head>
<body><ol type="1"><li>1</li><li>2</li></ol>
<ol type="a"><li>a</li><li>b</li></ol>
<ol type="A"><li>A</li><li>B</li></ol>
<ol type="i"><li>i</li><li>ii</li></ol>
<ol type="I"><li>I</li><li>II</li></ol>
</body>
</html>
