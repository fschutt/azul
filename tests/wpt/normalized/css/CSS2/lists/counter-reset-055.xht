<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<style>
div
            {
                counter-reset: ident;
            }
            div:before
            {
                font-size: 30px;
                content: counter(ident);
            }
</style>
</head>
<body>
        <p>Test passes if the number '0' appears below.</p>
        <div></div>
    

</body>
</html>
