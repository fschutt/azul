<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<style>
span
            {
                display: block;
                list-style-type: square;
                margin-left: 1in;
            }
            a
            {
                display: list-item;
            }
</style>
</head>
<body>
        <p>Test passes if there is a single square below.</p>
        <div>
            <span>
                <a></a>
            </span>
        </div>
    

</body>
</html>
