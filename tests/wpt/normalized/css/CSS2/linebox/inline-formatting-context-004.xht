<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<style>
div
            {
                display: inline;
            }
            div div
            {
                border-left: 100px solid black;
            }
</style>
</head>
<body>
        <p>Test passes if there is a black stripe on the left side of "Filler Text".</p>
        <div>
            <div>Filler Text</div>
        </div>
    
</body>
</html>
