<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<style>
#table
            {
                display: table;
            }
            #col
            {
                background: red;
                display: table-column;
                height: 5em;
                width: 5em;
            }
</style>
</head>
<body>
        <p>Test passes if there is no red visible on the page.</p>
        <div id="table">
            <div id="col"></div>
        </div>
    
 </body>
