<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<title>CSS Test: Test for baseline alignment of table cells (reference)</title>
<style>
td { padding-top: 0; }
td div { padding-top: 40px; }
</style>
</head>
<body>

<table>
  <tbody><tr>
    <td><div>data</div></td>
    <td><div>data</div></td>
    <td><div>data</div></td>
  </tr>
</tbody></table>



</body>
</html>
