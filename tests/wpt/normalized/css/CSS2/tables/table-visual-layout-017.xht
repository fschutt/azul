<html xmlns="http://www.w3.org/1999/xhtml">
<head>
<style>
table
            {
                background: red;
                border-collapse: collapse;
            }
            tr
            {
                background: white;
            }
            td
            {
                width: 2em;
                height: 2em;
            }
</style>
</head>
<body>
        <p>Test passes if there is no red visible on the page.</p>
        <table>
            <tr>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td></td>
                <td></td>
                <td></td>
            </tr>
            <tr>
                <td></td>
                <td></td>
                <td></td>
            </tr>
        </table>
    
</body>
</html>
